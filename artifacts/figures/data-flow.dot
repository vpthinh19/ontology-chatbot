digraph luong_du_lieu {
  pad=0.15;
  rankdir=TB; bgcolor="white"; nodesep=0.4; ranksep=0.5;
  node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=12,
        penwidth=1.3, margin="0.20,0.12"];
  edge [fontname="Liberation Sans", fontsize=10, color="#7a7a7a", penwidth=1.2];

  vb [label="NGUỒN CHÍNH THỨC CỦA TRƯỜNG\n6 quyết định · 3 quy chế · 8 trang hoặc hướng dẫn\n17 bản ghi nguồn trong ontology",
      shape=folder, style=filled, fillcolor="#fbf1dd", color="#d99b30"];

  onto [label="ONTOLOGY HỌC VỤ\n6.350 phát biểu · 685 đối tượng · 56 lớp\nmỗi dữ kiện gắn với phần văn bản được dùng làm căn cứ",
        shape=cylinder, style=filled, fillcolor="#fbf1dd", color="#d99b30"];

  dm [label="DANH MỤC HÀNH ĐỘNG\n343 hành động tra cứu + 1 hành động từ chối\nxác định dữ kiện và đối tượng cần đọc",
      fillcolor="#f0ece6", color="#8a8175"];

  cap [label="BỘ DỮ LIỆU CÂU HỎI CÓ ĐÁP ÁN PHÂN LOẠI\n6.313 dòng · 5.484 câu trả lời được · 829 câu từ chối\n4 cách viết: trang trọng · trung tính · thân mật · gõ nhiễu",
       fillcolor="#dbeeec", color="#2e8b8b"];

  chia [label="CHIA THEO CÂU MẪU", shape=diamond, fillcolor="#dbeeec",
        color="#2e8b8b", margin="0.12,0.04"];
  day  [label="Tập huấn luyện\n5.523 dòng", fillcolor="#dbeeec", color="#2e8b8b"];
  kd   [label="Tập theo dõi huấn luyện\n400 dòng", fillcolor="#dbeeec", color="#2e8b8b"];
  cham [label="Tập chấm cuối\n390 dòng", fillcolor="#dbeeec", color="#2e8b8b"];

  train [label="HUẤN LUYỆN BỘ PHÂN LOẠI\ntập huấn luyện dùng để học\ntập theo dõi dùng để quan sát quá trình học", fillcolor="#dce6f2", color="#1f4e79"];
  chon  [label="ĐÁNH GIÁ RIÊNG BỘ PHÂN LOẠI\nđầu vào: câu hỏi hoặc từ khoá\nđầu ra: 1 trong 344 nhãn", fillcolor="#dce6f2", color="#1f4e79"];
  danh  [label="ĐÁNH GIÁ TOÀN HỆ THỐNG\nđầu vào: câu chat\nđầu ra: câu trả lời hoàn chỉnh", fillcolor="#dce6f2", color="#1f4e79"];
  phuc  [label="ĐƯA MÔ HÌNH ĐÃ HUẤN LUYỆN\nVÀO CÔNG CỤ TRA CỨU",
         fillcolor="#e9f0e9", color="#4a7a4a"];

  vb -> onto [label="  bóc tách thủ công, mỗi dữ kiện phải chỉ ra được nguồn  "];
  onto -> dm [label="  rút ra các dạng câu hỏi trả lời được  "];
  dm -> cap  [label="  xác định nội dung cần hỏi và đáp án đúng  "];
  onto -> cap [label="  cung cấp tên và đích tra cứu  ", style=dashed];
  cap -> chia;
  chia -> day; chia -> kd; chia -> cham;
  day -> train;
  kd -> train;
  train -> chon;
  cham -> chon [label="  chỉ dùng để báo kết quả cuối  "];
  train -> phuc;
  phuc -> danh;
  onto -> danh [label="  tra cứu thật  ", style=dashed, constraint=false];
  { rank=same; day; kd; cham; }
}
