digraph luong_du_lieu {
  pad=0.15;
  rankdir=TB; bgcolor="white"; nodesep=0.4; ranksep=0.5;
  node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=12,
        penwidth=1.3, margin="0.20,0.12"];
  edge [fontname="Liberation Sans", fontsize=10, color="#7a7a7a", penwidth=1.2];

  vb [label="VĂN BẢN GỐC CỦA TRƯỜNG\nQuyết định · Quy chế · Hướng dẫn · trang web chính thức\n(16 văn bản: quyết định, quy chế, hướng dẫn)",
      shape=folder, style=filled, fillcolor="#fbf1dd", color="#d99b30"];

  onto [label="ĐỒ THỊ TRI THỨC (Turtle)\n6.355 phát biểu · 686 mục · 56 lớp · 84 loại thuộc tính\nmỗi dữ kiện gắn ngược về Điều/Khoản/Điểm đã chứng minh nó",
        shape=cylinder, style=filled, fillcolor="#fbf1dd", color="#d99b30"];

  dm [label="DANH MỤC 50 HỌ ĐẦU RA\n49 khuôn SPARQL + 1 họ từ chối; mỗi khuôn là một dạng\nthông tin được phép đọc, kèm các chỗ trống phải điền",
      fillcolor="#f0ece6", color="#8a8175"];

  cap [label="BỘ CẶP CÂU HỎI – ĐÍCH\n6.308 dòng · 566 truy vấn SPARQL + 1 câu từ chối\n4 cách diễn đạt: trang trọng · trung tính · thân mật · gõ nhiễu",
       fillcolor="#dbeeec", color="#2e8b8b"];

  chia [label="CHIA BA PHẦN KHÔNG GIAO NHAU", shape=diamond, fillcolor="#dbeeec",
        color="#2e8b8b", margin="0.12,0.04"];
  day  [label="Tập dạy\n5.518 dòng", fillcolor="#dbeeec", color="#2e8b8b"];
  kd   [label="Tập kiểm định\n400 dòng", fillcolor="#dbeeec", color="#2e8b8b"];
  cham [label="Tập chấm\n390 dòng", fillcolor="#dbeeec", color="#2e8b8b"];

  train [label="HUẤN LUYỆN\nbốn mô hình chuỗi-chuỗi, cùng dữ liệu,\ncùng seed, mỗi mô hình dừng ở lượt tốt nhất", fillcolor="#dce6f2", color="#1f4e79"];
  chon  [label="CHỌN ĐIỂM DỪNG\ntheo hao hụt trên tập kiểm định", fillcolor="#dce6f2", color="#1f4e79"];
  danh  [label="ĐÁNH GIÁ CUỐI\nchạy truy vấn sinh ra trên chính đồ thị,\nso với đích và với kết quả đích trả về", fillcolor="#dce6f2", color="#1f4e79"];
  phuc  [label="ĐƯA VÀO PHỤC VỤ\nmô hình thắng cuộc thành ruột của công cụ tra cứu",
         fillcolor="#e9f0e9", color="#4a7a4a"];

  vb -> onto [label="  bóc tách thủ công, mỗi dữ kiện phải chỉ ra được nguồn  "];
  onto -> dm [label="  rút ra các dạng câu hỏi trả lời được  "];
  dm -> cap  [label="  sinh câu hỏi cho từng mục, từng cách diễn đạt  "];
  onto -> cap [label="  điền tên mục thật vào khuôn  ", style=dashed];
  cap -> chia;
  chia -> day; chia -> kd; chia -> cham;
  day -> train;
  kd -> chon;
  train -> chon [style=dashed];
  chon -> danh;
  cham -> danh;
  onto -> danh [label="  chạy thật  ", style=dashed, constraint=false];
  danh -> phuc;
  { rank=same; day; kd; cham; }
}
