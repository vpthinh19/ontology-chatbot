flowchart TB
    Q["Câu hỏi trong hội thoại"] --> L{"LLM cần dữ kiện học vụ?"}
    L -- "không" --> A["LLM tiếp tục hội thoại"]
    L -- "có" --> T["Gọi công cụ ontology"]
    T --> M["Ánh xạ sang shape truy vấn"]
    M --> V{"An toàn và khớp catalogue?"}
    V -- "không" --> X["Không có dữ liệu"]
    V -- "có" --> G["Lấy trọn node từ ontology"]
    G --> R["Thuộc tính + nguồn"]
    R --> LLM["LLM tổng hợp"]
    X --> LLM
    LLM --> A
