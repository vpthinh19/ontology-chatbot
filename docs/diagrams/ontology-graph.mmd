        S1["Bước 1<br/>viết đơn theo Mẫu số 09"]
        R1["Điều kiện<br/>đã học ít nhất 01 học kỳ"]
        O["Phòng Công tác<br/>Chính trị và Sinh viên"]
        F["Mẫu số 09<br/>đơn xin nghỉ học tạm thời"]
        N["Thủ tục<br/>xin học trở lại"]
        C["Trường hợp<br/>lý do cá nhân"]
    end

    subgraph VANBAN["TẦNG VĂN BẢN — nguyên văn công văn"]
        direction LR
        PD["điểm d khoản 1<br/>Điều 24"]
        K3["khoản 3<br/>Điều 24"]
