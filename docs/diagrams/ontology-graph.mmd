    P -->|"cần biểu mẫu"| F
    P -->|"thủ tục tiếp theo"| N
    R1 -->|"chỉ áp dụng cho"| C

    P -.->|"căn cứ"| A
    S1 -.->|"căn cứ"| K3
    R1 -.->|"căn cứ"| PD
    F -.->|"căn cứ"| K3

    PD -->|"nằm trong"| K3
    K3 -->|"nằm trong"| A
    A -->|"thuộc tài liệu"| DOC

    classDef anchor fill:#ccfbf1,stroke:#0f766e,stroke-width:2.5px,color:#134e4a
    classDef fact fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0c4a6e
    classDef text fill:#e0e7ff,stroke:#4338ca,stroke-width:2px,color:#312e81
    classDef doc fill:#fef3c7,stroke:#b45309,stroke-width:2.5px,color:#78350f
    class P anchor
    class S1,R1,O,F,N,C fact
    class A,K3,PD text
    class DOC doc
