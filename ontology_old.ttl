@prefix : <http://www.ntu.edu.vn/ontology/academic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.ntu.edu.vn/ontology/academic#> .

<http://www.ntu.edu.vn/ontology/academic> rdf:type owl:Ontology .

#################################################################
#    Object Properties
#################################################################

###  http://www.ntu.edu.vn/ontology/academic#basedOnRegulation
:basedOnRegulation rdf:type owl:ObjectProperty ;
                   rdfs:range :Regulation ;
                   rdfs:label "Căn cứ theo quy định" .


###  http://www.ntu.edu.vn/ontology/academic#executedVia
:executedVia rdf:type owl:ObjectProperty ;
             rdfs:domain :AcademicProcedure ;
             rdfs:range :ExecutionChannel ;
             rdfs:label "Thực hiện qua kênh" .


###  http://www.ntu.edu.vn/ontology/academic#handledBy
:handledBy rdf:type owl:ObjectProperty ;
           rdfs:domain :AcademicProcedure ;
           rdfs:range :AdministrativeOffice ;
           rdfs:label "Được xử lý bởi" .


###  http://www.ntu.edu.vn/ontology/academic#hasCondition
:hasCondition rdf:type owl:ObjectProperty ;
              rdfs:domain :AcademicProcedure ;
              rdfs:range :Condition ;
              rdfs:label "Yêu cầu điều kiện" .


###  http://www.ntu.edu.vn/ontology/academic#hasFeeCategory
:hasFeeCategory rdf:type owl:ObjectProperty ;
                rdfs:domain :AcademicProcedure ;
                rdfs:range :FeeCategory ;
                rdfs:label "Áp dụng mức học phí" .


###  http://www.ntu.edu.vn/ontology/academic#hasOutput
:hasOutput rdf:type owl:ObjectProperty ;
           rdfs:domain :AcademicProcedure ;
           rdfs:range :OutputResult ;
           rdfs:label "Kết quả đầu ra" .


###  http://www.ntu.edu.vn/ontology/academic#hasPaymentMethod
:hasPaymentMethod rdf:type owl:ObjectProperty ;
                  rdfs:domain :AcademicProcedure ;
                  rdfs:range :PaymentMethod ;
                  rdfs:label "Phương thức thanh toán" .


###  http://www.ntu.edu.vn/ontology/academic#hasStep
:hasStep rdf:type owl:ObjectProperty ;
         rdfs:domain :AcademicProcedure ;
         rdfs:range :ProcedureStep ;
         rdfs:label "Bước thực hiện" .


###  http://www.ntu.edu.vn/ontology/academic#requiresDocument
:requiresDocument rdf:type owl:ObjectProperty ;
                  rdfs:domain :AcademicProcedure ;
                  rdfs:range :Document ;
                  rdfs:label "Cần biểu mẫu/văn bản" .


#################################################################
#    Data properties
#################################################################

###  http://www.ntu.edu.vn/ontology/academic#appliedDecision
:appliedDecision rdf:type owl:DatatypeProperty ;
                 rdfs:domain [ rdf:type owl:Class ;
                               owl:unionOf ( :AcademicProcedure
                                             :FeeCategory
                                           )
                             ] ;
                 rdfs:range xsd:string ;
                 rdfs:label "Quyết định áp dụng" .


###  http://www.ntu.edu.vn/ontology/academic#appliesToTarget
:appliesToTarget rdf:type owl:DatatypeProperty ;
                 rdfs:domain :FeeCategory ;
                 rdfs:range xsd:string ;
                 rdfs:label "Áp dụng cho đối tượng/ngành" .


###  http://www.ntu.edu.vn/ontology/academic#feeNote
:feeNote rdf:type owl:DatatypeProperty ;
         rdfs:domain :AcademicProcedure ;
         rdfs:range xsd:string ;
         rdfs:label "Ghi chú về đóng học phí" .


###  http://www.ntu.edu.vn/ontology/academic#feePerCredit
:feePerCredit rdf:type owl:DatatypeProperty ;
              rdfs:domain :FeeCategory ;
              rdfs:range xsd:integer ;
              rdfs:label "Mức học phí/1 Tín chỉ (VNĐ)" .


###  http://www.ntu.edu.vn/ontology/academic#formUrl
:formUrl rdf:type owl:DatatypeProperty ;
         rdfs:domain :Document ;
         rdfs:range xsd:anyURI ;
         rdfs:label "Đường dẫn tải biểu mẫu" .


###  http://www.ntu.edu.vn/ontology/academic#hasAlias
:hasAlias rdf:type owl:DatatypeProperty ;
          rdfs:domain :AcademicProcedure ;
          rdfs:range xsd:string ;
          rdfs:label "Từ đồng nghĩa (Alias)" .


###  http://www.ntu.edu.vn/ontology/academic#headOfOffice
:headOfOffice rdf:type owl:DatatypeProperty ;
              rdfs:domain :AdministrativeOffice ;
              rdfs:range xsd:string ;
              rdfs:label "Trưởng phòng/Chánh văn phòng" .


###  http://www.ntu.edu.vn/ontology/academic#officeEmail
:officeEmail rdf:type owl:DatatypeProperty ;
             rdfs:domain :AdministrativeOffice ;
             rdfs:range xsd:string ;
             rdfs:label "Email liên hệ" .


###  http://www.ntu.edu.vn/ontology/academic#officeLocation
:officeLocation rdf:type owl:DatatypeProperty ;
                rdfs:domain :AdministrativeOffice ;
                rdfs:range xsd:string ;
                rdfs:label "Địa điểm" .


###  http://www.ntu.edu.vn/ontology/academic#officePhoneNumber
:officePhoneNumber rdf:type owl:DatatypeProperty ;
                   rdfs:domain :AdministrativeOffice ;
                   rdfs:range xsd:string ;
                   rdfs:label "Số điện thoại" .


###  http://www.ntu.edu.vn/ontology/academic#officeWebsite
:officeWebsite rdf:type owl:DatatypeProperty ;
               rdfs:domain :AdministrativeOffice ;
               rdfs:range xsd:anyURI ;
               rdfs:label "Website" .


###  http://www.ntu.edu.vn/ontology/academic#procedureDescription
:procedureDescription rdf:type owl:DatatypeProperty ;
                      rdfs:domain :AcademicProcedure ;
                      rdfs:range xsd:string ;
                      rdfs:label "Mô tả quy trình" .


###  http://www.ntu.edu.vn/ontology/academic#videoURL
:videoURL rdf:type owl:DatatypeProperty ;
          rdfs:domain :AcademicProcedure ;
          rdfs:range xsd:anyURI ;
          rdfs:label "Video hướng dẫn thao tác Hệ thống quản lý học tập sinh viên (sinhvien.ntu.edu.vn)" .


#################################################################
#    Classes
#################################################################

###  http://www.ntu.edu.vn/ontology/academic#AcademicProcedure
:AcademicProcedure rdf:type owl:Class ;
                   rdfs:label "Quy trình học vụ" .


###  http://www.ntu.edu.vn/ontology/academic#AdministrativeOffice
:AdministrativeOffice rdf:type owl:Class ;
                      rdfs:label "Phòng ban hành chính" .


###  http://www.ntu.edu.vn/ontology/academic#Condition
:Condition rdf:type owl:Class ;
           rdfs:label "Điều kiện áp dụng" .


###  http://www.ntu.edu.vn/ontology/academic#Document
:Document rdf:type owl:Class ;
          rdfs:label "Tài liệu/Biểu mẫu" .


###  http://www.ntu.edu.vn/ontology/academic#ExecutionChannel
:ExecutionChannel rdf:type owl:Class ;
                  rdfs:label "Kênh thực hiện" .


###  http://www.ntu.edu.vn/ontology/academic#FeeCategory
:FeeCategory rdf:type owl:Class ;
             rdfs:label "Định mức học phí" .


###  http://www.ntu.edu.vn/ontology/academic#OutputResult
:OutputResult rdf:type owl:Class ;
              rdfs:label "Kết quả đầu ra" .


###  http://www.ntu.edu.vn/ontology/academic#PaymentMethod
:PaymentMethod rdf:type owl:Class ;
               rdfs:label "Phương thức thanh toán" .


###  http://www.ntu.edu.vn/ontology/academic#ProcedureStep
:ProcedureStep rdf:type owl:Class ;
               rdfs:label "Các bước thực hiện" .


###  http://www.ntu.edu.vn/ontology/academic#Regulation
:Regulation rdf:type owl:Class ;
            rdfs:label "Quy định/Căn cứ" .


