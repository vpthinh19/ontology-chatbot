# Ontology nhỏ cho các phép kiểm engine tìm kiếm: một thủ tục có bước và điều kiện,
# một đơn vị có điện thoại, một Điều và một khoản làm nguồn.

@prefix : <http://www.ntu.edu.vn/ontology/academic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AcademicProcedure a owl:Class ; rdfs:label "Thủ tục học vụ"@vi .
:ProcedureStep a owl:Class ; rdfs:label "Bước thực hiện"@vi .
:Requirement a owl:Class ; rdfs:label "Điều kiện"@vi .
:OrganizationalUnit a owl:Class ; rdfs:label "Đơn vị trong trường"@vi .
:AcademicActor a owl:Class ; rdfs:label "Chủ thể tham gia"@vi .
:Article a owl:Class ; rdfs:label "Điều"@vi .
:Clause a owl:Class ; rdfs:label "Khoản"@vi .

:hasStep a owl:ObjectProperty ; rdfs:label "có bước"@vi .
:hasRequirement a owl:ObjectProperty ; rdfs:label "có điều kiện"@vi .
:submittedTo a owl:ObjectProperty ; rdfs:label "nộp tại"@vi .
:performedBy a owl:ObjectProperty ; rdfs:label "do ai thực hiện"@vi .
:basedOn a owl:ObjectProperty ; rdfs:label "căn cứ"@vi .
:partOf a owl:ObjectProperty ; rdfs:label "nằm trong phần"@vi .

:summaryText a owl:DatatypeProperty ; rdfs:label "mô tả ngắn"@vi .
:stepText a owl:DatatypeProperty ; rdfs:label "nội dung bước"@vi .
:stepOrder a owl:DatatypeProperty ; rdfs:label "thứ tự bước"@vi .
:requirementText a owl:DatatypeProperty ; rdfs:label "nội dung điều kiện"@vi .
:officePhone a owl:DatatypeProperty ; rdfs:label "điện thoại"@vi .
:citationLabel a owl:DatatypeProperty ; rdfs:label "trích dẫn"@vi .
:documentUrl a owl:DatatypeProperty ; rdfs:label "đường dẫn văn bản gốc"@vi .
:officialText a owl:DatatypeProperty ; rdfs:label "nguyên văn"@vi .

:LeaveProcedure a :AcademicProcedure, owl:NamedIndividual ;
    rdfs:label "Thủ tục nghỉ học tạm thời"@vi ;
    skos:altLabel "bảo lưu kết quả học tập"@vi ;
    :summaryText "Cho phép sinh viên tạm dừng việc học."@vi ;
    :submittedTo :StudentAffairsOffice ;
    :hasStep :LeaveStep02, :LeaveStep01 ;
    :hasRequirement :LeaveRequirement ;
    :basedOn :Article24 .

:LeaveStep01 a :ProcedureStep, owl:NamedIndividual ;
    rdfs:label "Nghỉ học tạm thời - bước 1"@vi ;
    :stepOrder 1 ;
    :stepText "Viết đơn theo Mẫu số 09."@vi ;
    :performedBy :Student ;
    :basedOn :Article24Clause03 .

:LeaveStep02 a :ProcedureStep, owl:NamedIndividual ;
    rdfs:label "Nghỉ học tạm thời - bước 2"@vi ;
    :stepOrder 2 ;
    :stepText "Gửi đơn cho Hiệu trưởng."@vi ;
    :performedBy :Student ;
    :basedOn :Article24Clause03 .

:LeaveRequirement a :Requirement, owl:NamedIndividual ;
    rdfs:label "Điều kiện nghỉ học tạm thời"@vi ;
    :requirementText "Đã học ít nhất một học kỳ."@vi ;
    :basedOn :Article24 .

:StudentAffairsOffice a :OrganizationalUnit, owl:NamedIndividual ;
    rdfs:label "Phòng Công tác Chính trị và Sinh viên"@vi ;
    skos:altLabel "phòng CTSV"@vi ;
    :officePhone "0258 222 1900" .

:Student a :AcademicActor, owl:NamedIndividual ;
    rdfs:label "Sinh viên"@vi .

:Article24 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 24 Quy chế đào tạo"@vi ;
    :citationLabel "Điều 24 Quy chế đào tạo"@vi ;
    :documentUrl "https://example.edu.vn/quy-che.pdf"^^xsd:anyURI ;
    :officialText "Sinh viên được nghỉ học tạm thời."@vi .

:Article24Clause03 a :Clause, owl:NamedIndividual ;
    rdfs:label "khoản 3 Điều 24 Quy chế đào tạo"@vi ;
    :partOf :Article24 ;
    :citationLabel "khoản 3 Điều 24 Quy chế đào tạo"@vi ;
    :documentUrl "https://example.edu.vn/quy-che.pdf"^^xsd:anyURI ;
    :officialText "Sinh viên nộp đơn theo mẫu."@vi .
