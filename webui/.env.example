# URL công khai của backend trên Lightning.
VITE_API_BASE_URL=https://your-lightning-api.example

# Khoá đi qua cổng đứng trước backend, gửi kèm mỗi request dưới dạng
# ``Authorization: Bearer <khoá>``.
#
# Vite dán giá trị này thẳng vào tệp JavaScript lúc build, nên bất kỳ ai mở trang
# đã deploy cũng đọc được nó. Nó chặn người chỉ dò ra URL backend, KHÔNG chặn
# người dùng chính trang này. Đừng đặt ở đây khoá mở được thứ gì khác ngoài
# backend demo.
VITE_API_KEY=
