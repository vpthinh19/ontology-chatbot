{"query_id":"payment-method-details","domain":"tuition","target_template":"SELECT ?label ?bank ?instruction ?document ?answer WHERE { ?method a :PaymentMethod ; rdfs:label ?label ; :paymentInstructionProvision ?instructionPart ; :sourceDocument ?source ; :sourceProvision ?part . ?instructionPart :officialText ?instruction . ?source rdfs:label ?document . ?part :officialText ?answer . OPTIONAL { ?method :supportsBank ?bankNode . ?bankNode rdfs:label ?bank . } } ORDER BY ?label ?bank","slots":{},"coverage":[{"anchor_classes":["PaymentMethod"],"paths":[["paymentInstructionProvision","officialText"],["rdfs:label"],["sourceDocument","rdfs:label"],["sourceProvision","officialText"],["supportsBank","rdfs:label"]]}]}
{"query_id":"form-catalogue-details","domain":"form","target_template":"SELECT ?label ?url ?entry WHERE { ?catalogue a :FormCatalogue ; rdfs:label ?label ; :webPageUrl ?url ; :hasCatalogueEntry ?entryNode . ?entryNode rdfs:label ?entry . } ORDER BY ?entry","slots":{},"coverage":[{"anchor_classes":["FormCatalogue"],"paths":[["hasCatalogueEntry","rdfs:label"],["rdfs:label"],["webPageUrl"]]}]}
{"query_id":"form-entry-details","domain":"form","target_template":"SELECT ?label ?title ?number ?url ?form WHERE { ?entry a :FormCatalogueEntry ; rdfs:label ?label ; :listedTitle ?title ; :downloadUrl ?url . OPTIONAL { ?entry :listedFormNumber ?number . } OPTIONAL { ?entry :catalogueEntryForForm ?formNode . ?formNode rdfs:label ?form . } } ORDER BY ?title","slots":{},"coverage":[{"anchor_classes":["FormCatalogueEntry"],"paths":[["catalogueEntryForForm","rdfs:label"],["downloadUrl"],["listedFormNumber"],["listedTitle"],["rdfs:label"]]}]}
{"query_id":"form-document-details","domain":"form","target_template":"SELECT ?label ?number ?document ?answer WHERE { ?form a :FormDocument ; rdfs:label ?label ; :formNumber ?number ; :sourceDocument ?source ; :sourceProvision ?part . ?source rdfs:label ?document . ?part :officialText ?answer . } ORDER BY ?number","slots":{},"coverage":[{"anchor_classes":["FormDocument"],"paths":[["formNumber"],["rdfs:label"],["sourceDocument","rdfs:label"],["sourceProvision","officialText"]]}]}
{"query_id":"official-document-metadata","domain":"academic-rule","target_template":"SELECT ?label ?title ?number ?date ?academicYear ?semester ?valid WHERE { ?document a :Decision ; rdfs:label ?label ; :title ?title ; :documentNumber ?number ; :issueDate ?date ; :effectiveFromAcademicYear ?academicYear . OPTIONAL { ?document :effectiveFromSemester ?semester . } OPTIONAL { ?document :validUntilSuperseded ?valid . } } ORDER BY ?number","slots":{},"coverage":[{"anchor_classes":["Decision"],"paths":[["documentNumber"],["effectiveFromAcademicYear"],["effectiveFromSemester"],["issueDate"],["rdfs:label"],["title"],["validUntilSuperseded"]]}]}
