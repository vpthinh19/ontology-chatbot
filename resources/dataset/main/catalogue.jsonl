{"query_id":"academic-performance-details","domain":"academic-rule","target_template":"SELECT ?criterion ?result ?minimum ?maximum ?minimumIncluded ?maximumIncluded ?document ?answer WHERE { ?band a :AcademicPerformanceBand ; :criterionText ?criterion ; :resultLabel ?result ; :minimumValue ?minimum ; :sourceDocument ?source ; :sourceProvision ?part . ?source rdfs:label ?document . ?part :officialText ?answer . OPTIONAL { ?band :maximumValue ?maximum . } OPTIONAL { ?band :minimumInclusive ?minimumIncluded . } OPTIONAL { ?band :maximumInclusive ?maximumIncluded . } } ORDER BY ?minimum","slots":{},"coverage":[{"anchor_classes":["AcademicPerformanceBand"],"paths":[["criterionText"],["maximumInclusive"],["maximumValue"],["minimumInclusive"],["minimumValue"],["resultLabel"],["sourceDocument","rdfs:label"],["sourceProvision","officialText"]]}]}
{"query_id":"graduation-classification-details","domain":"academic-rule","target_template":"SELECT ?criterion ?result ?minimum ?maximum ?minimumIncluded ?maximumIncluded ?document ?answer WHERE { ?band a :GraduationClassificationBand ; :criterionText ?criterion ; :resultLabel ?result ; :minimumValue ?minimum ; :sourceDocument ?source ; :sourceProvision ?part . ?source rdfs:label ?document . ?part :officialText ?answer . OPTIONAL { ?band :maximumValue ?maximum . } OPTIONAL { ?band :minimumInclusive ?minimumIncluded . } OPTIONAL { ?band :maximumInclusive ?maximumIncluded . } } ORDER BY ?minimum","slots":{},"coverage":[{"anchor_classes":["GraduationClassificationBand"],"paths":[["criterionText"],["maximumInclusive"],["maximumValue"],["minimumInclusive"],["minimumValue"],["resultLabel"],["sourceDocument","rdfs:label"],["sourceProvision","officialText"]]}]}
{"query_id":"study-year-details","domain":"academic-rule","target_template":"SELECT ?criterion ?result ?minimum ?maximum ?document ?answer WHERE{?b a :StudyYearBand;:criterionText ?criterion;:resultLabel ?result;:sourceDocument/rdfs:label ?document;:sourceProvision/:officialText ?answer.OPTIONAL{?b :minimumValue ?minimum.}OPTIONAL{?b :maximumValue ?maximum.}}ORDER BY ?minimum","slots":{},"coverage":[{"anchor_classes":["StudyYearBand"],"paths":[["criterionText"],["maximumInclusive"],["maximumValue"],["minimumInclusive"],["minimumValue"],["resultLabel"],["sourceDocument","rdfs:label"],["sourceProvision","officialText"]]}]}
{"query_id":"class-size-details","domain":"academic-rule","target_template":"SELECT ?label ?criterion ?result ?minimum ?maximum ?minimumIncluded ?maximumIncluded ?document ?answer WHERE { ?rule a :ClassSizeRule ; rdfs:label ?label ; :criterionText ?criterion ; :resultLabel ?result ; :minimumValue ?minimum ; :sourceDocument ?source ; :sourceProvision ?part . ?source rdfs:label ?document . ?part :officialText ?answer . OPTIONAL { ?rule :maximumValue ?maximum . } OPTIONAL { ?rule :minimumInclusive ?minimumIncluded . } OPTIONAL { ?rule :maximumInclusive ?maximumIncluded . } } ORDER BY ?label","slots":{},"coverage":[{"anchor_classes":["ClassSizeRule"],"paths":[["criterionText"],["maximumInclusive"],["maximumValue"],["minimumInclusive"],["minimumValue"],["rdfs:label"],["resultLabel"],["sourceDocument","rdfs:label"],["sourceProvision","officialText"]]}]}
{"query_id":"doctoral-tuition-details","domain":"tuition","target_template":"SELECT ?qualification ?program ?criterion ?duration ?document ?answer WHERE { ?rule a :DoctoralTuitionDurationRule ; :criterionText ?criterion ; :durationInYears ?duration ; :sourceDocument ?source ; :sourceProvision ?part . ?source rdfs:label ?document . ?part :officialText ?answer . OPTIONAL { ?rule :appliesToEntryQualification ?qualificationNode . ?qualificationNode rdfs:label ?qualification . } OPTIONAL { ?rule :appliesToProgram ?programNode . ?programNode rdfs:label ?program . } } ORDER BY ?duration","slots":{},"coverage":[{"anchor_classes":["DoctoralTuitionDurationRule"],"paths":[["appliesToEntryQualification","rdfs:label"],["appliesToProgram","rdfs:label"],["criterionText"],["durationInYears"],["sourceDocument","rdfs:label"],["sourceProvision","officialText"]]}]}
