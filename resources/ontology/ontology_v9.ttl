###  http://www.ntu.edu.vn/ontology/academic#QuyTrinhXetHocBong
:QuyTrinhXetHocBong rdf:type owl:NamedIndividual ,
                             :QuyTrinhHocVu ;
                    :canCuQuyDinh :RegQD1052 ;
                    :coKetQua :OutputNhanHocBong ;
