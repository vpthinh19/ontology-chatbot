:StudentExchangeProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation1052Article27 ;
    :hasRequirement :StudentExchangeRequirement01,
        :StudentExchangeRequirement02 ;
    :hasStep :StudentExchangeStep01,
        :StudentExchangeStep02 ;
    :requiresForm :Form14StudentExchange ;
    :submittedTo :AcademicManagementUnit ;
    :summaryText "Thủ tục đăng ký tham gia chương trình trao đổi sinh viên với trường đối tác để công nhận tín chỉ lẫn nhau."@vi ;
    rdfs:label "Thủ tục đăng ký chương trình trao đổi sinh viên"@vi ;
    skos:altLabel "chương trình trao đổi"@vi,
        "học ở trường đối tác"@vi,
        "trao đổi sinh viên"@vi,
        "đi trao đổi"@vi .

:StudentExchangeRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article27Clause03 ;
    :requirementOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Đã kết thúc 01 năm học tại Trường và có điểm trung bình chung tích lũy đạt từ 6,00 trở lên."@vi ;
    rdfs:label "Điều kiện trao đổi - thời gian học và điểm"@vi .

:StudentExchangeRequirement02 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article27Clause02 ;
    :requirementOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Số tín chỉ tích lũy tại trường khác không vượt quá 25% tổng khối lượng của chương trình đào tạo."@vi ;
    rdfs:label "Điều kiện trao đổi - giới hạn tín chỉ tích lũy ngoài trường"@vi .

:StudentExchangeStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article27Clause04 ;
    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Theo dõi thông báo về việc đăng ký tham gia chương trình trao đổi vào đầu mỗi học kỳ."@vi ;
    rdfs:label "Trao đổi sinh viên - bước 1"@vi .

:StudentExchangeStep02 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article27Clause04 ;
    :performedBy :Student ;
    :stepOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Đăng ký học theo Mẫu số 14 (Phụ lục 4) và gửi về Phòng Đào tạo Đại học."@vi ;
    :submittedTo :AcademicManagementUnit ;
    :usesForm :Form14StudentExchange ;
    rdfs:label "Trao đổi sinh viên - bước 2"@vi .

