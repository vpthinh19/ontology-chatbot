:Regulation1052Appendix1 a :Appendix, owl:NamedIndividual ;
    rdfs:label "Phụ lục 1 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "Phụ lục 1 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :officialText """TT — Học phần — Số lượng sinh viên
Tối thiểu — Tối đa
1 — Giáo dục tổng quát — 50 — 100
2 — Lý luận chính trị — 80
3 — - Ngoại ngữ B1.1, B1.2; / - HP chuyên ngữ ngành Ngôn ngữ Anh; — 40 — 50
4 — - Tiếng anh chuyên ngành — 50 — 60
5 — Khối kiến thức cơ sở, kiến thức ngành của Khoa Du lịch, Kinh tế, Kế toán – Tài chính và Luật — 50 — 80
6 — Khối kỹ thuật, công nghệ — 30 — 70
7 — Giáo dục thể chất — 60 — 80 (LT)
45 — 60 (TH)
8 — Giáo dục Quốc phòng – An ninh — 70
45 — 70 (TH)
9 — Thực hành tại phòng máy CNC và công nghệ cao — 10 — 15
10 — Thực hành tại Xưởng Cơ khí, phòng thí nghiệm Nhiệt lạnh — 15 — 20
11 — Thực hành tại các phòng máy tính — 25 — 30
12 — Thực hành các học phần khác — 20 — 25"""@vi ;
    :appendixNumber "1" ;
    :headingText "Điều kiện, số lượng sinh viên để tổ chức một lớp học phần"@vi .

:Regulation1052Appendix1Table01 a :DocumentTable, owl:NamedIndividual ;
