    rdfs:label "Điều 1 Quyết định 626/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 1 Quyết định 626/QĐ-ĐHNT ngày 29/4/2026 của Hiệu trưởng Trường Đại học Nha Trang"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/890/qd-626-ban-hanh-quy-che-tuyen-sinh-dai-hoc-truong-dh-nha-trang-29-4-2026-pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision626 ;
    :articleNumber "1"^^xsd:integer ;
    :headingText "Ban hành kèm theo Quyết định này Quy chế tuyển sinh đại học của Trường Đại học Nha Trang."@vi .

:Decision626Article02 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 2 Quyết định 626/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 2 Quyết định 626/QĐ-ĐHNT ngày 29/4/2026 của Hiệu trưởng Trường Đại học Nha Trang"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/890/qd-626-ban-hanh-quy-che-tuyen-sinh-dai-hoc-truong-dh-nha-trang-29-4-2026-pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision626 ;
    :articleNumber "2"^^xsd:integer ;
    :headingText "Quyết định này có hiệu lực kể từ ngày ký và thay thế các Quyết định trước đây trái với Quyết định này."@vi .

:Decision626Article03 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 3 Quyết định 626/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 3 Quyết định 626/QĐ-ĐHNT ngày 29/4/2026 của Hiệu trưởng Trường Đại học Nha Trang"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/890/qd-626-ban-hanh-quy-che-tuyen-sinh-dai-hoc-truong-dh-nha-trang-29-4-2026-pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision626 ;
    :articleNumber "3"^^xsd:integer ;
    :headingText "Trưởng phòng Đào tạo, Giám đốc Trung tâm Đào tạo và Bồi dưỡng, các Trưởng đơn vị và cá nhân có liên quan chịu trách nhiệm thi hành Quyết định này."@vi .

:Regulation626ChapterI a :Chapter, owl:NamedIndividual ;
    rdfs:label "Chương I Quy chế tuyển sinh đại học"@vi ;
    :citationLabel "Chương I Quy chế tuyển sinh đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 626/QĐ-ĐHNT ngày 29/4/2026"@vi ;
