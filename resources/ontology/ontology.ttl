:UniversityPresident a :AcademicActor, owl:NamedIndividual ;
    rdfs:label "Hiệu trưởng"@vi ;
    skos:altLabel "hiệu trưởng nhà trường"@vi .

:UniversityTransferOutcome a :Outcome, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26Clause02 ;
    :outcomeText "Hiệu trưởng trường xin chuyển đi quyết định đồng ý hoặc không đồng ý; Hiệu trưởng trường xin chuyển đến quyết định tiếp nhận, công nhận và bảo lưu các học phần được chuyển đổi tín chỉ cùng số học phần phải học bổ sung."@vi ;
    rdfs:label "Kết quả xin chuyển trường"@vi .

:UniversityTransferProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26 ;
    :decidedBy :UniversityPresident ;
    :hasOutcome :UniversityTransferOutcome ;
    :hasRequirement :UniversityTransferRequirement01,
        :UniversityTransferRequirement02,
        :UniversityTransferRequirement03,
        :UniversityTransferRequirement04 ;
    :hasStep :UniversityTransferStep01,
        :UniversityTransferStep02 ;
    :requiresForm :Form13UniversityTransfer ;
    :submittedTo :StudentAffairsOffice ;
    :summaryText "Thủ tục xin chuyển từ Trường Đại học Nha Trang đến cơ sở đào tạo khác hoặc ngược lại."@vi ;
    rdfs:label "Thủ tục chuyển trường"@vi ;
    skos:altLabel "chuyển sang trường khác"@vi,
        "chuyển trường"@vi,
        "xin chuyển trường"@vi .

:UniversityTransferRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26Clause01PointA ;
    :requirementOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Không đang là sinh viên năm thứ nhất hoặc năm cuối khóa, không thuộc diện bị xem xét buộc thôi học và còn đủ thời gian học tập theo quy định."@vi ;
    rdfs:label "Điều kiện chuyển trường - năm học"@vi .

:UniversityTransferRequirement02 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26Clause01PointB ;
    :requirementOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Đạt điều kiện trúng tuyển của chương trình, ngành đào tạo cùng khóa tuyển sinh tại Trường xin chuyển đến."@vi ;
    rdfs:label "Điều kiện chuyển trường - điều kiện trúng tuyển"@vi .

:UniversityTransferRequirement03 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26Clause01PointC ;
    :requirementOrder "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Nơi chuyển đến có đủ điều kiện bảo đảm chất lượng và chưa vượt quá năng lực đào tạo đối với chương trình, ngành đào tạo đó."@vi ;
    rdfs:label "Điều kiện chuyển trường - năng lực đào tạo nơi đến"@vi .

:UniversityTransferRequirement04 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26Clause01PointD ;
    :requirementOrder "4"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Được sự đồng ý của Hiệu trưởng cơ sở đào tạo xin chuyển đi và cơ sở đào tạo xin chuyển đến."@vi ;
    rdfs:label "Điều kiện chuyển trường - đồng ý của hai hiệu trưởng"@vi .

:UniversityTransferStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26Clause02 ;
    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Làm hồ sơ xin chuyển trường theo Mẫu số 13 (Phụ lục 4)."@vi ;
    :usesForm :Form13UniversityTransfer ;
    rdfs:label "Chuyển trường - bước 1"@vi .

:UniversityTransferStep02 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article26Clause02 ;
    :performedBy :Student ;
    :stepOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Nộp hồ sơ thông qua Phòng Công tác Chính trị và Sinh viên của Trường Đại học Nha Trang."@vi ;
    :submittedTo :StudentAffairsOffice ;
    rdfs:label "Chuyển trường - bước 2"@vi .

