    :requirementText "Đã được xếp từ trình độ năm thứ hai trở lên của chương trình thứ nhất."@vi ;
    rdfs:label "Điều kiện học hai chương trình - năm đào tạo"@vi .

:SecondProgramRequirement02 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article28Clause01PointB ;
    :requirementOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Học lực theo điểm trung bình tích lũy xếp loại khá trở lên và đáp ứng ngưỡng bảo đảm chất lượng của chương trình thứ hai; hoặc xếp loại trung bình và đáp ứng điều kiện trúng tuyển của chương trình thứ hai trong năm tuyển sinh."@vi ;
    rdfs:label "Điều kiện học hai chương trình - học lực"@vi .

:SecondProgramRequirement03 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article28Clause05 ;
    :requirementOrder "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Đăng ký muộn nhất 02 năm trước thời điểm xét tốt nghiệp chương trình thứ hai, và chỉ được xét tốt nghiệp chương trình thứ hai khi đã đủ điều kiện tốt nghiệp chương trình thứ nhất."@vi ;
    rdfs:label "Điều kiện học hai chương trình - thời điểm đăng ký"@vi .

