:Decision729 a :Decision, owl:NamedIndividual ;
    rdfs:label "Quyết định số 729/QĐ-ĐHNT"@vi ;
    :documentNumber "729/QĐ-ĐHNT"@vi ;
    :issueDate "2025-05-28"^^xsd:date ;
    :title "Ban hành mức học phí chương trình đào tạo trình độ đại học, sau đại học hình thức chính quy Học kỳ I năm học 2025-2026 của Trường Đại học Nha Trang"@vi ;
    :effectiveFromAcademicYear "2025-2026"@vi ;
    :effectiveFromSemester "Học kỳ I"@vi ;
    :documentUrl "https://phongkhtc.ntu.edu.vn/uploads/1/Doc/693/q%C4%91-729-(2025).pdf.pdf"^^xsd:anyURI .

:Decision729Article01 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 1 Quyết định 729/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 1 Quyết định 729/QĐ-ĐHNT ngày 28/5/2025 của Hiệu trưởng Trường Đại học Nha Trang về mức học phí năm học 2025-2026"@vi ;
    :documentUrl "https://phongkhtc.ntu.edu.vn/uploads/1/Doc/693/q%C4%91-729-(2025).pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision729 ;
    :articleNumber "1"^^xsd:integer ;
    :headingText "Ban hành kèm theo Quyết định này mức học phí chương trình đào tạo trình độ đại học, sau đại học hình thức chính quy Học kỳ I năm học 2025-2026 của Trường Đại học Nha Trang (Phụ lục kèm theo)."@vi .

:Decision729Article02 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 2 Quyết định 729/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 2 Quyết định 729/QĐ-ĐHNT ngày 28/5/2025 của Hiệu trưởng Trường Đại học Nha Trang về mức học phí năm học 2025-2026"@vi ;
    :documentUrl "https://phongkhtc.ntu.edu.vn/uploads/1/Doc/693/q%C4%91-729-(2025).pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision729 ;
    :articleNumber "2"^^xsd:integer ;
    :headingText "Quyết định này có hiệu lực từ Học kỳ I năm học 2025-2026 đến khi có quy định mới. Bãi bỏ các quy định trước đây có nội dung trái với Quyết định này."@vi .

:Decision729Article03 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 3 Quyết định 729/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 3 Quyết định 729/QĐ-ĐHNT ngày 28/5/2025 của Hiệu trưởng Trường Đại học Nha Trang về mức học phí năm học 2025-2026"@vi ;
    :documentUrl "https://phongkhtc.ntu.edu.vn/uploads/1/Doc/693/q%C4%91-729-(2025).pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision729 ;
    :articleNumber "3"^^xsd:integer ;
    :headingText "Các ông/bà Trưởng phòng Kế hoạch - Tài chính, Đào tạo Đại học, Đào tạo Sau đại học, Công tác Chính trị và Sinh viên, các tổ chức, cá nhân có liên quan và người học chịu trách nhiệm thi hành quyết định này./."@vi .

