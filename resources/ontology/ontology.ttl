    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article23 ;
    :officialText "Bằng tốt nghiệp đại học được cấp theo ngành đào tạo."@vi ;
    :articleNumber "23"^^xsd:integer ;
    :clauseNumber "1"^^xsd:integer .

