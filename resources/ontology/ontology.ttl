    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Làm đơn đăng ký thực hiện đồ án tốt nghiệp theo Mẫu số 02 (Phụ lục 4)."@vi ;
    :usesForm :Form02GraduationProject ;
    rdfs:label "Đăng ký đồ án - bước 1"@vi .

:GraduationRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article22Clause01PointA ;
    :requirementOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Đến thời điểm xét tốt nghiệp không bị truy cứu trách nhiệm hình sự và không đang trong thời gian bị kỷ luật ở mức đình chỉ học tập."@vi ;
    rdfs:label "Điều kiện tốt nghiệp - kỷ luật"@vi .

:GraduationRequirement02 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article22Clause01PointB ;
    :requirementOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Tích lũy đủ số học phần và khối lượng học tập của chương trình đào tạo, đạt chuẩn đầu ra và các nội dung bắt buộc khác."@vi ;
    rdfs:label "Điều kiện tốt nghiệp - khối lượng học tập"@vi .

:GraduationRequirement03 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article22Clause01PointC ;
    :requirementOrder "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Điểm trung bình chung tích lũy toàn khóa học đạt từ 5,50 trở lên."@vi ;
    rdfs:label "Điều kiện tốt nghiệp - điểm trung bình tích lũy"@vi .

:GraduationRequirement04 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article22Clause01PointD ;
    :requirementOrder "4"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Đạt năng lực ngoại ngữ theo quy định đối với mỗi khóa đào tạo."@vi ;
    rdfs:label "Điều kiện tốt nghiệp - năng lực ngoại ngữ"@vi .

:GraduationRequirement05 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article22Clause01PointDD ;
    :requirementOrder "5"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Hoàn thành các học phần Giáo dục quốc phòng - An ninh, Giáo dục thể chất và các học phần điều kiện khác nếu có."@vi ;
    rdfs:label "Điều kiện tốt nghiệp - học phần điều kiện"@vi .

:GraduationRequirement06 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article22Clause01PointE ;
    :requirementOrder "6"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Hoàn thành các nghĩa vụ khác theo quy định của Trường như trả sách thư viện, quyết toán đề tài nghiên cứu khoa học và học phí."@vi ;
    rdfs:label "Điều kiện tốt nghiệp - nghĩa vụ với Trường"@vi .

:GraduationReviewDeadline a :Deadline, owl:NamedIndividual ;
    :basedOn :Regulation1052Article22Clause05 ;
    :deadlineText "Trong thời hạn 03 tháng kể từ thời điểm sinh viên đáp ứng đầy đủ điều kiện tốt nghiệp và hoàn thành nghĩa vụ với Trường."@vi ;
