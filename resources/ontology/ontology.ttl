:Regulation753Article10 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 10 Quy chế đào tạo trình độ đại học năm 2021"@vi ;
    :citationLabel "Điều 10 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 753/QĐ-ĐHNT ngày 13/8/2021"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/312/q%C4%91-753-vv-ban-h%C3%A0nh-quy-ch%E1%BA%BF-%C4%91%C3%A0o-t%E1%BA%A1o_13.8.2021.pdf.pdf"^^xsd:anyURI ;
    :inDocument :Regulation753 ;
    :title "Rút bớt học phần đã đăng ký"@vi ;
    :officialText "Sau thời gian đăng ký học, nếu SV xét thấy không thể hoàn thành khối lượng học tập đã đăng ký thì có thể làm đơn xin rút bớt (hủy) một hoặc một số học phần đã đăng ký với điều kiện không vi phạm giới hạn tối thiểu quy định tại khoản 3, khoản 4 Điều 9 của Quy chế này. Việc rút bớt học phần trong khối lượng học tập đã đăng ký của SV chỉ được chấp nhận tối đa trong tuần thứ hai học kỳ chính, tuần thứ nhất học kỳ phụ. Ngoài thời hạn trên, học phần vẫn được giữ nguyên như đã đăng ký và nếu SV không đi học được xem như tự ý bỏ học và phải nhận điểm 0 (không). Sinh viên tự thực hiện việc rút bớt học phần đã đăng ký trên Hệ thống quản lý đào tạo từ tài khoản cá nhân hoặc trực tiếp nộp đơn đề nghị rút bớt học phần tại Đơn vị quản lý đào tạo (Mẫu số 2 - Phiếu đăng ký/điều chỉnh học phần)."@vi ;
    :articleNumber "10"^^xsd:integer .

:Regulation753Article10Clause01 a :Clause, owl:NamedIndividual ;
    rdfs:label "khoản 1 Điều 10 Quy chế đào tạo trình độ đại học năm 2021"@vi ;
