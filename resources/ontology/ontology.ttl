    :articleNumber "32"^^xsd:integer ;
    :clauseNumber "2"^^xsd:integer .

:Regulation1052Article32Clause03 a :Clause, owl:NamedIndividual ;
    rdfs:label "khoản 3 Điều 32 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "khoản 3 Điều 32 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
