:TuitionPaymentProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :TuitionPaymentGuidanceIntro ;
    :hasStep :TuitionPaymentStep01,
        :TuitionPaymentStep02,
        :TuitionPaymentStep03 ;
    :summaryText "Thủ tục nộp học phí qua cổng thanh toán trực tuyến, ứng dụng ngân hàng hoặc quầy giao dịch."@vi ;
    :supportsPaymentMethod :CashAtBankCounterPayment,
        :MobileOrInternetBankingPayment,
        :QRCodePayment,
        :VNPAYPayment ;
    rdfs:label "Thủ tục nộp học phí"@vi ;
    skos:altLabel "nộp học phí"@vi,
        "nộp tiền học"@vi,
        "thanh toán học phí"@vi,
        "đóng học phí"@vi,
        "đóng tiền học"@vi .

:TuitionPaymentStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :TuitionPaymentGuidanceSection01 ;
    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Truy cập sinhvien.ntu.edu.vn, chọn mục học phí và thanh toán qua cổng VnPay; miễn phí với tài khoản Vietcombank, các ngân hàng khác chịu phí 5.500 đồng mỗi lần. Có thể quét mã QR bằng ứng dụng ngân hàng, miễn phí."@vi ;
    rdfs:label "Nộp học phí - cách 1"@vi .

:TuitionPaymentStep02 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :TuitionPaymentGuidanceSection02 ;
    :performedBy :Student ;
    :stepOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Nếu có tài khoản Agribank, Vietinbank hoặc Liên Việt PostBank, dùng Mobile Banking hoặc Internet Banking để đóng học phí, miễn phí."@vi ;
    rdfs:label "Nộp học phí - cách 2"@vi .

:TuitionPaymentStep03 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :TuitionPaymentGuidanceSection03 ;
    :performedBy :Student ;
    :stepOrder "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Đến quầy giao dịch Agribank, Vietinbank hoặc Liên Việt PostBank nộp tiền mặt và cung cấp mã sinh viên cho ngân hàng tra cứu; tuyệt đối không cung cấp số tài khoản của Trường cho ngân hàng."@vi ;
    rdfs:label "Nộp học phí - cách 3"@vi .

:UndergraduateLevel a :EducationLevel, owl:NamedIndividual ;
    :basedOn :Decision729AppendixI ;
    rdfs:label "Trình độ đại học"@vi .

:University a :AcademicActor, :OrganizationalUnit, owl:NamedIndividual ;
    :officeAddress "02 Nguyễn Đình Chiểu, phường Bắc Nha Trang, Khánh Hòa" ;
    :officeEmail "dhnt@ntu.edu.vn" ;
