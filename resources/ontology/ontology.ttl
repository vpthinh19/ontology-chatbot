    :hasStep :ExamPostponementStep01,
        :ExamPostponementStep02 ;
    :requiresForm :Form04ExamPostponement ;
    :submittedTo :AcademicManagementUnit ;
    :summaryText "Thủ tục xin hoãn thi kết thúc học phần vì lý do sức khỏe."@vi ;
    rdfs:label "Thủ tục xin hoãn thi"@vi ;
    skos:altLabel "hoãn thi"@vi,
        "lùi lịch thi"@vi,
