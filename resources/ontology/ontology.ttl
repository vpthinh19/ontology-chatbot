    :issueDate "2026-03-25"^^xsd:date ;
    :retrievedDate "2026-08-10"^^xsd:date ;
    :webPageUrl "https://phongctsv.ntu.edu.vn/danh-muc/hoc-bong-khuyen-khich-hoc-tap"^^xsd:anyURI .

:ScholarshipAnnouncementSection a :DocumentSection, owl:NamedIndividual ;
    rdfs:label "cách công bố và phản hồi danh sách học bổng"@vi ;
    :citationLabel "thông báo Danh sách dự kiến Học bổng khuyến khích học tập của Phòng Công tác Chính trị và Sinh viên, đăng ngày 25/3/2026"@vi ;
    :documentUrl "https://phongctsv.ntu.edu.vn/thong-bao/danh-sach-du-kien-hoc-bong-khuyen-khich-hoc-tap-hki-2025-2026"^^xsd:anyURI ;
    :inDocument :ScholarshipAnnouncementGuidance .

:ScholarshipReviewProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation1052Article18Clause03,
        :Regulation1052Article19Clause03,
        :ScholarshipCriteriaGeneralSection ;
    :hasDeadline :ScholarshipFeedbackDeadline ;
    :hasOutcome :ScholarshipReviewOutcome ;
    :hasRequirement :ScholarshipRequirement01,
        :ScholarshipRequirement02,
        :ScholarshipRequirement03,
        :ScholarshipRequirement04,
        :ScholarshipRequirement05 ;
    :hasStep :ScholarshipStep01,
        :ScholarshipStep02,
        :ScholarshipStep03 ;
    :reviewedBy :StudentAffairsOffice ;
    :summaryText "Trường tự xét học bổng khuyến khích học tập sau mỗi học kỳ chính dựa trên kết quả học tập và rèn luyện; sinh viên không phải nộp đơn, nhưng người có tên trong danh sách phải cung cấp số tài khoản để nhận tiền."@vi ;
    rdfs:label "Thủ tục xét và cấp học bổng khuyến khích học tập"@vi ;
    skos:altLabel "cấp học bổng"@vi,
        "nhận tiền học bổng"@vi,
        "xét cấp học bổng khuyến khích học tập"@vi,
        "xét học bổng"@vi .

:ScholarshipRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :ScholarshipCriteriaGeneralSection ;
    :requirementOrder "1"^^xsd:integer ;
    :requirementText "Còn trong thời gian đào tạo theo kế hoạch của khóa học."@vi ;
    rdfs:label "Điều kiện học bổng - còn trong thời gian đào tạo"@vi .

:ScholarshipRequirement02 a :Requirement, owl:NamedIndividual ;
    :basedOn :ScholarshipCriteriaGeneralSection ;
    :requirementOrder "2"^^xsd:integer ;
    :requirementText "Kết quả học tập và rèn luyện trong học kỳ đạt từ loại khá trở lên, và không bị kỷ luật từ mức khiển trách trở lên."@vi ;
    rdfs:label "Điều kiện học bổng - học tập và rèn luyện từ khá trở lên"@vi .

:ScholarshipRequirement03 a :Requirement, owl:NamedIndividual ;
    :basedOn :ScholarshipCriteriaSpecificSection ;
    :requirementOrder "3"^^xsd:integer ;
    :requirementText "Đăng ký tối thiểu 14 tín chỉ trong học kỳ theo kế hoạch của chương trình đào tạo."@vi ;
    rdfs:label "Điều kiện học bổng - tối thiểu 14 tín chỉ"@vi .

:ScholarshipRequirement04 a :Requirement, owl:NamedIndividual ;
    :basedOn :ScholarshipCriteriaSpecificSection ;
    :requirementOrder "4"^^xsd:integer ;
    :requirementText "Mọi học phần trong kỳ phải đạt từ 5,5 điểm trở lên ngay ở lần thi đầu; điểm Giáo dục thể chất và Giáo dục quốc phòng không tính vào điểm xét."@vi ;
    rdfs:label "Điều kiện học bổng - đạt ngay lần thi đầu"@vi .

:ScholarshipRequirement05 a :Requirement, owl:NamedIndividual ;
    :basedOn :ScholarshipCriteriaSpecificSection ;
    :requirementOrder "5"^^xsd:integer ;
    :requirementText "Không hoãn thi trong kỳ, trừ trường hợp hoãn do trùng lịch thi và đã thi lại trong cùng đợt; học kỳ đầu sau khi chuyển ngành không được xét."@vi ;
    rdfs:label "Điều kiện học bổng - không hoãn thi, không phải kỳ đầu sau chuyển ngành"@vi .

:ScholarshipStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article18Clause03,
        :Regulation1052Article19Clause03 ;
    :performedBy :StudentAffairsOffice ;
    :stepOrder "1"^^xsd:integer ;
    :stepText "Trường xét học bổng theo điểm trung bình chung của từng học kỳ chính, không xét kết quả học kỳ hè. Sinh viên không phải nộp đơn."@vi ;
    rdfs:label "Xét học bổng - bước 1"@vi .

:ScholarshipStep02 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :ScholarshipAnnouncementSection ;
    :performedBy :StudentAffairsOffice ;
    :stepOrder "2"^^xsd:integer ;
    :stepText "Phòng Công tác Chính trị và Sinh viên công bố danh sách dự kiến trên trang của phòng, tách riêng chương trình chuẩn và chương trình đào tạo đặc biệt. Sinh viên tự kiểm tra và gửi thắc mắc theo địa chỉ ghi trong thông báo."@vi ;
    rdfs:label "Xét học bổng - bước 2"@vi .

:ScholarshipStep03 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :ScholarshipAnnouncementSection ;
    :performedBy :Student ;
    :stepOrder "3"^^xsd:integer ;
    :stepText "Sinh viên có tên trong danh sách cung cấp số tài khoản Vietinbank và chi nhánh để nhận tiền, dùng địa chỉ thư điện tử do Trường cấp."@vi ;
    rdfs:label "Xét học bổng - bước 3"@vi .

:ScholarshipFeedbackDeadline a :Deadline, owl:NamedIndividual ;
    :basedOn :ScholarshipAnnouncementSection ;
    :deadlineText "Thời hạn phản hồi ghi trong từng thông báo. Đợt học kỳ I năm học 2025-2026 nhận thắc mắc đến hết ngày 30/3/2026."@vi ;
    rdfs:label "Thời hạn phản hồi danh sách dự kiến học bổng"@vi .

:ScholarshipReviewOutcome a :Outcome, owl:NamedIndividual ;
    :basedOn :ScholarshipCriteriaGeneralSection ;
    :outcomeText "Sinh viên đủ điều kiện được cấp học bổng khuyến khích học tập của học kỳ, mức tiền theo xếp loại và theo chương trình chuẩn hay chương trình đào tạo đặc biệt."@vi ;
    rdfs:label "Kết quả xét học bổng khuyến khích học tập"@vi .

# =====================================================================
# QĐ1965 - SỬA ĐỔI PHỤ LỤC 2 CỦA QUY CHẾ 1052
# =====================================================================
#
# Đây là văn bản DUY NHẤT trong đồ thị phân biệt theo KHOÁ ở mức nội dung, chứ
# không phải ở mức "văn bản này áp dụng cho khoá nào". Cùng một học phần Ngoại
# ngữ B1.1: khoá 67 trở về trước là học phần BẮT BUỘC, khoá 68 trở đi thành học
# phần ĐIỀU KIỆN. Trả lời mà không hỏi khoá là trả lời sai một nửa số người hỏi.
#
# Vì vậy mỗi học phần có HAI node phân loại, mỗi node mang giới hạn khoá của nó,
# thay vì nhét hai câu trả lời vào một node.
#
# QĐ1965 chỉ BỔ SUNG hai khoản mới, không sửa chữ nào của Phụ lục 2 cũ - nên
# phần Phụ lục 2 đã có trong đồ thị vẫn đúng nguyên.

:Decision1965 a :Decision, owl:NamedIndividual ;
    rdfs:label "Quyết định số 1965/QĐ-ĐHNT"@vi ;
    :documentNumber "1965/QĐ-ĐHNT"@vi ;
    :issueDate "2025-12-19"^^xsd:date ;
    :title "Sửa đổi, bổ sung Phụ lục quy chế đào tạo trình độ đại học"@vi ;
    :amends :Regulation1052 ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/809/qd-1965--19-12-2025--sua-doi--bo-sung-phu-luc-quy-che-dao-tao-trinh-do-dai-hoc-pdf.pdf"^^xsd:anyURI .

:Decision1965Article01 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 1 Quyết định 1965/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 1 Quyết định 1965/QĐ-ĐHNT ngày 19/12/2025 của Hiệu trưởng Trường Đại học Nha Trang về sửa đổi, bổ sung Phụ lục quy chế đào tạo trình độ đại học"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/809/qd-1965--19-12-2025--sua-doi--bo-sung-phu-luc-quy-che-dao-tao-trinh-do-dai-hoc-pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision1965 ;
    :articleNumber "1"^^xsd:integer ;
    :officialText "Sửa đổi, bổ sung Phụ lục của Quy chế đào tạo trình độ đại học kèm theo Quyết định số 1052/QĐ-ĐHNT ngày 17/7/2025 của Hiệu trưởng Trường Đại học Nha Trang, cụ thể như sau: Bổ sung khoản 1.3 và 1.4 trong Mục 1 của Phụ lục 2, với nội dung."@vi .

:Decision1965Article01Table01 a :DocumentTable, owl:NamedIndividual ;
    rdfs:label "bảng khoản 1.3 danh mục học phần ngoại ngữ"@vi ;
    :citationLabel "bảng khoản 1.3 Điều 1 Quyết định 1965/QĐ-ĐHNT ngày 19/12/2025 của Hiệu trưởng Trường Đại học Nha Trang về sửa đổi, bổ sung Phụ lục quy chế đào tạo trình độ đại học"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/809/qd-1965--19-12-2025--sua-doi--bo-sung-phu-luc-quy-che-dao-tao-trinh-do-dai-hoc-pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision1965 ;
    :headingText "Danh mục học phần"@vi ;
    :verbatimTableText """| STT | Học phần | Tín chỉ | Khung NLNN tương ứng | Khóa 67 trở về trước | Khóa 68 trở đi |
| :---: | :--- | :---: | :--- | :--- | :--- |
| 1 | Ngoại ngữ A1 | 4 | Bậc 1 | Học phần điều kiện (HPĐK) | HPĐK |
| 2 | Ngoại ngữ A2.1 | 4 | Bậc 2 | Học phần điều kiện (HPĐK) | HPĐK |
| 3 | Ngoại ngữ A2.2 | 4 | Bậc 2 | Học phần điều kiện (HPĐK) | HPĐK |
| 4 | Ngoại ngữ B1.1 | 4 | Bậc 3 | Học phần bắt buộc (HPBB) | HPĐK |
| 5 | Ngoại ngữ B1.2 | 4 | Bậc 3 | Học phần bắt buộc (HPBB) | HPĐK |
| 6 | Ngoại ngữ B2.1 | 4 | Bậc 4 | HPBB (chương trình kỹ sư) | HPBB |
| 7 | Ngoại ngữ B2.2 | 4 | Bậc 4 | HPBB (chương trình kỹ sư) | HPBB |"""@vi ;
    :officialText """STT — Học phần — Tín chỉ — Khung NLNN tương ứng — Khóa 67 trở về trước — Khóa 68 trở đi
1 — Ngoại ngữ A1 — 4 tín chỉ — Bậc 1 — Khóa 67 trở về trước: Học phần điều kiện (HPĐK) — Khóa 68 trở đi: HPĐK\n2 — Ngoại ngữ A2.1 — 4 tín chỉ — Bậc 2 — Khóa 67 trở về trước: Học phần điều kiện (HPĐK) — Khóa 68 trở đi: HPĐK\n3 — Ngoại ngữ A2.2 — 4 tín chỉ — Bậc 2 — Khóa 67 trở về trước: Học phần điều kiện (HPĐK) — Khóa 68 trở đi: HPĐK\n4 — Ngoại ngữ B1.1 — 4 tín chỉ — Bậc 3 — Khóa 67 trở về trước: Học phần bắt buộc (HPBB) — Khóa 68 trở đi: HPĐK\n5 — Ngoại ngữ B1.2 — 4 tín chỉ — Bậc 3 — Khóa 67 trở về trước: Học phần bắt buộc (HPBB) — Khóa 68 trở đi: HPĐK\n6 — Ngoại ngữ B2.1 — 4 tín chỉ — Bậc 4 — Khóa 67 trở về trước: HPBB (chương trình kỹ sư) — Khóa 68 trở đi: HPBB\n7 — Ngoại ngữ B2.2 — 4 tín chỉ — Bậc 4 — Khóa 67 trở về trước: HPBB (chương trình kỹ sư) — Khóa 68 trở đi: HPBB"""@vi .

:Decision1965Article01Table02 a :DocumentTable, owl:NamedIndividual ;
    rdfs:label "bảng khoản 1.4 kiểm tra đánh giá học phần ngoại ngữ"@vi ;
    :citationLabel "bảng khoản 1.4 Điều 1 Quyết định 1965/QĐ-ĐHNT ngày 19/12/2025 của Hiệu trưởng Trường Đại học Nha Trang về sửa đổi, bổ sung Phụ lục quy chế đào tạo trình độ đại học"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38/Doc/809/qd-1965--19-12-2025--sua-doi--bo-sung-phu-luc-quy-che-dao-tao-trinh-do-dai-hoc-pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision1965 ;
    :headingText "Kiểm tra, đánh giá học phần"@vi ;
    :verbatimTableText """| STT | Học phần | Thành phần đánh giá | Tỷ trọng |
| :---: | :--- | :--- | :---: |
| 1 | Ngoại ngữ A1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 2 | Ngoại ngữ A2.1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 3 | Ngoại ngữ A2.2 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 4 | Ngoại ngữ B1.1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 5 | Ngoại ngữ B1.2 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết<br>Thi kết thúc học phần phải đạt từ 5 điểm trở lên | 40% |
| 6 | Ngoại ngữ B2.1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 7 | Ngoại ngữ B2.2 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết<br>Thi kết thúc học phần phải đạt từ 5 điểm trở lên | 40% |"""@vi ;
    :officialText """STT — Học phần — Thành phần đánh giá — Tỷ trọng
1 — Ngoại ngữ A1 — Đánh giá quá trình 20% — Thi giữa kỳ: Nghe + Nói 40% — Thi cuối kỳ: Đọc + Viết 40%\n2 — Ngoại ngữ A2.1 — Đánh giá quá trình 20% — Thi giữa kỳ: Nghe + Nói 40% — Thi cuối kỳ: Đọc + Viết 40%\n3 — Ngoại ngữ A2.2 — Đánh giá quá trình 20% — Thi giữa kỳ: Nghe + Nói 40% — Thi cuối kỳ: Đọc + Viết 40%\n4 — Ngoại ngữ B1.1 — Đánh giá quá trình 20% — Thi giữa kỳ: Nghe + Nói 40% — Thi cuối kỳ: Đọc + Viết 40%\n5 — Ngoại ngữ B1.2 — Đánh giá quá trình 20% — Thi giữa kỳ: Nghe + Nói 40% — Thi cuối kỳ: Đọc + Viết 40% — Thi kết thúc học phần phải đạt từ 5 điểm trở lên\n6 — Ngoại ngữ B2.1 — Đánh giá quá trình 20% — Thi giữa kỳ: Nghe + Nói 40% — Thi cuối kỳ: Đọc + Viết 40%\n7 — Ngoại ngữ B2.2 — Đánh giá quá trình 20% — Thi giữa kỳ: Nghe + Nói 40% — Thi cuối kỳ: Đọc + Viết 40% — Thi kết thúc học phần phải đạt từ 5 điểm trở lên"""@vi .

