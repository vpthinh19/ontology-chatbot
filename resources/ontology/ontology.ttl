# Ontology học vụ Trường Đại học Nha Trang.
#
# Cơ sở dữ liệu duy nhất của chatbot: mọi truy vấn SPARQL đều chạy trên tệp này.
# Nội dung được xây từ các tài liệu chính thức trong references/ - khi công văn
# thay đổi, sửa trực tiếp tại đây.
#
# Ba tầng, phân biệt bằng lớp chứ không bằng tệp:
#   - văn bản   : Decision, Article, Clause, Point, Appendix, DocumentTable
#   - trích dẫn : mọi dữ kiện nghiệp vụ trỏ về phần văn bản bằng :basedOn
#   - nghiệp vụ : AcademicProcedure và các node nội dung, đây là đáp án
#
# Quy tắc biên soạn ở docs/ONTOLOGY.md, kiểm tra bằng: uv run pytest tests/ontology

@prefix : <http://www.ntu.edu.vn/ontology/academic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AcademicAdvisor a :AcademicActor,
        owl:NamedIndividual ;
    rdfs:label "Cố vấn học tập"@vi ;
    skos:altLabel "cố vấn học tập"@vi,
        "giáo viên chủ nhiệm"@vi .

:AcademicDismissalPolicy a :AcademicPolicy,
        owl:NamedIndividual ;
    rdfs:label "Chính sách buộc thôi học"@vi ;
    :basedOn :Decision1052Article20Clause02 ;
    :summaryText "Sinh viên bị buộc thôi học khi vượt quá 02 lần cảnh báo kết quả học tập liên tiếp hoặc vượt quá thời gian tối đa được phép học."@vi ;
    skos:altLabel "buộc thôi học"@vi,
        "đuổi học"@vi .

:AcademicOntology a owl:Ontology ;
    rdfs:label "Ontology học vụ Trường Đại học Nha Trang"@vi .

:AcademicWarningPolicy a :AcademicPolicy,
        owl:NamedIndividual ;
    rdfs:label "Chính sách cảnh báo kết quả học tập"@vi ;
