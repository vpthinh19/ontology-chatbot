:Decision1052Regulation a :AttachedRegulation,
        owl:NamedIndividual ;
    rdfs:label "Quy chế đào tạo trình độ đại học"@vi ;
    :hasPart :Decision1052Appendix01,
        :Decision1052Appendix02,
        :Decision1052Appendix03,
