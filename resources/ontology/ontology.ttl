:Decision1052Article25Clause01 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 25 khoản 1"@vi ;
    :articleNumber 25 ;
    :citationLabel "khoản 1 Điều 25 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
