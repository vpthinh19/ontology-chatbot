    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Tìm hiểu chương trình đào tạo, kế hoạch giảng dạy trong học kỳ và kiểm tra lại kết quả học tập để lập kế hoạch học tập phù hợp."@vi ;
    rdfs:label "Đăng ký học phần - bước 1"@vi .

:CourseRegistrationStep02 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause02PointB ;
    :performedBy :Student ;
    :stepOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Đăng ký lớp của các học phần dự định học trong học kỳ, gồm học phần mới, học phần chưa đạt để học lại và học phần đã đạt để cải thiện điểm."@vi ;
    rdfs:label "Đăng ký học phần - bước 2"@vi .

:CourseRegistrationStep03 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause02PointC ;
    :performedBy :Student ;
    :stepOrder "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Xin ý kiến tư vấn của Cố vấn học tập trước khi đăng ký các lớp học phần."@vi ;
    rdfs:label "Đăng ký học phần - bước 3"@vi .

:CourseRegistrationStep04 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause02PointD ;
    :performedBy :Student ;
    :stepOrder "4"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Xác nhận đăng ký học phần theo thời gian quy định từ tài khoản cá nhân trên Hệ thống quản lý đào tạo."@vi ;
    rdfs:label "Đăng ký học phần - bước 4"@vi .

:CourseRetakeOutcome a :Outcome, owl:NamedIndividual ;
    :basedOn :Regulation1052Article11Clause04 ;
    :outcomeText "Kết quả học tập tích lũy được ghi nhận cho lần học cùng học phần có điểm cao hơn."@vi ;
    rdfs:label "Kết quả ghi nhận khi học lại"@vi .

:CourseRetakeProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation1052Article11 ;
    :hasOutcome :CourseRetakeOutcome ;
    :hasRequirement :CourseRetakeRequirement01 ;
    :hasStep :CourseRetakeStep01 ;
    :summaryText "Thủ tục đăng ký học lại học phần có điểm dưới 5,0."@vi ;
    rdfs:label "Thủ tục đăng ký học lại học phần"@vi ;
    skos:altLabel "học lại học phần"@vi,
        "học lại môn"@vi,
        "học lại"@vi,
        "đăng ký học lại"@vi,
        "đăng ký lại môn chưa đạt"@vi .

:CourseRetakeRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article11Clause01 ;
    :requirementOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Học phần bắt buộc có điểm dưới 5,0 phải đăng ký học lại cho đến khi đạt từ 5,0 trở lên; học phần tự chọn dưới 5,0 được học lại hoặc đổi sang học phần tự chọn tương đương khác."@vi ;
    rdfs:label "Điều kiện phải học lại"@vi .

:CourseRetakeStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article11Clause01 ;
    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Đăng ký học lại học phần đó ở các học kỳ tiếp theo theo quy trình đăng ký khối lượng học tập."@vi ;
    rdfs:label "Học lại - bước 1"@vi .

:CreditRecognitionOutcome a :Outcome, owl:NamedIndividual ;
    :basedOn :Regulation1052Article21Clause03 ;
    :outcomeText "Kết quả được công nhận và chuyển đổi theo từng học phần, theo từng nhóm học phần, hoặc theo cả chương trình đào tạo."@vi ;
    rdfs:label "Kết quả công nhận tín chỉ"@vi .

# Thủ tục duy nhất trong đồ thị dẫn nguồn từ quy chế đời 2021, vì QĐ1052 không
# có điều nào về việc sinh viên rút bớt học phần. Lý do đầy đủ ghi ở khối
# Regulation753 phía trên.
:CourseWithdrawalProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation753Article10 ;
    :hasConsequence :CourseWithdrawalLateConsequence ;
    :hasDeadline :CourseWithdrawalDeadline ;
    :hasRequirement :CourseWithdrawalRequirement01 ;
    :hasStep :CourseWithdrawalStep01 ;
    :requiresForm :Form02CourseAdjustment ;
    :submittedTo :AcademicManagementUnit ;
    :summaryText "Thủ tục cho phép sinh viên hủy bớt một hoặc một số học phần đã đăng ký trong học kỳ khi thấy không thể hoàn thành khối lượng đã đăng ký."@vi ;
    rdfs:label "Thủ tục rút bớt học phần đã đăng ký"@vi ;
    skos:altLabel "hủy học phần đã đăng ký"@vi,
        "rút bớt học phần"@vi,
        "rút học phần đã đăng ký"@vi,
        "xin rút bớt học phần"@vi .

:CourseWithdrawalRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation753Article10Clause01 ;
    :requirementOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Sau khi rút bớt, khối lượng học tập còn lại không được vi phạm giới hạn tối thiểu quy định tại khoản 3 và khoản 4 Điều 9 của Quy chế này."@vi ;
    rdfs:label "Điều kiện rút bớt học phần - không phá giới hạn tối thiểu"@vi .

:CourseWithdrawalDeadline a :Deadline, owl:NamedIndividual ;
    :basedOn :Regulation753Article10Clause02 ;
    :deadlineText "Chỉ được chấp nhận tối đa trong tuần thứ hai của học kỳ chính, tuần thứ nhất của học kỳ phụ."@vi ;
    rdfs:label "Thời hạn rút bớt học phần đã đăng ký"@vi .

:CourseWithdrawalLateConsequence a :Consequence, owl:NamedIndividual ;
    :basedOn :Regulation753Article10Clause02 ;
    :consequenceText "Quá thời hạn, học phần vẫn được giữ nguyên như đã đăng ký; sinh viên không đi học thì xem như tự ý bỏ học và phải nhận điểm 0."@vi ;
    rdfs:label "Hệ quả khi rút bớt học phần quá hạn"@vi .

:CourseWithdrawalStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation753Article10Clause03 ;
    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Tự rút bớt học phần trên Hệ thống quản lý đào tạo từ tài khoản cá nhân, hoặc nộp đơn đề nghị rút bớt học phần tại Đơn vị quản lý đào tạo."@vi ;
    rdfs:label "Rút bớt học phần - bước 1"@vi .

# Số mẫu này là số của QĐ753, KHÔNG phải của QĐ1052. Danh mục biểu mẫu trên web
# cũng đánh số 2 cho đúng biểu mẫu này, nên mục tải bên dưới trỏ về đây.
