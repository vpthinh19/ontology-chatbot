    :clauseNumber "2"^^xsd:integer ;
    :pointLetter "d" .

:Regulation1052Article12Clause02PointDD a :Point, owl:NamedIndividual ;
    rdfs:label "điểm đ khoản 2 Điều 12 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm đ khoản 2 Điều 12 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article12Clause02 ;
    :officialText "Hướng dẫn và hỗ trợ SV học tập, nghiên cứu ngoài giờ lên lớp theo phương thức trực tiếp và trực tuyến."@vi ;
    :articleNumber "12"^^xsd:integer ;
    :clauseNumber "2"^^xsd:integer ;
    :pointLetter "đ" .

:Regulation1052Article12Clause02PointE a :Point, owl:NamedIndividual ;
    rdfs:label "điểm e khoản 2 Điều 12 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm e khoản 2 Điều 12 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article12Clause02 ;
    :officialText "Trường hợp không đảm bảo kế hoạch như dự kiến, GV điều chỉnh kế hoạch dạy học, sắp xếp lịch dạy học bù, cập nhật Đề cương chi tiết học phần trên hệ thống NTU E-learning lớp học phần và thông báo ngay tới SV."@vi ;
    :articleNumber "12"^^xsd:integer ;
    :clauseNumber "2"^^xsd:integer ;
    :pointLetter "e" .

:Regulation1052Article12Clause02PointG a :Point, owl:NamedIndividual ;
    rdfs:label "điểm g khoản 2 Điều 12 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm g khoản 2 Điều 12 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article12Clause02 ;
    :officialText "Thông báo triển khai tất cả hoạt động dạy học, kiểm tra, đánh giá trên hệ thống NTU E-learning lớp học phần."@vi ;
    :articleNumber "12"^^xsd:integer ;
    :clauseNumber "2"^^xsd:integer ;
    :pointLetter "g" .

:Regulation1052Article12Clause02PointH a :Point, owl:NamedIndividual ;
    rdfs:label "điểm h khoản 2 Điều 12 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm h khoản 2 Điều 12 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article12Clause02 ;
    :officialText "Thu nhận thông tin phản hồi từ SV để liên tục hoàn thiện nội dung, phương pháp giảng dạy, kiểm tra, đánh giá học phần."@vi ;
    :articleNumber "12"^^xsd:integer ;
    :clauseNumber "2"^^xsd:integer ;
    :pointLetter "h" .

:Regulation1052Article12Clause03 a :Clause, owl:NamedIndividual ;
    rdfs:label "khoản 3 Điều 12 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "khoản 3 Điều 12 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article12 ;
    :officialText """Khi tham gia học tập, SV có nhiệm vụ sau:
a) Thường xuyên cập nhật và thực hiện đúng kế hoạch dạy học, kiểm tra, đánh giá theo Đề cương chi tiết học phần trên hệ thống NTU E-learning lớp học phần.
b) Thực hiện đầy đủ và trung thực các nhiệm vụ học tập, kiểm tra, đánh giá theo Đề cương chi tiết học phần và hướng dẫn của GV giảng dạy học phần.
c) Thực hiện đầy đủ các quy định khác của Nhà trường và của GV giảng dạy học phần."""@vi ;
    :articleNumber "12"^^xsd:integer ;
    :clauseNumber "3"^^xsd:integer .

:Regulation1052Article12Clause03PointA a :Point, owl:NamedIndividual ;
    rdfs:label "điểm a khoản 3 Điều 12 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm a khoản 3 Điều 12 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article12Clause03 ;
