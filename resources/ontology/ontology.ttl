:StandardEnglishCertificateTable a :DocumentTable,
        owl:NamedIndividual ;
    rdfs:label "Bảng quy đổi chứng chỉ tiếng Anh - chương trình chuẩn"@vi ;
    :hasPart :StandardEnglishCertificateTableRow01,
        :StandardEnglishCertificateTableRow02,
        :StandardEnglishCertificateTableRow03,
        :StandardEnglishCertificateTableRow04,
        :StandardEnglishCertificateTableRow05 ;
