:ExamPostponementDeadline a :Deadline, owl:NamedIndividual ;
    :basedOn :Regulation1052Article30Clause02 ;
    :deadlineText "Nộp đơn trước ngày thi."@vi ;
    rdfs:label "Thời hạn nộp đơn xin hoãn thi"@vi .

:ExamPostponementOutcome a :Outcome, owl:NamedIndividual ;
    :basedOn :Regulation1052Article17Clause04 ;
    :outcomeText "Sinh viên được dự thi cuối kỳ học phần đó trong thời hạn 02 học kỳ chính tiếp theo; quá thời hạn này điểm đánh giá cuối kỳ sẽ là 0."@vi ;
    rdfs:label "Kết quả xin hoãn thi"@vi .

:ExamPostponementProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation1052Article30Clause02 ;
