:CourseRegistrationRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause03 ;
    :requirementOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Sinh viên xếp loại học lực trung bình trở lên đăng ký tối thiểu 15 tín chỉ và tối đa 27 tín chỉ với chương trình 4 năm, tối đa 32 tín chỉ với chương trình 4,5 năm và chương trình đặc biệt."@vi ;
    rdfs:label "Giới hạn tín chỉ - học lực trung bình trở lên"@vi .

:CourseRegistrationRequirement02 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause04 ;
    :requirementOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Sinh viên xếp loại học lực yếu kém của học kỳ liền trước đăng ký tối thiểu 12 tín chỉ và tối đa 18 tín chỉ."@vi ;
    rdfs:label "Giới hạn tín chỉ - học lực yếu kém"@vi .

:CourseRegistrationStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause02PointA ;
    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Tìm hiểu chương trình đào tạo, kế hoạch giảng dạy trong học kỳ và kiểm tra lại kết quả học tập để lập kế hoạch học tập phù hợp."@vi ;
    rdfs:label "Đăng ký học phần - bước 1"@vi .

:CourseRegistrationStep02 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause02PointB ;
    :performedBy :Student ;
    :stepOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Đăng ký lớp của các học phần dự định học trong học kỳ, gồm học phần mới, học phần chưa đạt để học lại và học phần đã đạt để cải thiện điểm."@vi ;
    rdfs:label "Đăng ký học phần - bước 2"@vi .

:CourseRegistrationStep03 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause02PointC ;
    :performedBy :Student ;
    :stepOrder "3"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Xin ý kiến tư vấn của Cố vấn học tập trước khi đăng ký các lớp học phần."@vi ;
    :submittedTo :FacultyOrInstitute ;
    rdfs:label "Đăng ký học phần - bước 3"@vi .

:CourseRegistrationStep04 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article09Clause02PointD ;
    :performedBy :Student ;
    :stepOrder "4"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Xác nhận đăng ký học phần theo thời gian quy định từ tài khoản cá nhân trên Hệ thống quản lý đào tạo."@vi ;
    rdfs:label "Đăng ký học phần - bước 4"@vi .

:CourseRetakeOutcome a :Outcome, owl:NamedIndividual ;
    :basedOn :Regulation1052Article11Clause04 ;
    :outcomeText "Kết quả học tập tích lũy được ghi nhận cho lần học cùng học phần có điểm cao hơn."@vi ;
    rdfs:label "Kết quả ghi nhận khi học lại"@vi .

:CourseRetakeProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation1052Article11 ;
    :hasOutcome :CourseRetakeOutcome ;
    :hasRequirement :CourseRetakeRequirement01 ;
    :hasStep :CourseRetakeStep01 ;
    :summaryText "Thủ tục đăng ký học lại học phần có điểm dưới 5,0."@vi ;
    rdfs:label "Thủ tục đăng ký học lại học phần"@vi ;
    skos:altLabel "học lại học phần"@vi,
        "học lại môn"@vi,
