:Decision317 a :Decision, owl:NamedIndividual ;
    rdfs:label "Quyết định số 317/QĐ-ĐHNT"@vi ;
    :documentNumber "317/QĐ-ĐHNT"@vi ;
    :issueDate "2025-03-07"^^xsd:date ;
    :title "Về mức học bổng khuyến khích học tập cho sinh viên năm học 2024-2025"@vi ;
    :effectiveFromAcademicYear "2024-2025"@vi ;
    :documentUrl "https://ntu.edu.vn/uploads/57/Doc/777/qd-317_muc-hbkkht-2024-2025-pdf.pdf"^^xsd:anyURI .

# Nguyên văn chép từ BẢN SCAN, không phải từ bản OCR: bộ OCR tự sửa lỗi của
# công văn (thêm "lên" vào "đạt từ mức khá trở", bỏ chữ lặp "Trường Trường").
# ``references/Qd317.md`` đã được hoàn nguyên cho khớp bản gốc.
:Decision317Article01 a :Article, owl:NamedIndividual ;
    rdfs:label "Điều 1 Quyết định 317/QĐ-ĐHNT"@vi ;
    :citationLabel "Điều 1 Quyết định 317/QĐ-ĐHNT ngày 07/3/2025 của Hiệu trưởng Trường Đại học Nha Trang về mức học bổng khuyến khích học tập năm học 2024-2025"@vi ;
    :documentUrl "https://ntu.edu.vn/uploads/57/Doc/777/qd-317_muc-hbkkht-2024-2025-pdf.pdf"^^xsd:anyURI ;
    :inDocument :Decision317 ;
    :articleNumber "1"^^xsd:integer ;
    :officialText """Mức học bổng khuyến khích học tập cho sinh viên đại học hệ đào tạo chính quy có kết quả học tập và rèn luyện đạt từ mức khá trở, cụ thể như sau:
STT — Xếp loại học bổng — Học bổng 05 tháng / học kỳ (VNĐ)
1 — Xuất sắc — 7.200.000
2 — Giỏi — 6.000.000
3 — Khá — 5.000.000"""@vi .

# Điều 1 và Điều 2 kết thúc bằng "cụ thể như sau:" - con số nằm trong BẢNG đứng
# sau câu đó. Trước 15/8/2026 hai bảng này không được nạp, nên sáu mức học bổng
# dẫn nguồn về chính câu dẫn: công cụ trả ra "7.200.000 đồng" kèm một trích dẫn
# không hề chứa con số ấy. Nạp bảng theo khuôn đã chốt 11/8 (mỗi bảng là MỘT
# node, tra cả bảng) rồi trỏ các mức về bảng.
