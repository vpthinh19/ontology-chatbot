:StudentAffairsOffice a :OrganizationalUnit, owl:NamedIndividual ;
    :officeAddress "02 Nguyễn Đình Chiểu, phường Bắc Nha Trang, Khánh Hòa" ;
    :officeLocation "Khu Nhà Hiệu bộ"@vi ;
    :officePhone "0258 222 1900" ;
