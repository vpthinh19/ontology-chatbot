@prefix : <http://www.ntu.edu.vn/ontology/academic#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.ntu.edu.vn/ontology/academic> a owl:Ontology .

:AcademicLeaveProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình xin bảo lưu kết quả học tập"@vi ;
    :basedOnRegulation :Regulation1052 ;
    :condition "Bị ốm, thai sản hoặc tai nạn phải điều trị thời gian dài có giấy chứng nhận hợp lệ"@vi,
        "Vì lý do cá nhân khác nhưng phải học ít nhất 01 học kỳ ở Trường"@vi,
        "Được cơ quan có thẩm quyền điều động tham dự các kỳ thi, giải đấu quốc tế"@vi,
        "Được điều động vào lực lượng vũ trang"@vi ;
    :content """1. Sinh viên được xin nghỉ học tạm thời và bảo lưu kết quả đã học trong các trường hợp: Được điều động vào lực lượng vũ trang, đại diện quốc gia tham dự kỳ thi, bị ốm/thai sản/tai nạn hoặc vì lý do cá nhân khác.
2. Sinh viên xin nghỉ học tạm thời phải viết đơn xin thôi học gửi Hiệu trưởng thông qua Phòng Công tác sinh viên.
3. Khi muốn trở lại học tiếp, cần viết đơn gửi Hiệu trưởng thông qua Phòng Công tác sinh viên ít nhất 02 tuần trước khi bắt đầu học kỳ mới."""@vi ;
    :handledBy :StudentAffairsOffice ;
    :hasDocument :AcademicLeaveRequestForm,
        :StudyResumptionRequestForm ;
    :outcome "Kết quả học tập được bảo lưu"@vi ;
    skos:altLabel "bảo lưu"@vi .

:CourseRegistrationProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình đăng ký học phần"@vi ;
    :basedOnRegulation :Regulation1052 ;
    :content """Sinh viên học lực Trung bình trở lên đăng ký từ 15 đến 27 tín chỉ.
Sinh viên học lực Yếu/Kém đăng ký từ 12 đến 18 tín chỉ."""@vi ;
    :handledBy :UndergraduateEducationOffice ;
    :outcome "Học phần hiển thị trong thời khóa biểu chính thức"@vi ;
    skos:altLabel "ĐKMH"@vi,
        "đăng ký môn"@vi,
        "đăng ký tín chỉ"@vi .

:CourseRetakeProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình đăng ký học lại"@vi ;
    :basedOnRegulation :Regulation729 ;
    :condition "Học phần có điểm tổng kết dưới 5.0"@vi ;
    :content "Sinh viên có học phần bị điểm dưới 5.0 phải đăng ký học lại ở các học kỳ tiếp theo cho đến khi đạt."@vi ;
    :handledBy :UndergraduateEducationOffice ;
    skos:altLabel "học lại"@vi,
        "nợ môn"@vi,
        "rớt môn"@vi,
        "trượt môn"@vi .

:CourseWithdrawalProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình rút môn học"@vi ;
    :basedOnRegulation :Regulation1052 ;
    :content "Nhà trường tự động xóa lớp học phần nếu không đủ sinh viên theo quy định. Sinh viên có thể chủ động điều chỉnh hoặc rút bớt học phần trên web sinhvien.ntu.edu.vn"@vi ;
    :handledBy :UndergraduateEducationOffice ;
    :outcome "Xóa tên khỏi danh sách lớp, không bị ghi nhận điểm F"@vi ;
    skos:altLabel "bỏ học phần"@vi,
        "hủy môn"@vi,
        "rút môn"@vi .

:GradeImprovementProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình học cải thiện"@vi ;
    :basedOnRegulation :Regulation1052 ;
    :content """Sinh viên được quyền đăng ký học lại để cải thiện điểm trung bình chung tích lũy (CPA) trên web sinhvien.ntu.edu.vn với cùng mã học phần.
Kết quả học tập được ghi nhận cho lần học cùng học phần có điểm cao hơn."""@vi ;
    :handledBy :UndergraduateEducationOffice ;
    :outcome "Điểm CPA được ghi nhận theo lần học có điểm số cao hơn"@vi ;
    skos:altLabel "cải thiện CPA"@vi,
        "cải thiện GPA"@vi,
        "học cải thiện"@vi,
        "nâng điểm"@vi .

:GraduationReviewProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình xét tốt nghiệp"@vi ;
    :basedOnRegulation :Regulation1052 ;
    :condition "Hoàn thành học phần Giáo dục quốc phòng và an ninh"@vi,
        "Hoàn thành học phần Giáo dục thể chất"@vi,
        "Hoàn thành nghĩa vụ đối với Trường"@vi,
        "Không bị truy cứu trách nhiệm hình sự và không bị kỷ luật"@vi,
        "Tích lũy đủ số tín chỉ theo quy định"@vi,
        "Điểm trung bình chung tích lũy (CPA) từ 5.5 trở lên"@vi,
        "Đạt chuẩn năng lực tiếng Anh theo quy định"@vi ;
    :content """Sinh viên được xét tốt nghiệp khi hoàn thành nghĩa vụ đối với Trường; không bị truy cứu trách nhiệm hình sự và không bị kỷ luật; tích lũy đủ số tín chỉ; CPA từ 5.5 trở lên; đạt chuẩn năng lực tiếng Anh; hoàn thành Giáo dục quốc phòng và an ninh, Giáo dục thể chất.
Nếu đủ điều kiện sớm, sinh viên có thể làm đơn đề nghị xét tốt nghiệp."""@vi ;
    :handledBy :UndergraduateEducationOffice ;
    :hasDocument :EarlyGraduationRequestForm ;
    :outcome "Được xét tốt nghiệp nếu đủ điều kiện"@vi ;
    skos:altLabel "tốt nghiệp"@vi,
        "tốt nghiệp sớm"@vi,
        "xét tốt nghiệp"@vi .

:MajorChangeProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình xin chuyển ngành"@vi ;
    :basedOnRegulation :Regulation1052 ;
    :condition "Không là sinh viên năm nhất hoặc năm cuối"@vi ;
    :content """1. Sinh viên có nguyện vọng có thể được xem xét chuyển ngành trong cùng bậc học nếu không là sinh viên năm nhất hoặc năm cuối và đạt điều kiện trúng tuyển.
2. Ít nhất 02 tuần trước khi bắt đầu học kỳ mới, sinh viên nộp đơn xin chuyển ngành tại Phòng Công tác Chính trị và Sinh viên. Phòng Đào tạo Đại học xử lý hồ sơ và trình Hiệu trưởng xem xét quyết định."""@vi ;
    :handledBy :UndergraduateEducationOffice ;
    :hasDocument :MajorChangeRequestForm ;
    :outcome "Được chuyển ngành"@vi ;
    :receivedBy :StudentAffairsOffice ;
    skos:altLabel "chuyển ngành"@vi,
        "đổi ngành"@vi .

:ScholarshipReviewProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình xét học bổng"@vi ;
    :basedOnRegulation :Regulation1052 ;
    :condition "Không bị kỷ luật từ mức khiển trách trở lên"@vi,
        "Kết quả học tập từ 7.0 trở lên"@vi,
        "Trong thời gian đào tạo theo kế hoạch của khoá học"@vi,
        "Tổng số tín chỉ sinh viên đăng kí trong một học kì phải lớn hơn hoặc bằng 14 tín chỉ"@vi,
        "Điểm rèn luyện từ loại khá trở lên"@vi ;
    :content """Trong học kì, sinh viên có kết quả học tập, rèn luyện từ loại khá trở lên, không bị kỉ luật từ mức khiển trách trở lên sẽ được xét cấp HBKK học tập.
Tổng số tín chỉ sinh viên đăng kí phải >= 14. Học bổng sẽ được trao cho sinh viên theo thứ tự từ sinh viên có điểm học tập cao nhất lấy xuống đến khi đủ chỉ tiêu học bổng."""@vi ;
    :handledBy :StudentAffairsOffice ;
    :outcome "Được đưa vào danh sách xét học bổng; học bổng được cấp theo thứ tự kết quả học tập cho đến khi hết chỉ tiêu"@vi ;
    skos:altLabel "học bổng"@vi,
        "xét học bổng"@vi .

:TuitionPaymentProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Quy trình đóng học phí"@vi ;
    :appliesTuitionRate :GeneralEducationTuitionRate,
        :K63TuitionBand1,
        :K63TuitionBand2,
        :K65TuitionBand1,
        :K65TuitionBand2,
        :K66TuitionBand1,
        :K66TuitionBand2,
        :K66TuitionBand3,
        :K67TuitionBand1,
        :K67TuitionBand2 ;
    :basedOnRegulation :Regulation729 ;
    :content "Sinh viên thanh toán học phí cho các học phần đã đăng ký thành công trong học kỳ."@vi ;
    :handledBy :PlanningAndFinanceOffice ;
    :hasDocument :TuitionPaymentExtensionForm ;
    :supportsPaymentMethod :BankCounterPayment,
        :OnlinePayment ;
    :tuitionNote """Tuyệt đối không chuyển khoản trực tiếp vào tài khoản trường.
Thanh toán qua website sinhvien.ntu.edu.vn hoặc nộp trực tiếp tại quầy ngân hàng Agribank hoặc Vietinbank kèm mã số sinh viên.
Đóng học phí trễ hạn sẽ bị cấm thi. Sinh viên có hoàn cảnh khó khăn muốn gia hạn thời gian đóng học phí thì có thể liên hệ phòng Công tác Sinh viên để được hướng dẫn"""@vi ;
    skos:altLabel "học phí"@vi,
        "nộp học phí"@vi,
        "đóng học phí"@vi,
        "đóng tiền học"@vi .

:UniversityOffice a :AdministrativeOffice,
        owl:NamedIndividual ;
    rdfs:label "Văn phòng Trường"@vi ;
    :email "vpt@ntu.edu.vn"^^xsd:string ;
    :headName "Ths. Phạm Ngọc Bích"^^xsd:string ;
    :location "Tầng 2 Tòa nhà Hiệu bộ"@vi ;
    :phoneNumber "02583831149"^^xsd:string ;
    :websiteUrl "https://vpt.ntu.edu.vn/"^^xsd:anyURI ;
    skos:altLabel "VPT"@vi,
        "Văn phòng"@vi .

:appliesTuitionRate a owl:ObjectProperty ;
    rdfs:label "áp dụng mức học phí"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range :TuitionRate ;
    skos:altLabel "mức học phí"@vi .

:basedOnRegulation a owl:ObjectProperty ;
    rdfs:label "căn cứ quy định"@vi ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AcademicProcedure :TuitionRate ) ] ;
    rdfs:range :Regulation ;
    skos:altLabel "căn cứ"@vi,
        "quy định"@vi .

:cohortCode a owl:DatatypeProperty ;
    rdfs:label "mã khóa"@vi ;
    rdfs:domain :TuitionRate ;
    rdfs:range xsd:string .

:condition a owl:DatatypeProperty ;
    rdfs:label "điều kiện"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range rdf:langString ;
    skos:altLabel "yêu cầu"@vi .

:content a owl:DatatypeProperty ;
    rdfs:label "nội dung"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range rdf:langString ;
    skos:altLabel "mô tả"@vi .

:documentUrl a owl:DatatypeProperty ;
    rdfs:label "đường dẫn tài liệu"@vi ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :FormDocument :Regulation ) ] ;
    rdfs:range xsd:anyURI ;
    skos:altLabel "link"@vi,
        "đường dẫn"@vi .

:email a owl:DatatypeProperty ;
    rdfs:label "email"@vi ;
    rdfs:domain :AdministrativeOffice ;
    rdfs:range xsd:string ;
    skos:altLabel "thư điện tử"@vi .

:handledBy a owl:ObjectProperty ;
    rdfs:label "được xử lý bởi"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range :AdministrativeOffice ;
    skos:altLabel "phòng phụ trách"@vi,
        "phòng xử lý"@vi .

:hasDocument a owl:ObjectProperty ;
    rdfs:label "yêu cầu tài liệu"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range :FormDocument ;
    skos:altLabel "biểu mẫu"@vi,
        "tài liệu"@vi .

:headName a owl:DatatypeProperty ;
    rdfs:label "trưởng phòng"@vi ;
    rdfs:domain :AdministrativeOffice ;
    rdfs:range xsd:string .

:location a owl:DatatypeProperty ;
    rdfs:label "địa điểm"@vi ;
    rdfs:domain :AdministrativeOffice ;
    rdfs:range rdf:langString ;
    skos:altLabel "địa chỉ"@vi .

:outcome a owl:DatatypeProperty ;
    rdfs:label "kết quả"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range rdf:langString ;
    skos:altLabel "đầu ra"@vi .

:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "số điện thoại"@vi ;
    rdfs:domain :AdministrativeOffice ;
    rdfs:range xsd:string ;
    skos:altLabel "điện thoại"@vi .

:programName a owl:DatatypeProperty ;
    rdfs:label "ngành, chương trình áp dụng"@vi ;
    rdfs:domain :TuitionRate ;
    rdfs:range rdf:langString .

:receivedBy a owl:ObjectProperty ;
    rdfs:label "được tiếp nhận bởi"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range :AdministrativeOffice ;
    skos:altLabel "nơi nhận hồ sơ"@vi,
        "phòng tiếp nhận"@vi .

:supportsPaymentMethod a owl:ObjectProperty ;
    rdfs:label "hỗ trợ phương thức thanh toán"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range :PaymentMethod ;
    skos:altLabel "phương thức thanh toán"@vi,
        "thanh toán"@vi .

:tuitionNote a owl:DatatypeProperty ;
    rdfs:label "ghi chú học phí"@vi ;
    rdfs:domain :AcademicProcedure ;
    rdfs:range rdf:langString ;
    skos:altLabel "ghi chú"@vi,
        "lưu ý"@vi .

:tuitionPerCredit a owl:DatatypeProperty ;
    rdfs:label "học phí mỗi tín chỉ"@vi ;
    rdfs:domain :TuitionRate ;
    rdfs:range xsd:nonNegativeInteger ;
    skos:altLabel "mỗi tín chỉ"@vi .

:websiteUrl a owl:DatatypeProperty ;
    rdfs:label "website"@vi ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :AdministrativeOffice :PaymentMethod ) ] ;
    rdfs:range xsd:anyURI ;
    skos:altLabel "trang web"@vi .

