    :performedBy :Student ;
    :stepOrder 1 ;
    :stepText "Viết đơn theo Mẫu số 07 (Phụ lục 4), kèm minh chứng hợp lệ."@vi ;
    :usesForm :Form07ExemptionAndBonus .

:CourseExemptionStep02 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Miễn học miễn thi - bước 2"@vi ;
    :basedOn :Decision1052Article21Clause06 ;
    :performedBy :Student ;
    :stepOrder 2 ;
    :stepText "Gửi hồ sơ về Phòng Đào tạo Đại học để được xem xét giải quyết."@vi ;
    :submittedTo :AcademicManagementUnit .

:CourseRegistrationRequirement01 a :Requirement,
        owl:NamedIndividual ;
    rdfs:label "Giới hạn tín chỉ - học lực trung bình trở lên"@vi ;
    :basedOn :Decision1052Article09Clause03 ;
    :requirementOrder 1 ;
    :requirementText "Sinh viên xếp loại học lực trung bình trở lên đăng ký tối thiểu 15 tín chỉ và tối đa 27 tín chỉ với chương trình 4 năm, tối đa 32 tín chỉ với chương trình 4,5 năm và chương trình đặc biệt."@vi .

:CourseRegistrationRequirement02 a :Requirement,
        owl:NamedIndividual ;
    rdfs:label "Giới hạn tín chỉ - học lực yếu kém"@vi ;
    :basedOn :Decision1052Article09Clause04 ;
    :requirementOrder 2 ;
    :requirementText "Sinh viên xếp loại học lực yếu kém của học kỳ liền trước đăng ký tối thiểu 12 tín chỉ và tối đa 18 tín chỉ."@vi .

:CourseRegistrationStep01 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Đăng ký học phần - bước 1"@vi ;
    :basedOn :Decision1052Article09Clause02Point01 ;
    :performedBy :Student ;
    :stepOrder 1 ;
    :stepText "Tìm hiểu chương trình đào tạo, kế hoạch giảng dạy trong học kỳ và kiểm tra lại kết quả học tập để lập kế hoạch học tập phù hợp."@vi .

:CourseRegistrationStep02 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Đăng ký học phần - bước 2"@vi ;
    :basedOn :Decision1052Article09Clause02Point02 ;
    :performedBy :Student ;
    :stepOrder 2 ;
    :stepText "Đăng ký lớp của các học phần dự định học trong học kỳ, gồm học phần mới, học phần chưa đạt để học lại và học phần đã đạt để cải thiện điểm."@vi .

:CourseRegistrationStep03 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Đăng ký học phần - bước 3"@vi ;
    :basedOn :Decision1052Article09Clause02Point03 ;
    :performedBy :Student ;
    :stepOrder 3 ;
    :stepText "Xin ý kiến tư vấn của Cố vấn học tập trước khi đăng ký các lớp học phần."@vi ;
    :submittedTo :FacultyOrInstitute .

:CourseRegistrationStep04 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Đăng ký học phần - bước 4"@vi ;
    :basedOn :Decision1052Article09Clause02Point04 ;
    :performedBy :Student ;
    :stepOrder 4 ;
    :stepText "Xác nhận đăng ký học phần theo thời gian quy định từ tài khoản cá nhân trên Hệ thống quản lý đào tạo."@vi .

:CourseRetakeOutcome a :Outcome,
        owl:NamedIndividual ;
    rdfs:label "Kết quả ghi nhận khi học lại"@vi ;
    :basedOn :Decision1052Article11Clause04 ;
    :outcomeText "Kết quả học tập tích lũy được ghi nhận cho lần học cùng học phần có điểm cao hơn."@vi .

:CourseRetakeRequirement01 a :Requirement,
        owl:NamedIndividual ;
    rdfs:label "Điều kiện phải học lại"@vi ;
    :basedOn :Decision1052Article11Clause01 ;
    :requirementOrder 1 ;
    :requirementText "Học phần bắt buộc có điểm dưới 5,0 phải đăng ký học lại cho đến khi đạt từ 5,0 trở lên; học phần tự chọn dưới 5,0 được học lại hoặc đổi sang học phần tự chọn tương đương khác."@vi .

:CourseRetakeStep01 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Học lại - bước 1"@vi ;
    :basedOn :Decision1052Article11Clause01 ;
    :performedBy :Student ;
    :stepOrder 1 ;
    :stepText "Đăng ký học lại học phần đó ở các học kỳ tiếp theo theo quy trình đăng ký khối lượng học tập."@vi .

:CreditRecognitionOutcome a :Outcome,
        owl:NamedIndividual ;
    rdfs:label "Kết quả công nhận tín chỉ"@vi ;
    :basedOn :Decision1052Article21Clause03 ;
    :outcomeText "Kết quả được công nhận và chuyển đổi theo từng học phần, theo từng nhóm học phần, hoặc theo cả chương trình đào tạo."@vi .

:CreditRecognitionProcedure a :AcademicProcedure,
        owl:NamedIndividual ;
    rdfs:label "Thủ tục công nhận kết quả học tập và chuyển đổi tín chỉ"@vi ;
    :basedOn :Decision1052Article21 ;
    :decidedBy :UniversityPresident ;
    :hasOutcome :CreditRecognitionOutcome ;
    :hasRequirement :CreditRecognitionRequirement01,
        :CreditRecognitionRequirement02 ;
    :hasStep :CreditRecognitionStep01,
        :CreditRecognitionStep02 ;
    :requiresForm :Form06CreditRecognition ;
    :reviewedBy :ProfessionalCouncil ;
    :submittedTo :AcademicManagementUnit ;
    :summaryText "Thủ tục đề nghị công nhận kết quả đã tích lũy ở nơi khác và chuyển đổi sang tín chỉ của chương trình đang học."@vi ;
    skos:altLabel "chuyển đổi tín chỉ"@vi,
        "công nhận kết quả học tập"@vi,
        "công nhận tín chỉ"@vi,
        "miễn học và quy đổi điểm"@vi,
        "quy đổi điểm học phần"@vi .

:CreditRecognitionRequirement01 a :Requirement,
        owl:NamedIndividual ;
    rdfs:label "Giới hạn khối lượng được công nhận"@vi ;
    :basedOn :Decision1052Article21Clause04 ;
    :requirementOrder 1 ;
    :requirementText "Khối lượng được công nhận và chuyển đổi không vượt quá 50% khối lượng học tập tối thiểu của chương trình đào tạo."@vi .

:CreditRecognitionRequirement02 a :Requirement,
        owl:NamedIndividual ;
    rdfs:label "Giới hạn thời gian tích lũy"@vi ;
    :basedOn :Decision1052Article21Clause07 ;
    :requirementOrder 2 ;
    :requirementText "Chỉ công nhận học phần được tích lũy trong vòng 5 năm tính đến ngày xem xét."@vi .

:CreditRecognitionStep01 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Công nhận tín chỉ - bước 1"@vi ;
    :basedOn :Decision1052Article21Clause02 ;
    :performedBy :Student ;
    :stepOrder 1 ;
    :stepText "Chuẩn bị bản sao có công chứng văn bằng, chứng chỉ và bảng điểm, kèm đơn theo Mẫu số 06 (Phụ lục 4)."@vi ;
    :usesForm :Form06CreditRecognition .

:CreditRecognitionStep02 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Công nhận tín chỉ - bước 2"@vi ;
    :basedOn :Decision1052Article21Clause02 ;
    :performedBy :Student ;
    :stepOrder 2 ;
    :stepText "Nộp hồ sơ cho Phòng Đào tạo Đại học để Hội đồng chuyên môn xem xét công nhận và chuyển đổi."@vi ;
    :submittedTo :AcademicManagementUnit .

:Decision1052Appendix01 a :Appendix,
        owl:NamedIndividual ;
    rdfs:label "Phụ lục 1. Điều kiện, số lượng sinh viên để tổ chức một lớp học phần"@vi ;
    :appendixNumber 1 ;
    :citationLabel "Phụ lục 1 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :inDocument :Decision1052 ;
    :officialText """Tối thiểu — Tối đa
1 — Giáo dục tổng quát — 50 — 100
2 — Lý luận chính trị — 80
3 — - Ngoại ngữ B1.1, B1.2; / - HP chuyên ngữ ngành Ngôn ngữ Anh; — 40 — 50
4 — - Tiếng anh chuyên ngành — 50 — 60
5 — Khối kiến thức cơ sở, kiến thức ngành của Khoa Du lịch, Kinh tế, Kế toán – Tài chính và Luật — 50 — 80
6 — Khối kỹ thuật, công nghệ — 30 — 70
7 — Giáo dục thể chất — 60 — 80 (LT)
45 — 60 (TH)
8 — Giáo dục Quốc phòng – An ninh — 70
45 — 70 (TH)
9 — Thực hành tại phòng máy CNC và công nghệ cao — 10 — 15
10 — Thực hành tại Xưởng Cơ khí, phòng thí nghiệm Nhiệt lạnh — 15 — 20
11 — Thực hành tại các phòng máy tính — 25 — 30
12 — Thực hành các học phần khác — 20 — 25"""@vi .

:Decision1052Article09Clause02Point01 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 9 khoản 2 điểm a"@vi ;
    :articleNumber 9 ;
    :citationLabel "điểm a khoản 2 Điều 9 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Tìm hiểu các thông tin chi tiết về chương trình đào tạo, kế hoạch giảng dạy trong học kỳ, kiểm tra lại kết quả quá trình học tập và các thông tin liên quan khác để lập kế hoạch học tập phù hợp cho bản thân."@vi ;
    :partOf :Decision1052Article09Clause02 ;
    :pointLetter "a" .

:Decision1052Article09Clause02Point02 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 9 khoản 2 điểm b"@vi ;
    :articleNumber 9 ;
    :citationLabel "điểm b khoản 2 Điều 9 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Đăng ký lớp của các học phần dự định sẽ học trong học kỳ, gồm: những học phần mới, một số học phần chưa đạt (để học lại) và một số học phần đã đạt (để cải thiện điểm nếu có) căn cứ danh sách học phần được mở và điều kiện đăng ký của mỗi học phần."@vi ;
    :partOf :Decision1052Article09Clause02 ;
    :pointLetter "b" .

:Decision1052Article09Clause02Point03 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 9 khoản 2 điểm c"@vi ;
    :articleNumber 9 ;
    :citationLabel "điểm c khoản 2 Điều 9 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Xin ý kiến tư vấn của Cố vấn học tập và đăng ký học các lớp học phần tổ chức trong học kỳ tùy theo khả năng và tiến độ học tập của SV."@vi ;
    :partOf :Decision1052Article09Clause02 ;
    :pointLetter "c" .

:Decision1052Article09Clause02Point04 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 9 khoản 2 điểm d"@vi ;
    :articleNumber 9 ;
    :citationLabel "điểm d khoản 2 Điều 9 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Xác nhận đăng ký học phần theo thời gian quy định từ tài khoản cá nhân trên Hệ thống quản lý đào tạo."@vi ;
    :partOf :Decision1052Article09Clause02 ;
    :pointLetter "d" .

:Decision1052Article09Clause03 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 9 khoản 3"@vi ;
    :articleNumber 9 ;
    :citationLabel "khoản 3 Điều 9 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 3 ;
    :inDocument :Decision1052 ;
    :officialText "Khối lượng học tập của mỗi SV xếp loại học lực trung bình trở lên của học kỳ liền trước được đăng ký trong một học kỳ (trừ học kỳ cuối khóa và các học kỳ phụ) tối thiểu 15 tín chỉ và tối đa 27 tín chỉ đối với chương trình đào tạo 4 năm, 32 tín chỉ đối với các chương trình đào tạo 4,5 năm và chương trình đặc biệt theo đặt hàng của doanh nghiệp (không tính tín chỉ của các học phần Giáo dục thể chất, Giáo dục Quốc phòng – An ninh)."@vi ;
    :partOf :Decision1052Article09 .

:Decision1052Article09Clause04 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 9 khoản 4"@vi ;
    :articleNumber 9 ;
    :citationLabel "khoản 4 Điều 9 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 4 ;
    :inDocument :Decision1052 ;
    :officialText "Khối lượng học tập của SV xếp loại học lực hạng yếu kém của học kỳ liền trước được đăng ký trong một học kỳ (trừ học kỳ cuối khóa và các học kỳ phụ) tối thiểu 12 tín chỉ và tối đa 18 tín chỉ ."@vi ;
    :partOf :Decision1052Article09 .

:Decision1052Article13Clause03 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 13 khoản 3"@vi ;
    :articleNumber 13 ;
    :citationLabel "khoản 3 Điều 13 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 3 ;
    :inDocument :Decision1052 ;
    :officialText "Các hình thức đào tạo trực tuyến"@vi ;
    :partOf :Decision1052Article13 .

:Decision1052Article14Clause01 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 14 khoản 1"@vi ;
    :articleNumber 14 ;
    :citationLabel "khoản 1 Điều 14 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Sinh viên được xếp hạng năm thứ 4 phải thực hiện đồ án/khóa luận tốt nghiệp (ĐATN) hoặc các chuyên đề tốt nghiệp (CĐTN) để hoàn thành khóa học."@vi ;
    :partOf :Decision1052Article14 .

:Decision1052Article14Clause03 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 14 khoản 3"@vi ;
    :articleNumber 14 ;
    :citationLabel "khoản 3 Điều 14 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 3 ;
    :inDocument :Decision1052 ;
    :officialText "SV không đủ điều kiện thực hiện ĐATN phải làm các CĐTN. Ở một số ngành đào tạo, SV không đủ điều kiện thực hiện ĐATN được phép học các học phần tốt nghiệp (HPTN) hoặc thực hiện CĐTN kết hợp học một số HPTN theo quy định của CTĐT."@vi ;
    :partOf :Decision1052Article14 .

:Decision1052Article17Clause01Point01 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 17 khoản 1 điểm a"@vi ;
    :articleNumber 17 ;
    :citationLabel "điểm a khoản 1 Điều 17 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Đối với học phần lý thuyết:"@vi ;
    :partOf :Decision1052Article17Clause01 ;
    :pointLetter "a" .

:Decision1052Article17Clause04 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 17 khoản 4"@vi ;
    :articleNumber 17 ;
    :citationLabel "khoản 4 Điều 17 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 4 ;
    :inDocument :Decision1052 ;
    :officialText "Sinh viên đủ điều kiện dự thi nhưng không thể dự thi cuối kỳ do bị ốm, tai nạn hoặc vì lý do đặc biệt khác được phép hoãn thi và được dự thi cuối kỳ học phần đó trong thời hạn 2 học kỳ chính tiếp theo để hoàn thành điểm, quá thời hạn trên điểm đánh giá cuối kỳ sẽ là điểm 0 (không). Sinh viên làm đơn xin hoãn thi theo mẫu (Mẫu số 04 – Phụ lục 4 kèm theo) gửi về Đơn vị quản lý đào tạo để được giải quyết."@vi ;
    :partOf :Decision1052Article17 .

:Decision1052Article18Clause02 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 18 khoản 2"@vi ;
    :articleNumber 18 ;
    :citationLabel "khoản 2 Điều 18 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Sinh viên được xếp loại học lực theo điểm trung bình chung học kỳ, điểm trung bình chung năm học hoặc điểm trung bình chung tích lũy như sau:"@vi ;
    :partOf :Decision1052Article18 .

:Decision1052Article19Clause01 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 19 khoản 1"@vi ;
    :articleNumber 19 ;
    :citationLabel "khoản 1 Điều 19 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Sinh viên được xếp hạng trình độ năm học căn cứ vào tổng số tín chỉ tích lũy được từ đầu khóa học và số tín chỉ trung bình một năm học theo kế hoạch học tập chuẩn. Sau mỗi học kỳ, căn cứ vào khối lượng tín chỉ tích lũy tính từ đầu khóa học, SV được xếp năm đào tạo như sau:"@vi ;
    :partOf :Decision1052Article19 .

:Decision1052Article21Clause04 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 21 khoản 4"@vi ;
    :articleNumber 21 ;
    :citationLabel "khoản 4 Điều 21 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 4 ;
    :inDocument :Decision1052 ;
    :officialText "Nhà trường công khai quy định việc công nhận kết quả học tập và chuyển đổi tín chỉ. Khối lượng tối đa được công nhận kết quả học tập (điểm R – được quy định chi tiết tại Điều 16), chuyển đổi không vượt quá 50% khối lượng học tập tối thiểu của CTĐT."@vi ;
    :partOf :Decision1052Article21 .

:Decision1052Article21Clause07 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 21 khoản 7"@vi ;
    :articleNumber 21 ;
    :citationLabel "khoản 7 Điều 21 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 7 ;
    :inDocument :Decision1052 ;
    :officialText "Nhà trường chỉ cho phép công nhận kết quả học tập, miễn học, miễn thi và điểm thưởng, chuyển đổi tín chỉ của học phần được tích lũy trong vòng 5 năm tính đến ngày xem xét."@vi ;
    :partOf :Decision1052Article21 .

:Decision1052Article22Clause01Point01 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 1 điểm a"@vi ;
    :articleNumber 22 ;
    :citationLabel "điểm a khoản 1 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Cho đến thời điểm xét tốt nghiệp không bị truy cứu trách nhiệm hình sự hoặc không đang trong thời gian bị kỷ luật ở mức đình chỉ học tập."@vi ;
    :partOf :Decision1052Article22Clause01 ;
    :pointLetter "a" .

:Decision1052Article22Clause01Point02 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 1 điểm b"@vi ;
    :articleNumber 22 ;
    :citationLabel "điểm b khoản 1 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Tích lũy đủ số học phần, khối lượng học tập của CTĐT được quy định tại Điều 2 của Quy chế này, đạt chuẩn đầu ra và các nội dung bắt buộc khác theo yêu cầu của chương trình đào tạo."@vi ;
    :partOf :Decision1052Article22Clause01 ;
    :pointLetter "b" .

:Decision1052Article22Clause01Point03 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 1 điểm c"@vi ;
    :articleNumber 22 ;
    :citationLabel "điểm c khoản 1 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Điểm trung bình chung tích lũy theo CTĐT của toàn khóa học phải đạt từ 5,50 trở lên."@vi ;
    :partOf :Decision1052Article22Clause01 ;
    :pointLetter "c" .

:Decision1052Article22Clause01Point04 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 1 điểm d"@vi ;
    :articleNumber 22 ;
    :citationLabel "điểm d khoản 1 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Đạt năng lực ngoại ngữ theo quy định đối với mỗi khóa đào tạo."@vi ;
    :partOf :Decision1052Article22Clause01 ;
    :pointLetter "d" .

:Decision1052Article22Clause01Point05 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 1 điểm đ"@vi ;
    :articleNumber 22 ;
    :citationLabel "điểm đ khoản 1 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Hoàn thành các học phần Giáo dục quốc phòng – An ninh và Giáo dục thể chất và các học phần điều kiện khác (nếu có)."@vi ;
    :partOf :Decision1052Article22Clause01 ;
    :pointLetter "đ" .

:Decision1052Article22Clause01Point06 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 1 điểm e"@vi ;
    :articleNumber 22 ;
    :citationLabel "điểm e khoản 1 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Hoàn thành các nghĩa vụ khác theo quy định của Trường như mượn sách thư viện, thủ tục quyết toán đề tài Nghiên cứu khoa học, học phí và các thủ tục khác."@vi ;
    :partOf :Decision1052Article22Clause01 ;
    :pointLetter "e" .

:Decision1052Article22Clause03 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 3"@vi ;
    :articleNumber 22 ;
    :citationLabel "khoản 3 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 3 ;
    :inDocument :Decision1052 ;
    :officialText "Sau mỗi quý, Hội đồng xét tốt nghiệp căn cứ các điều kiện công nhận tốt nghiệp quy định tại khoản 1 Điều này để lập danh sách những SV đủ điều kiện tốt nghiệp. Hội đồng xét tốt nghiệp Trường do Hiệu trưởng hoặc Phó Hiệu trưởng được Hiệu trưởng uỷ quyền làm chủ tịch, Trưởng đơn vị quản lý đào tạo làm thư ký và các thành viên là các Trưởng Khoa/viện, Trưởng Phòng Công tác Chính trị và Sinh viên."@vi ;
    :partOf :Decision1052Article22 .

:Decision1052Article22Clause04 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 22 khoản 4"@vi ;
    :articleNumber 22 ;
    :citationLabel "khoản 4 Điều 22 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 4 ;
    :inDocument :Decision1052 ;
    :officialText "Căn cứ đề nghị của Hội đồng xét tốt nghiệp, các đơn vị liên quan có trách nhiệm thẩm định theo quy trình xét và công nhận SV tốt nghiệp, trình Hiệu trưởng ký quyết định công nhận tốt nghiệp và cấp bằng cho SV đủ điều kiện tốt nghiệp."@vi ;
    :partOf :Decision1052Article22 .

:Decision1052Article23Clause02 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 23 khoản 2"@vi ;
    :articleNumber 23 ;
    :citationLabel "khoản 2 Điều 23 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Hạng tốt nghiệp được xác định theo điểm trung bình chung tích lũy của toàn khoá học theo các mức như sau:"@vi ;
    :partOf :Decision1052Article23 .

:Decision1052Article24Clause01Point03 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 24 khoản 1 điểm c"@vi ;
    :articleNumber 24 ;
    :citationLabel "điểm c khoản 1 Điều 24 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Bị ốm, thai sản hoặc tai nạn phải điều trị thời gian dài có giấy chứng nhận của cơ sở khám bệnh, chữa bệnh có thẩm quyền theo quy định của Bộ Y tế."@vi ;
    :partOf :Decision1052Article24Clause01 ;
    :pointLetter "c" .

:Decision1052Article25Clause01Point01 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 25 khoản 1 điểm a"@vi ;
    :articleNumber 25 ;
    :citationLabel "điểm a khoản 1 Điều 25 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Không đang là SV trình độ năm thứ nhất hoặc năm cuối khóa, không thuộc diện bị xem xét buộc thôi học và còn đủ thời gian học tập theo quy định tại khoản 4 Điều 2 của Quy chế này."@vi ;
    :partOf :Decision1052Article25Clause01 ;
    :pointLetter "a" .

:Decision1052Article25Clause01Point02 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 25 khoản 1 điểm b"@vi ;
    :articleNumber 25 ;
    :citationLabel "điểm b khoản 1 Điều 25 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Đạt điều kiện trúng tuyển của chương trình, ngành đào tạo của Trường trong cùng khóa tuyển sinh."@vi ;
    :partOf :Decision1052Article25Clause01 ;
    :pointLetter "b" .

:Decision1052Article25Clause01Point03 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 25 khoản 1 điểm c"@vi ;
    :articleNumber 25 ;
    :citationLabel "điểm c khoản 1 Điều 25 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Được sự đồng ý của Trưởng Khoa/viện của ngành đang học và ngành xin chuyển đến."@vi ;
    :partOf :Decision1052Article25Clause01 ;
    :pointLetter "c" .

:Decision1052Article25Clause01Point04 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 25 khoản 1 điểm d"@vi ;
    :articleNumber 25 ;
    :citationLabel "điểm d khoản 1 Điều 25 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Nhà trường có đủ các điều kiện bảo đảm chất lượng, chưa vượt quá năng lực đào tạo đối với ngành đào tạo xin chuyển đến theo quy định hiện hành của Bộ Giáo dục và Đào tạo."@vi ;
    :partOf :Decision1052Article25Clause01 ;
    :pointLetter "d" .

:Decision1052Article25Clause03 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 25 khoản 3"@vi ;
    :articleNumber 25 ;
    :citationLabel "khoản 3 Điều 25 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 3 ;
    :inDocument :Decision1052 ;
    :officialText "Khi được chấp thuận chuyển sang ngành mới, SV được bảo lưu điểm các học phần đã học có nội dung và khối lượng kiến thức tương đương. Sinh viên chuyển ngành không được gia hạn thời gian học tập tối đa theo quy định."@vi ;
    :partOf :Decision1052Article25 .

:Decision1052Article26Clause01Point01 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 26 khoản 1 điểm a"@vi ;
    :articleNumber 26 ;
    :citationLabel "điểm a khoản 1 Điều 26 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Không đang là SV trình độ năm thứ nhất hoặc năm cuối khóa, không thuộc diện bị xem xét buộc thôi học và còn đủ thời gian học tập theo quy định tại khoản 4 Điều 2 của Quy chế này."@vi ;
    :partOf :Decision1052Article26Clause01 ;
    :pointLetter "a" .

:Decision1052Article26Clause01Point02 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 26 khoản 1 điểm b"@vi ;
    :articleNumber 26 ;
    :citationLabel "điểm b khoản 1 Điều 26 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Sinh viên đạt điều kiện trúng tuyển của chương trình, ngành đào tạo cùng khóa tuyển sinh tại Trường xin chuyển đến."@vi ;
    :partOf :Decision1052Article26Clause01 ;
    :pointLetter "b" .

:Decision1052Article26Clause01Point03 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 26 khoản 1 điểm c"@vi ;
    :articleNumber 26 ;
    :citationLabel "điểm c khoản 1 Điều 26 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Nơi chuyển đến có đủ các điều kiện bảo đảm chất lượng, chưa vượt quá năng lực đào tạo đối với chương trình, ngành đào tạo đó theo quy định hiện hành của Bộ Giáo dục và Đào tạo."@vi ;
    :partOf :Decision1052Article26Clause01 ;
    :pointLetter "c" .

:Decision1052Article26Clause01Point04 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 26 khoản 1 điểm d"@vi ;
    :articleNumber 26 ;
    :citationLabel "điểm d khoản 1 Điều 26 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Được sự đồng ý của Hiệu trưởng cơ sở đào tạo xin chuyển đi và cơ sở đào tạo xin chuyển đến."@vi ;
    :partOf :Decision1052Article26Clause01 ;
    :pointLetter "d" .

:Decision1052Article27Clause02 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 27 khoản 2"@vi ;
    :articleNumber 27 ;
    :citationLabel "khoản 2 Điều 27 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Sinh viên của Trường Đại học Nha Trang tham gia chương trình trao đổi SV có thể đăng ký học một số học phần tại Trường khác (và ngược lại) với số lượng tín chỉ tích lũy tại Trường khác (nếu có) không vượt quá 25% tổng khối lượng của chương trình đào tạo."@vi ;
    :partOf :Decision1052Article27 .

:Decision1052Article28Clause01Point01 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 28 khoản 1 điểm a"@vi ;
    :articleNumber 28 ;
    :citationLabel "điểm a khoản 1 Điều 28 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Sinh viên được đăng ký học chương trình thứ hai khi đã được xếp từ trình độ năm thứ hai trở lên của chương trình thứ nhất."@vi ;
    :partOf :Decision1052Article28Clause01 ;
    :pointLetter "a" .

:Decision1052Article28Clause01Point02 a :Point,
        owl:NamedIndividual ;
    rdfs:label "Điều 28 khoản 1 điểm b"@vi ;
    :articleNumber 28 ;
    :citationLabel "điểm b khoản 1 Điều 28 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Học lực tính theo điểm trung bình tích lũy xếp loại khá trở lên và đáp ứng ngưỡng bảo đảm chất lượng của chương trình thứ hai trong năm tuyển sinh; hoặc học lực tính theo điểm trung bình tích lũy xếp loại trung bình và đáp ứng điều kiện trúng tuyển của chương trình thứ hai trong năm tuyển sinh."@vi ;
    :partOf :Decision1052Article28Clause01 ;
    :pointLetter "b" .

:Decision1052Article28Clause02 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 28 khoản 2"@vi ;
    :articleNumber 28 ;
    :citationLabel "khoản 2 Điều 28 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 2 ;
    :inDocument :Decision1052 ;
    :officialText "Trong quá trình SV học cùng lúc hai chương trình, nếu điểm trung bình chung học kỳ của chương trình thứ nhất đạt dưới 5,50 thì phải dừng học chương trình thứ hai ở học kỳ tiếp theo. Sinh viên sẽ không được phép đăng ký học phần của chương trình thứ 2 cho đến khi nào kết quả học tập chương trình thứ nhất được cải thiện mới được học tiếp chương trình thứ hai."@vi ;
    :partOf :Decision1052Article28 .

:Decision1052Article28Clause05 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 28 khoản 5"@vi ;
    :articleNumber 28 ;
    :citationLabel "khoản 5 Điều 28 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 5 ;
    :inDocument :Decision1052 ;
    :officialText "Thời gian học tối đa được phép học đối với SV học cùng lúc hai chương trình là thời gian tối đa quy định cho chương trình thứ nhất được quy định tại khoản 4 Điều 2 của Quy chế này. Sinh viên chỉ được xét tốt nghiệp chương trình thứ hai khi đã đủ điều kiện tốt nghiệp ở chương trình thứ nhất và đăng kí muộn nhất 02 năm trước thời điểm xét tốt nghiệp chương trình thứ hai."@vi ;
    :partOf :Decision1052Article28 .

:Decision1052Article29Clause01 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 29 khoản 1"@vi ;
    :articleNumber 29 ;
    :citationLabel "khoản 1 Điều 29 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 1 ;
    :inDocument :Decision1052 ;
    :officialText "Người đã tốt nghiệp trình độ trung cấp, trình độ cao đẳng được xét tuyển và học liên thông lên trình độ đại học. Người đã tốt nghiệp đại học được xét tuyển và học liên thông để nhận thêm một bằng tốt nghiệp đại học của một ngành đào tạo khác."@vi ;
    :partOf :Decision1052Article29 .

:Decision1052Article29Clause03 a :Clause,
        owl:NamedIndividual ;
    rdfs:label "Điều 29 khoản 3"@vi ;
    :articleNumber 29 ;
    :citationLabel "khoản 3 Điều 29 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :clauseNumber 3 ;
    :inDocument :Decision1052 ;
    :officialText "Người học liên thông thực hiện CTĐT và đăng ký học tập theo kế hoạch chung như các SV khác cùng hình thức đào tạo. Sinh viên được xem xét miễn học và bảo lưu các học phần tương ứng với khối lượng học tập đã tích lũy theo quy định tại Điều 20 của Quy chế này."@vi ;
    :partOf :Decision1052Article29 .

:DismissalTransferOutcome a :Outcome,
        owl:NamedIndividual ;
    rdfs:label "Kết quả xin chuyển chương trình đào tạo"@vi ;
    :basedOn :Decision1052Article20Clause03 ;
    :outcomeText "Sinh viên được xem xét bảo lưu một phần kết quả học tập ở chương trình cũ đối với các học phần đạt từ 5,0 trở lên khi học ở chương trình mới."@vi .

:DismissalTransferRequirement01 a :Requirement,
        owl:NamedIndividual ;
    rdfs:label "Điều kiện xin chuyển chương trình đào tạo"@vi ;
    :basedOn :Decision1052Article20Clause03 ;
    :requirementOrder 1 ;
    :requirementText "Thuộc diện bị buộc thôi học theo khoản 2 Điều 20 và Trường có tổ chức chương trình đào tạo tương ứng theo hình thức vừa làm vừa học."@vi .

:DismissalTransferStep01 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Chuyển chương trình - bước 1"@vi ;
    :basedOn :Decision1052Article20Clause03 ;
    :performedBy :Student ;
    :stepOrder 1 ;
    :stepText "Viết đơn theo Mẫu số 05 (Phụ lục 4)."@vi ;
    :usesForm :Form05ProgramTransfer .

:DismissalTransferStep02 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Chuyển chương trình - bước 2"@vi ;
    :basedOn :Decision1052Article20Clause03 ;
    :performedBy :Student ;
    :stepOrder 2 ;
    :stepText "Gửi đơn tới Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên để được xem xét."@vi ;
    :submittedTo :StudentAffairsOffice .

:EarlyGraduationRequirement01 a :Requirement,
        owl:NamedIndividual ;
    rdfs:label "Điều kiện xét tốt nghiệp sớm"@vi ;
    :basedOn :Decision1052Article22Clause02 ;
    :requirementOrder 1 ;
    :requirementText "Đã đủ điều kiện tốt nghiệp sớm hơn thời gian thiết kế của khóa học."@vi .

:EarlyGraduationStep01 a :ProcedureStep,
        owl:NamedIndividual ;
    rdfs:label "Tốt nghiệp sớm - bước 1"@vi ;
    :basedOn :Decision1052Article22Clause02 ;
    :performedBy :Student ;
    :stepOrder 1 ;
    :stepText "Viết đơn đề nghị được xét tốt nghiệp theo Mẫu số 08 (Phụ lục 4)."@vi ;
    :usesForm :Form08EarlyGraduation .

