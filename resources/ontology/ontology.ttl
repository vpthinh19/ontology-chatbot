    :articleNumber "8"^^xsd:integer ;
    :clauseNumber "1"^^xsd:integer ;
    :pointLetter "a" .

:Regulation1052Article08Clause01PointB a :Point, owl:NamedIndividual ;
    rdfs:label "điểm b khoản 1 Điều 8 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm b khoản 1 Điều 8 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article08Clause01 ;
    :officialText "Sinh viên đã học hết thời gian theo kế hoạch học tập chuẩn toàn khóa học nhưng chưa tốt nghiệp thì chuyển sinh hoạt với lớp SV cùng ngành, chuyên ngành hoặc CTĐT ở khóa sau. Đối với hình thức đào tạo vừa làm vừa học, SV được chuyển sinh hoạt và học tập lớp khóa sau có cùng CTĐT tại cùng cơ sở (nếu có). Trường hợp tại cơ sở đó không tổ chức lớp tương ứng, sinh viên có thể được bố trí học tại cơ sở chính hoặc các cơ sở liên kết khác nếu có lớp học phù hợp."@vi ;
    :articleNumber "8"^^xsd:integer ;
    :clauseNumber "1"^^xsd:integer ;
    :pointLetter "b" .

:Regulation1052Article08Clause01PointC a :Point, owl:NamedIndividual ;
    rdfs:label "điểm c khoản 1 Điều 8 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm c khoản 1 Điều 8 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article08Clause01 ;
    :officialText "Đối với SV được phép nghỉ học tạm thời khi trở lại học tập được bố trí vào lớp SV phù hợp với khối lượng tín chỉ đã tích lũy nhưng giữ nguyên mã số SV đã có. Đối với hình thức đào tạo vừa làm vừa học, sinh viên được phép nghỉ học tạm thời khi trở lại học tập được bố trí vào lớp cùng CTĐT ở khóa sau tại cơ sở đang học (nếu có), hoặc được chuyển về cơ sở chính hoặc các cơ sở liên kết khác nếu có lớp tương ứng với khối lượng tín chỉ đã tích lũy, và giữ nguyên mã số sinh viên đã có."@vi ;
    :articleNumber "8"^^xsd:integer ;
    :clauseNumber "1"^^xsd:integer ;
    :pointLetter "c" .

:Regulation1052Article08Clause01PointD a :Point, owl:NamedIndividual ;
    rdfs:label "điểm d khoản 1 Điều 8 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm d khoản 1 Điều 8 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article08Clause01 ;
    :officialText "Đối với SV chuyển đổi ngành, chuyên ngành hoặc chương trình đào tạo, lớp SV sẽ được điều chỉnh tương ứng."@vi ;
    :articleNumber "8"^^xsd:integer ;
    :clauseNumber "1"^^xsd:integer ;
    :pointLetter "d" .

:Regulation1052Article08Clause01PointDD a :Point, owl:NamedIndividual ;
    rdfs:label "điểm đ khoản 1 Điều 8 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm đ khoản 1 Điều 8 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article08Clause01 ;
    :officialText "Đối với SV từ Trường khác đến sẽ được bố trí vào lớp SV phù hợp với khối lượng tín chỉ được Nhà trường bảo lưu."@vi ;
    :articleNumber "8"^^xsd:integer ;
    :clauseNumber "1"^^xsd:integer ;
    :pointLetter "đ" .

:Regulation1052Article08Clause01PointE a :Point, owl:NamedIndividual ;
    rdfs:label "điểm e khoản 1 Điều 8 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "điểm e khoản 1 Điều 8 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article08Clause01 ;
    :officialText "Đối với SV đăng ký học cùng lúc hai chương trình đào tạo, SV duy trì sinh hoạt tại lớp SV ngành thứ nhất."@vi ;
    :articleNumber "8"^^xsd:integer ;
    :clauseNumber "1"^^xsd:integer ;
    :pointLetter "e" .

:Regulation1052Article08Clause02 a :Clause, owl:NamedIndividual ;
    rdfs:label "khoản 2 Điều 8 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "khoản 2 Điều 8 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article08 ;
    :officialText """Lớp học phần:
a) Lớp học phần là lớp mà SV đăng ký theo học cùng học phần trong một học kỳ. Mỗi học phần có thể có nhiều lớp học phần với mã số nhóm khác nhau. Lớp học phần được áp dụng cho hình thức đào tạo chính quy.
b) Điều kiện, số lượng sinh viên để tổ chức một lớp học phần được quy định chi tiết tại Phụ lục 1.
c) Trường hợp số lượng SV đăng ký ít hơn số lượng tối thiểu theo quy định, Nhà trường sẽ xử lý như sau: - Đối với HP bắt buộc, SV phải học với khóa sau; - Đối với HP tự chọn, SV chọn lại HP khác trong số học phần tự chọn đủ điều kiện mở lớp hoặc đăng ký học với khóa sau. - Các trường hợp đặc thù hoặc có lý do chính đáng, nhóm sinh viên làm đơn xin mở lớp học phần để Hiệu trưởng xem xét và quyết định (thông qua Đơn vị quản lý đào tạo) (Mẫu số 01 - Phụ lục 4 kèm theo).
d) Trường hợp số lượng SV trong một lớp học phần lý thuyết vượt sức chứa của phòng học, hoặc vượt số lượng tối đa theo quy định, hoặc do các điều kiện khác Nhà trường sẽ tách lớp dựa trên điều kiện về GV và các điều kiện đảm bảo chất lượng khác.
e) Đối với các lớp học phần thực hành, học phần lý thuyết kết hợp thực hành: Đơn vị quản lý đào tạo có trách nhiệm tổ chức chia nhóm lớp theo số lượng SV đăng ký được quy định tại điểm b khoản 2 Điều này, cụ thể: - Nếu số SV còn lại từ một nửa định mức tối thiểu của một lớp học phần, thì Nhà trường mở thêm một lớp học phần mới. - Nếu số SV còn lại ít hơn một nửa định mức tối thiểu của một lớp học phần, thì Nhà trường sẽ bố trí SV vào các lớp học phần khác đã được tổ chức trước đó."""@vi ;
    :articleNumber "8"^^xsd:integer ;
    :clauseNumber "2"^^xsd:integer .

