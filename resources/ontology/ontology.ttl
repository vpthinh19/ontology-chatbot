:Decision1052Appendix02Table07 a :DocumentTable,
        owl:NamedIndividual ;
    rdfs:label "Bảng 7 - Phụ lục 2 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :citationLabel "bảng 7 Phụ lục 2 Quyết định 1052/QĐ-ĐHNT"@vi ;
    :inDocument :Decision1052 ;
    :officialText """TT — Chương trình — KNLNN / CEFR — TOEIC — IELTS — TOEFL iBT — Linguaskill — Aptis (General) — Cambridge English Scale
