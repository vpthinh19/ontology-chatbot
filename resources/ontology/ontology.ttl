# =====================================================================
# TẦNG TRI THỨC - khái niệm và quy tắc
# =====================================================================
#
# Phần này phủ những Điều mà bản trước bỏ trống hoàn toàn: Điều 2, 4, 5,
# 6, 7, 9, 13, 15, 16, 17, 20, 21, 23, 27, 31. Chúng phần lớn là ĐỊNH
# NGHĨA và QUY TẮC CÓ NGƯỠNG chứ không phải thủ tục, nên cần lớp riêng
# thay vì cố nhét vào AcademicProcedure.
#
# Mỗi quy tắc có :ruleText để trả lời thành câu, kèm trường số để so sánh
# được. Phân lớp cho phép hỏi theo nhóm mà không liệt kê tay từng IRI.



# ---------------------------------------------------------------------
# Điều 4 - Hình thức đào tạo
# ---------------------------------------------------------------------

:FullTimeTrainingMode a :TrainingMode, owl:NamedIndividual ;
    rdfs:label "Đào tạo chính quy"@vi ;
    :definitionText "Hoạt động giảng dạy được thực hiện tại Trường; thực hành, thực tập, trải nghiệm thực tế và giảng dạy trực tuyến có thể thực hiện ngoài Trường. Thời gian giảng dạy từ 06 giờ đến 20 giờ, từ thứ 2 đến thứ 7."@vi ;
    :basedOn :Regulation1052Article04Clause01 ;
    skos:altLabel "hệ chính quy"@vi ,
        "chính quy"@vi .

:PartTimeTrainingMode a :TrainingMode, owl:NamedIndividual ;
    rdfs:label "Đào tạo vừa làm vừa học"@vi ;
    :definitionText "Hoạt động giảng dạy được thực hiện tại Trường hoặc tại cơ sở phối hợp đào tạo. Thời gian giảng dạy linh hoạt trong ngày và trong tuần."@vi ;
    :basedOn :Regulation1052Article04Clause02 ;
    skos:altLabel "hệ vừa học vừa làm"@vi ,
        "vừa làm vừa học"@vi ,
        "tại chức"@vi .


# ---------------------------------------------------------------------
# Điều 5 - Tín chỉ
# ---------------------------------------------------------------------

:CreditConcept a :AcademicConcept, owl:NamedIndividual ;
    rdfs:label "Tín chỉ"@vi ;
    :definitionText "Tín chỉ là đơn vị tính khối lượng học tập của người học, bao gồm khối lượng kiến thức và kỹ năng mà người học cần tích lũy trong một khoảng thời gian nhất định."@vi ;
    :basedOn :Regulation1052Article05Clause01 ;
    skos:altLabel "tín chỉ là gì"@vi ,
        "đơn vị tín chỉ"@vi .

:CreditWorkloadRule a :AcademicRule, owl:NamedIndividual ;
    rdfs:label "Quy đổi giờ học của một tín chỉ"@vi ;
    :ruleText "Một tín chỉ tương đương 50 giờ học tập định mức. Đối với hoạt động trên lớp, một tín chỉ yêu cầu tối thiểu 15 giờ giảng, hoặc 30 giờ thực hành, thí nghiệm, thảo luận, hoặc 45 giờ thực tập tại cơ sở ngoài trường, làm tiểu luận, bài tập lớn, đồ án, khóa luận, chuyên đề tốt nghiệp. Một giờ giảng được tính bằng 50 phút."@vi ;
    :basedOn :Regulation1052Article05Clause02 .


# ---------------------------------------------------------------------
# Điều 6 - Chín loại học phần
# ---------------------------------------------------------------------

:CompulsoryCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần bắt buộc"@vi ;
    :definitionText "Học phần chứa đựng những nội dung kiến thức chính yếu của mỗi chương trình đào tạo và bắt buộc sinh viên phải tích lũy."@vi ;
    :basedOn :Regulation1052Article06Clause02PointA .

:ElectiveCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần tự chọn"@vi ;
    :definitionText "Học phần chứa đựng những nội dung kiến thức cần thiết, sinh viên được tự chọn theo hướng dẫn của Trường nhằm đa dạng hóa hướng chuyên môn hoặc tự chọn tùy ý để tích lũy đủ số học phần quy định."@vi ;
    :basedOn :Regulation1052Article06Clause02PointB .

:PrerequisiteCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần tiên quyết"@vi ;
    :definitionText "Học phần sinh viên phải tích lũy mới được học các học phần tiếp theo."@vi ;
    :basedOn :Regulation1052Article06Clause02PointC .

:OptionalCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần nhiệm ý"@vi ;
    :definitionText "Học phần sinh viên có thể tự do đăng ký học theo nhu cầu cá nhân. Kết quả được ghi trong bảng điểm nhưng không tính vào trung bình chung tích lũy và không dùng để phân loại, xếp hạng học tập."@vi ;
    :basedOn :Regulation1052Article06Clause02PointD .

:PriorCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần học trước"@vi ;
    :definitionText "Học phần sinh viên phải học xong, có thể đạt hoặc không đạt, trước khi học các học phần tiếp theo."@vi ;
    :basedOn :Regulation1052Article06Clause02PointDD .

:CorequisiteCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần song hành"@vi ;
    :definitionText "Học phần sinh viên có thể học cùng với các học phần khác trong một học kỳ."@vi ;
    :basedOn :Regulation1052Article06Clause02PointE .

:ConditionCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần điều kiện"@vi ;
    :definitionText "Học phần mà sinh viên phải hoàn thành trước khi tốt nghiệp nhưng kết quả không dùng để tính điểm trung bình chung tích lũy."@vi ;
    :basedOn :Regulation1052Article06Clause02PointG .

:EquivalentCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần tương đương"@vi ;
    :definitionText "Một hay một nhóm học phần thuộc chương trình đào tạo của một khóa học hoặc một ngành khác đang tổ chức đào tạo tại Trường hoặc cơ sở đào tạo khác, được phép tích lũy để thay cho học phần trong chương trình đào tạo."@vi ;
    :basedOn :Regulation1052Article06Clause02PointH .

:ReplacementCourseType a :CourseType, owl:NamedIndividual ;
    rdfs:label "Học phần thay thế"@vi ;
    :definitionText "Học phần được dùng thay cho một học phần có trong chương trình đào tạo khóa trước nhưng khóa sau không còn tổ chức đào tạo, hoặc học phần tự chọn thay cho học phần tự chọn khác mà sinh viên học không đạt."@vi ;
    :basedOn :Regulation1052Article06Clause02PointI .


# ---------------------------------------------------------------------
# Điều 7 - Học kỳ
# ---------------------------------------------------------------------

:MainSemester a :SemesterType, owl:NamedIndividual ;
    rdfs:label "Học kỳ chính"@vi ;
    :definitionText "Học kỳ I và học kỳ II kéo dài ít nhất 19 tuần, bao gồm 14 tuần học (trong đó có 01 tuần học số), 01 tuần thi giữa kỳ, 02 tuần thi cuối kỳ, 01 tuần chấm thi giữa kỳ và 01 tuần chấm thi cuối kỳ."@vi ;
    :basedOn :Regulation1052Article07Clause02PointA ;
    skos:altLabel "học kỳ I"@vi ,
        "học kỳ II"@vi .

:SummerSemester a :SemesterType, owl:NamedIndividual ;
    rdfs:label "Học kỳ hè"@vi ;
    :definitionText "Học kỳ III là học kỳ hè kéo dài tối đa 8 tuần, gồm tối đa 07 tuần học và 01 tuần thi. Học kỳ III tổ chức học tập trung các học phần Giáo dục quốc phòng - An ninh hoặc giúp sinh viên học vượt, học lại, học cải thiện."@vi ;
    :basedOn :Regulation1052Article07Clause02PointB ;
    skos:altLabel "học kỳ III"@vi ,
        "học kỳ phụ"@vi ,
        "kỳ hè"@vi .


# ---------------------------------------------------------------------
# Điều 13 - Đào tạo trực tuyến
# ---------------------------------------------------------------------

:AsynchronousOnlineDelivery a :DeliveryMode, owl:NamedIndividual ;
    rdfs:label "Đào tạo trực tuyến không đồng bộ"@vi ;
    :definitionText "Sinh viên chủ động tham gia các hoạt động đào tạo trực tuyến trên cơ sở kế hoạch dạy học của giảng viên. Đây là hình thức kết hợp dạy học trực tiếp trên lớp với việc sử dụng hệ thống NTU E-learning."@vi ;
    :basedOn :Regulation1052Article13Clause03PointA .

:SynchronousOnlineDelivery a :DeliveryMode, owl:NamedIndividual ;
    rdfs:label "Đào tạo trực tuyến đồng bộ"@vi ;
    :definitionText "Giảng viên và sinh viên cùng tham gia các hoạt động đào tạo tại cùng một thời điểm trên cùng một không gian học tập. Đây là hình thức dạy học hoàn toàn trực tuyến."@vi ;
    :basedOn :Regulation1052Article13Clause03PointB .

:OnlineTrainingProportionRule a :OnlineTrainingRule, owl:NamedIndividual ;
    rdfs:label "Tỷ lệ tối đa đào tạo trực tuyến"@vi ;
    :ruleText "Nhà trường áp dụng tối đa 30% tổng khối lượng chương trình đào tạo cho hoạt động dạy học trực tuyến. Trong trường hợp thiên tai, dịch bệnh phức tạp hoặc bất khả kháng khác, Nhà trường thực hiện theo hướng dẫn của Bộ Giáo dục và Đào tạo."@vi ;
    :maximumPercentage "30"^^xsd:decimal ;
    :basedOn :Regulation1052Article13Clause02 .


# ---------------------------------------------------------------------
# Điều 16 - Điểm chữ và thành phần đánh giá
# ---------------------------------------------------------------------

:GradeP a :GradeCode, owl:NamedIndividual ;
    rdfs:label "Điểm P"@vi ;
    :codeLetter "P" ;
    :definitionText "Loại đạt không phân mức, áp dụng cho học phần chỉ yêu cầu đạt và không tính vào điểm trung bình học tập. Đạt từ 5 điểm trở lên."@vi ;
    :basedOn :Regulation1052Article16Clause02PointC .

:GradeI a :GradeCode, owl:NamedIndividual ;
    rdfs:label "Điểm I"@vi ;
    :codeLetter "I" ;
    :definitionText "Điểm học phần chưa hoàn thiện do được phép hoãn thi, kiểm tra."@vi ;
    :basedOn :Regulation1052Article16Clause02PointC .

:GradeX a :GradeCode, owl:NamedIndividual ;
    rdfs:label "Điểm X"@vi ;
    :codeLetter "X" ;
    :definitionText "Điểm học phần chưa hoàn thiện do chưa đủ dữ liệu."@vi ;
    :basedOn :Regulation1052Article16Clause02PointC .

:GradeR a :GradeCode, owl:NamedIndividual ;
    rdfs:label "Điểm R"@vi ;
    :codeLetter "R" ;
    :definitionText "Điểm học phần bảo lưu được miễn học và công nhận tín chỉ."@vi ;
    :basedOn :Regulation1052Article16Clause02PointC .

:ContinuousAssessment a :AssessmentComponent, owl:NamedIndividual ;
    rdfs:label "Đánh giá quá trình"@vi ;
    :definitionText "Gồm điểm chuyên cần, điểm kiểm tra, bài tập, sản phẩm học tập và điểm đánh giá giữa kỳ nếu có."@vi ;
    :basedOn :Regulation1052Article16Clause01 .

:FinalAssessment a :AssessmentComponent, owl:NamedIndividual ;
    rdfs:label "Đánh giá cuối kỳ"@vi ;
    :definitionText "Thường dưới dạng bài thi viết, vấn đáp, thực hành hoặc sản phẩm tổng hợp, được tổ chức vào cuối học phần."@vi ;
    :basedOn :Regulation1052Article16Clause01 .

:GradingScaleConcept a :AcademicConcept, owl:NamedIndividual ;
    rdfs:label "Thang điểm đánh giá"@vi ;
    :definitionText "Nhà trường sử dụng thang điểm 10 để đánh giá kết quả học tập. Điểm học phần được chấm theo thang điểm 10 từ 0,0 đến 10 và làm tròn đến một chữ số thập phân. Điểm học phần từ 5,0 trở lên được đánh giá là đạt."@vi ;
    :basedOn :Regulation1052Article15Clause01 ;
    skos:altLabel "thang điểm 10"@vi ,
        "thang điểm"@vi .


# ---------------------------------------------------------------------
# Điều 2 và Điều 9 - thời gian đào tạo và khối lượng đăng ký
# ---------------------------------------------------------------------

:StandardBachelorDurationRule a :StudyDurationRule, owl:NamedIndividual ;
    rdfs:label "Thời gian đào tạo chuẩn toàn khóa"@vi ;
    :ruleText "Thời gian theo kế hoạch học tập chuẩn toàn khóa cho một chương trình đại học chính quy cấp bằng cử nhân là 4 năm, chương trình chuyên sâu đặc thù cấp bằng kỹ sư là 4,5 năm."@vi ;
    :basedOn :Regulation1052Article02Clause04PointA .

:PartTimeDurationRule a :StudyDurationRule, owl:NamedIndividual ;
    rdfs:label "Thời gian đào tạo hình thức vừa làm vừa học"@vi ;
    :ruleText "Hệ vừa làm vừa học có thời gian học chuẩn toàn khóa dài hơn hệ chính quy cùng ngành ít nhất 20%."@vi ;
    :minimumPercentage "20"^^xsd:decimal ;
    :appliesToTrainingMode :PartTimeTrainingMode ;
    :basedOn :Regulation1052Article02Clause04PointB .

:MaximumStudyDurationRule a :StudyDurationRule, owl:NamedIndividual ;
    rdfs:label "Thời gian tối đa hoàn thành khóa học"@vi ;
    :ruleText "Thời gian tối đa hoàn thành toàn khóa học không quá 2 lần thời gian theo kế hoạch học tập chuẩn toàn khóa."@vi ;
    :basedOn :Regulation1052Article02Clause04PointC ;
    skos:altLabel "thời gian tối đa"@vi ,
        "học tối đa bao lâu"@vi .

:StandardCreditLoadRule a :CreditLoadRule, owl:NamedIndividual ;
    rdfs:label "Khối lượng đăng ký của sinh viên học lực trung bình trở lên"@vi ;
    :ruleText "Sinh viên xếp loại học lực trung bình trở lên của học kỳ liền trước được đăng ký tối thiểu 15 tín chỉ và tối đa 27 tín chỉ đối với chương trình 4 năm, tối đa 32 tín chỉ đối với chương trình 4,5 năm và chương trình đặc biệt theo đặt hàng của doanh nghiệp. Không tính tín chỉ của các học phần Giáo dục thể chất, Giáo dục Quốc phòng – An ninh."@vi ;
    :appliesToPerformanceBand :AverageAcademicPerformanceBand,
        :ExcellentAcademicPerformanceBand,
        :FairAcademicPerformanceBand,
        :GoodAcademicPerformanceBand ;
    :minimumCredits "15"^^xsd:integer ;
    :maximumCredits "27"^^xsd:integer ;
    :basedOn :Regulation1052Article09Clause03 .

:WeakCreditLoadRule a :CreditLoadRule, owl:NamedIndividual ;
    rdfs:label "Khối lượng đăng ký của sinh viên học lực yếu kém"@vi ;
    :ruleText "Sinh viên xếp loại học lực hạng yếu kém của học kỳ liền trước được đăng ký tối thiểu 12 tín chỉ và tối đa 18 tín chỉ trong một học kỳ."@vi ;
    :appliesToPerformanceBand :PoorAcademicPerformanceBand,
        :WeakAcademicPerformanceBand ;
    :minimumCredits "12"^^xsd:integer ;
    :maximumCredits "18"^^xsd:integer ;
    :basedOn :Regulation1052Article09Clause04 .


# ---------------------------------------------------------------------
# Điều 17 - Điều kiện dự thi
# ---------------------------------------------------------------------

:TheoryAttendanceRule a :AttendanceRule, owl:NamedIndividual ;
    rdfs:label "Điều kiện dự thi học phần lý thuyết"@vi ;
    :ruleText "Đối với học phần lý thuyết, sinh viên phải tham dự tối thiểu 80% tổng số giờ học của học phần và thực hiện đầy đủ các yêu cầu bắt buộc ghi trong Đề cương chi tiết học phần."@vi ;
    :minimumPercentage "80"^^xsd:decimal ;
    :basedOn :Regulation1052Article17Clause01PointA .

:PracticeAttendanceRule a :AttendanceRule, owl:NamedIndividual ;
    rdfs:label "Điều kiện dự thi học phần thực hành"@vi ;
    :ruleText "Đối với các học phần thực hành, thí nghiệm, thực tập ngoài trường, sinh viên phải tham dự 100% số giờ học. Trường hợp nghỉ có lý do chính đáng sẽ do Khoa hoặc viện đào tạo xem xét xử lý."@vi ;
    :minimumPercentage "100"^^xsd:decimal ;
    :basedOn :Regulation1052Article17Clause01PointB .

:ExamAbsenceRule a :AttendanceRule, owl:NamedIndividual ;
    rdfs:label "Hậu quả của việc bị cấm thi hoặc vắng thi"@vi ;
    :ruleText "Sinh viên bị cấm thi hoặc vắng thi không có lý do chính đáng trong kỳ thi nào sẽ nhận điểm 0 ở kỳ thi đó."@vi ;
    :basedOn :Regulation1052Article17Clause02 .


# ---------------------------------------------------------------------
# Điều 20 - Cảnh báo kết quả học tập và buộc thôi học
# ---------------------------------------------------------------------

:CreditDebtWarningRule a :AcademicWarningRule, owl:NamedIndividual ;
    rdfs:label "Cảnh báo do nợ tín chỉ"@vi ;
    :ruleText "Tổng số tín chỉ không đạt trong học kỳ vượt quá 50% khối lượng đã đăng ký trong học kỳ, hoặc tổng số tín chỉ nợ đọng từ đầu khóa học vượt quá 24."@vi ;
    :basedOn :Regulation1052Article20Clause01PointA .

:SemesterAverageWarningRule a :AcademicWarningRule, owl:NamedIndividual ;
    rdfs:label "Cảnh báo do điểm trung bình học kỳ"@vi ;
    :ruleText "Điểm trung bình chung học kỳ đạt dưới 4,00 đối với học kỳ đầu khóa học, dưới 4,50 đối với học kỳ tiếp theo."@vi ;
    :basedOn :Regulation1052Article20Clause01PointB .

:CumulativeAverageWarningRule a :AcademicWarningRule, owl:NamedIndividual ;
    rdfs:label "Cảnh báo do điểm trung bình tích lũy"@vi ;
    :ruleText "Điểm trung bình tích lũy đạt dưới 5,20 đối với sinh viên năm thứ nhất, dưới 5,30 đối với năm thứ hai, dưới 5,40 đối với năm thứ ba, hoặc dưới 5,50 đối với các năm tiếp theo."@vi ;
    :basedOn :Regulation1052Article20Clause01PointC .

:RepeatedWarningDismissalRule a :DismissalRule, owl:NamedIndividual ;
    rdfs:label "Buộc thôi học do cảnh báo liên tiếp"@vi ;
    :ruleText "Sinh viên bị buộc thôi học nếu vượt quá 02 lần cảnh báo kết quả học tập liên tiếp."@vi ;
    :basedOn :Regulation1052Article20Clause02PointA .

:ExceededDurationDismissalRule a :DismissalRule, owl:NamedIndividual ;
    rdfs:label "Buộc thôi học do quá thời gian đào tạo"@vi ;
    :ruleText "Sinh viên bị buộc thôi học nếu vượt quá thời gian tối đa được phép học tại Trường."@vi ;
    :basedOn :Regulation1052Article20Clause02PointB .


# ---------------------------------------------------------------------
# Điều 21, 27 - giới hạn công nhận và chuyển đổi tín chỉ
# ---------------------------------------------------------------------

:TransferVolumeLimitRule a :CreditTransferRule, owl:NamedIndividual ;
    rdfs:label "Giới hạn khối lượng được công nhận và chuyển đổi"@vi ;
    :ruleText "Khối lượng tối đa được công nhận kết quả học tập và chuyển đổi không vượt quá 50% khối lượng học tập tối thiểu của chương trình đào tạo."@vi ;
    :maximumPercentage "50"^^xsd:decimal ;
    :basedOn :Regulation1052Article21Clause04 .

:TransferValidityRule a :CreditTransferRule, owl:NamedIndividual ;
    rdfs:label "Thời hạn hiệu lực của học phần được công nhận"@vi ;
    :ruleText "Nhà trường chỉ cho phép công nhận kết quả học tập, miễn học, miễn thi, điểm thưởng và chuyển đổi tín chỉ của học phần được tích lũy trong vòng 5 năm tính đến ngày xem xét."@vi ;
    :durationInYears "5"^^xsd:decimal ;
    :basedOn :Regulation1052Article21Clause07 .

:ExchangeCreditLimitRule a :CreditTransferRule, owl:NamedIndividual ;
    rdfs:label "Giới hạn tín chỉ tích lũy tại trường khác"@vi ;
    :ruleText "Sinh viên tham gia chương trình trao đổi có thể đăng ký học một số học phần tại trường khác với số lượng tín chỉ tích lũy tại trường khác không vượt quá 25% tổng khối lượng của chương trình đào tạo."@vi ;
    :maximumPercentage "25"^^xsd:decimal ;
    :basedOn :Regulation1052Article27Clause02 .


# ---------------------------------------------------------------------
# Điều 23 - hạ hạng tốt nghiệp
# ---------------------------------------------------------------------

:RetakeVolumeHonoursPenalty a :GraduationHonoursPenaltyRule, owl:NamedIndividual ;
    rdfs:label "Hạ hạng tốt nghiệp do học lại quá nhiều"@vi ;
    :ruleText "Hạng tốt nghiệp của sinh viên có điểm trung bình chung tích lũy loại xuất sắc và giỏi bị giảm đi một mức nếu khối lượng của các học phần phải học lại vượt quá 5% so với tổng số tín chỉ quy định của toàn chương trình."@vi ;
    :maximumPercentage "5"^^xsd:decimal ;
    :basedOn :Regulation1052Article23Clause03PointA .

:DisciplineHonoursPenalty a :GraduationHonoursPenaltyRule, owl:NamedIndividual ;
    rdfs:label "Hạ hạng tốt nghiệp do bị kỷ luật"@vi ;
    :ruleText "Hạng tốt nghiệp của sinh viên có điểm trung bình chung tích lũy loại xuất sắc và giỏi bị giảm đi một mức nếu sinh viên đã bị kỷ luật từ mức cảnh cáo trở lên trong thời gian học."@vi ;
    :basedOn :Regulation1052Article23Clause03PointB .


# ---------------------------------------------------------------------
# Điều 31 - Xử lý sinh viên vi phạm
# ---------------------------------------------------------------------

:AcademicMisconductPolicy a :AcademicPolicy, owl:NamedIndividual ;
    rdfs:label "Chính sách xử lý sinh viên vi phạm"@vi ;
    :summaryText "Gian lận trong học tập, kiểm tra hoặc thi học phần bị xử lý kỷ luật riêng cho từng học phần vi phạm, theo Quy chế công tác sinh viên."@vi ;
    :basedOn :Regulation1052Article31 ;
    skos:altLabel "gian lận thi cử"@vi ,
        "quay cóp"@vi ,
        "xử lý vi phạm"@vi .


# ---------------------------------------------------------------------
# Điều 1, 3, 8, 12 - phạm vi, phương thức và tổ chức lớp
# ---------------------------------------------------------------------

:RegulationScopeConcept a :AcademicConcept, owl:NamedIndividual ;
    rdfs:label "Phạm vi và đối tượng áp dụng của quy chế"@vi ;
    :definitionText "Quy chế áp dụng đối với sinh viên học theo hình thức đào tạo chính quy và vừa làm vừa học; sinh viên học cùng lúc hai chương trình; sinh viên liên thông đối với người có văn bằng khác; sinh viên theo chương trình trao đổi và công nhận tín chỉ; các khoa hoặc viện đào tạo, đơn vị quản lý đào tạo, giảng viên và các đơn vị, cá nhân có liên quan."@vi ;
    :basedOn :Regulation1052Article01Clause02 ;
    skos:altLabel "quy chế áp dụng cho ai"@vi .

:CreditBasedTrainingConcept a :AcademicConcept, owl:NamedIndividual ;
    rdfs:label "Phương thức tổ chức đào tạo theo tín chỉ"@vi ;
    :definitionText "Phương thức tổ chức đào tạo theo tín chỉ là cách thức tổ chức đào tạo theo từng lớp học phần, cho phép sinh viên tích lũy tín chỉ của từng học phần và thực hiện chương trình đào tạo theo kế hoạch học tập của cá nhân, phù hợp với kế hoạch giảng dạy của Trường."@vi ;
    :basedOn :Regulation1052Article03Clause01 ;
    skos:altLabel "đào tạo tín chỉ"@vi ,
        "học theo tín chỉ"@vi .

:AdministrativeClassConcept a :AcademicConcept, owl:NamedIndividual ;
    rdfs:label "Lớp hành chính"@vi ;
    :definitionText "Lớp hành chính là lớp được thành lập ổn định trong cả khóa học theo ngành, chuyên ngành hoặc chương trình đào tạo, dùng để duy trì hoạt động đoàn thể, xét kết quả rèn luyện, xét khen thưởng và phổ biến thông tin. Mỗi lớp hành chính có mã số riêng, được bố trí cố vấn học tập và cần có tối thiểu 20 sinh viên."@vi ;
    :basedOn :Regulation1052Article08Clause01PointA ;
    skos:altLabel "lớp sinh viên"@vi ,
        "lớp chuyên môn"@vi .

:CourseClassConcept a :AcademicConcept, owl:NamedIndividual ;
    rdfs:label "Lớp học phần"@vi ;
    :definitionText "Lớp học phần là lớp mà sinh viên đăng ký theo học cùng học phần trong một học kỳ. Mỗi học phần có thể có nhiều lớp học phần với mã số nhóm khác nhau. Lớp học phần được áp dụng cho hình thức đào tạo chính quy."@vi ;
    :basedOn :Regulation1052Article08Clause02PointA ;
    skos:altLabel "nhóm lớp"@vi .

:CourseSyllabusConcept a :AcademicConcept, owl:NamedIndividual ;
    rdfs:label "Đề cương chi tiết học phần"@vi ;
    :definitionText "Đề cương chi tiết học phần là kế hoạch dạy học trong đó nêu rõ mục tiêu, kết quả học tập mong đợi, nội dung và kế hoạch dạy học, kiểm tra, đánh giá và các yêu cầu khác theo quy định của Trường."@vi ;
    :basedOn :Regulation1052Article12Clause01 ;
    skos:altLabel "đề cương học phần"@vi ,
        "syllabus"@vi .
