:CourseExemptionAndBonusProcedure a :AcademicProcedure, owl:NamedIndividual ;
    :basedOn :Regulation1052Article21Clause05 ;
    :hasRequirement :CourseExemptionRequirement01 ;
    :hasStep :CourseExemptionStep01,
        :CourseExemptionStep02 ;
    :requiresForm :Form07ExemptionAndBonus ;
    :reviewedBy :ProfessionalCouncil ;
    :submittedTo :AcademicManagementUnit ;
    :summaryText "Thủ tục đề nghị miễn học, miễn thi kết thúc học phần và cộng điểm thưởng khi có thành tích hoặc chứng chỉ đủ điều kiện."@vi ;
    rdfs:label "Thủ tục xin miễn học, miễn thi và cộng điểm thưởng"@vi ;
    skos:altLabel "cộng điểm thưởng"@vi,
        "miễn học miễn thi"@vi,
        "miễn học"@vi,
        "miễn thi"@vi,
        "xin miễn học phần"@vi .

:CourseExemptionRequirement01 a :Requirement, owl:NamedIndividual ;
    :basedOn :Regulation1052Article21Clause05 ;
    :requirementOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :requirementText "Đạt giải nhất, nhì, ba trong kỳ thi Olympic sinh viên cấp tỉnh trở lên hoặc Giải thưởng khoa học công nghệ dành cho sinh viên; hoặc có chứng chỉ ngoại ngữ quốc tế còn hiệu lực theo Phụ lục 2; hoặc có chứng chỉ tin học quốc tế còn hiệu lực theo Phụ lục 3."@vi ;
    rdfs:label "Trường hợp được xét miễn học, miễn thi và cộng điểm thưởng"@vi .

:CourseExemptionStep01 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article21Clause06 ;
    :performedBy :Student ;
    :stepOrder "1"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Viết đơn theo Mẫu số 07 (Phụ lục 4), kèm minh chứng hợp lệ."@vi ;
    :usesForm :Form07ExemptionAndBonus ;
    rdfs:label "Miễn học miễn thi - bước 1"@vi .

:CourseExemptionStep02 a :ProcedureStep, owl:NamedIndividual ;
    :basedOn :Regulation1052Article21Clause06 ;
    :performedBy :Student ;
    :stepOrder "2"^^<http://www.w3.org/2001/XMLSchema#integer> ;
    :stepText "Gửi hồ sơ về Phòng Đào tạo Đại học để được xem xét giải quyết."@vi ;
    :submittedTo :AcademicManagementUnit ;
    rdfs:label "Miễn học miễn thi - bước 2"@vi .

