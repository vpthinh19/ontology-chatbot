:Regulation1052Article27Clause03 a :Clause, owl:NamedIndividual ;
    rdfs:label "khoản 3 Điều 27 Quy chế đào tạo trình độ đại học"@vi ;
    :citationLabel "khoản 3 Điều 27 Quy chế đào tạo trình độ đại học Trường Đại học Nha Trang, ban hành kèm Quyết định 1052/QĐ-ĐHNT ngày 17/7/2025"@vi ;
    :documentUrl "https://pdtdaihoc.ntu.edu.vn/uploads/38//245-Quyet%20dinh%201052%20(17-7-2025)%20ban%20hanh%20quy%20che%20dao%20tao%20trinh%20do%20dai%20hoc%20cua%20Truong%20DHNT.pdf"^^xsd:anyURI ;
    :inDocument :Regulation1052 ;
    :partOf :Regulation1052Article27 ;
    :officialText """Điều kiện đăng ký chương trình trao đổi SV, cụ thể như sau:
a) Sinh viên đã kết thúc 1 năm học tại Trường và có điểm trung bình chung tích lũy đạt từ 6,00 trở lên.
b) Trường hợp khác sẽ do Hiệu trưởng xem xét quyết định."""@vi ;
    :articleNumber "27"^^xsd:integer ;
    :clauseNumber "3"^^xsd:integer .

