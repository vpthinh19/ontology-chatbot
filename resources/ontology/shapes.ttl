		[ sh:path skos:altLabel ;
		  sh:name "tên gọi khác"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ] ,
		[ sh:path :donViQuanLy ;
		  sh:name "đơn vị quản lý"@vi ;
		  sh:class :ChuThe ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] ,
		[ sh:path :maNganh ;
		  sh:name "mã ngành"@vi ;
		  sh:datatype xsd:string ;
		  sh:maxCount 1 ;
