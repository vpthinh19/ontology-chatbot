@prefix : <http://www.ntu.edu.vn/ontology/academic#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Cấu trúc ontology.trig khai báo bằng SHACL. Mỗi loại thông tin là một NodeShape: các
# ô nó có (sh:property), ô bắt buộc (sh:minCount 1), ô chỉ một giá trị (sh:maxCount 1),
# ô là chữ (sh:datatype), ô trỏ tới loại khác (sh:class) hay chọn trong danh sách cố
# định (sh:in). sh:closed cấm ô chưa khai báo. :batBuocNguon true nghĩa là câu của ô đó
# phải nằm trong một túi trích dẫn; false là được phép không nguồn (ô loại do ta tự đặt,
# cặp ghép mẫu đơn). Ô danh tính (nhãn, tên gọi khác) và tầng nguồn luôn nằm ngoài túi.

:BangShape a sh:NodeShape ;
	sh:targetClass :Bang ;
	rdfs:label "Bảng"@vi ;
	sh:closed true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:property
		[ sh:path rdfs:label ;
		  sh:name "nhãn"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ] ,
		[ sh:path skos:altLabel ;
		  sh:name "tên gọi khác"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ] ,
		[ sh:path :apDungChoChuongTrinh ;
		  sh:name "áp dụng cho chương trình"@vi ;
		  sh:class :ChuongTrinhDaoTao ;
		  :batBuocNguon true ] ,
		[ sh:path :apDungChoNganh ;
		  sh:name "áp dụng cho ngành"@vi ;
		  sh:class :NganhDaoTao ;
		  :batBuocNguon true ] ,
		[ sh:path :gomHocPhan ;
		  sh:name "gồm học phần"@vi ;
		  sh:class :HocPhan ;
		  :batBuocNguon true ] ,
		[ sh:path :loaiBang ;
		  sh:name "loại bảng"@vi ;
		  sh:in ( :BangQuyDoiChungChi :BangTrongTaiLieu ) ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ;
		  :batBuocNguon false ] ,
		[ sh:path :noiDung ;
		  sh:name "nội dung"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  sh:minCount 1 ;
		  :batBuocNguon true ] .

:BieuMauTheoQuyetDinhShape a sh:NodeShape ;
	sh:targetClass :BieuMauTheoQuyetDinh ;
	rdfs:label "Biểu mẫu theo quyết định"@vi ;
	sh:closed true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:property
		[ sh:path rdfs:label ;
		  sh:name "nhãn"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ] ,
		[ sh:path :soHieuMauTheoQuyetDinh ;
		  sh:name "số hiệu mẫu theo quyết định"@vi ;
		  sh:datatype xsd:string ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] .

:ChuTheShape a sh:NodeShape ;
	sh:targetClass :ChuThe ;
	rdfs:label "Chủ thể"@vi ;
	sh:closed true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:property
		[ sh:path rdfs:label ;
		  sh:name "nhãn"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ] ,
		[ sh:path skos:altLabel ;
		  sh:name "tên gọi khác"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ] ,
		[ sh:path :diaChi ;
		  sh:name "địa chỉ"@vi ;
		  sh:datatype xsd:string ;
		  :batBuocNguon true ] ,
		[ sh:path :dienThoai ;
		  sh:name "điện thoại"@vi ;
		  sh:datatype xsd:string ;
		  :batBuocNguon true ] ,
		[ sh:path :hopThu ;
		  sh:name "hộp thư"@vi ;
		  sh:datatype xsd:string ;
		  :batBuocNguon true ] ,
		[ sh:path :loaiChuThe ;
		  sh:name "loại chủ thể"@vi ;
		  sh:in ( :ChuTheThamGia :DonViTrongTruong ) ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ;
		  :batBuocNguon false ] ,
		[ sh:path :noiDung ;
		  sh:name "nội dung"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  :batBuocNguon true ] ,
		[ sh:path :thuocDonVi ;
		  sh:name "thuộc đơn vị"@vi ;
		  sh:class :ChuThe ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] ,
		[ sh:path :viTri ;
		  sh:name "vị trí"@vi ;
		  sh:datatype xsd:string ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] ,
		[ sh:path :websiteDonVi ;
		  sh:name "website đơn vị"@vi ;
		  sh:datatype xsd:string ;
		  :batBuocNguon true ] .

:ChungChiShape a sh:NodeShape ;
	sh:targetClass :ChungChi ;
	rdfs:label "Chứng chỉ"@vi ;
	sh:closed true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:property
		[ sh:path rdfs:label ;
		  sh:name "nhãn"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ] ,
		[ sh:path skos:altLabel ;
		  sh:name "tên gọi khác"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ] ,
		[ sh:path :loaiChungChi ;
		  sh:name "loại chứng chỉ"@vi ;
		  sh:in ( :ChungChiNgoaiNgu :ChungChiTinHoc ) ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] ,
		[ sh:path :noiDung ;
		  sh:name "nội dung"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  :batBuocNguon true ] ,
		[ sh:path :tenDayDuCuaChungChi ;
		  sh:name "tên đầy đủ của chứng chỉ"@vi ;
		  sh:datatype xsd:string ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] .

:ChuongTrinhDaoTaoShape a sh:NodeShape ;
	sh:targetClass :ChuongTrinhDaoTao ;
	rdfs:label "Chương trình đào tạo"@vi ;
