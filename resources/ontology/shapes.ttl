		[ sh:path :thoiGianDaoTao ;
		  sh:name "thời gian đào tạo"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] ,
		[ sh:path :thuocNganh ;
		  sh:name "thuộc ngành"@vi ;
		  sh:class :NganhDaoTao ;
		  sh:minCount 1 ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] ,
		[ sh:path :vanBangTotNghiep ;
		  sh:name "văn bằng tốt nghiệp"@vi ;
		  sh:datatype rdf:langString ; sh:languageIn ( "vi" ) ;
		  sh:maxCount 1 ;
		  :batBuocNguon true ] .

:ChuyenNganhShape a sh:NodeShape ;
	sh:targetClass :ChuyenNganh ;
	rdfs:label "Chuyên ngành"@vi ;
	sh:closed true ;
	sh:ignoredProperties ( rdf:type ) ;
	sh:property
		[ sh:path rdfs:label ;
