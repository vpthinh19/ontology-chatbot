ns1:TDNguon1052Khoan2Dieu11 {
    ns1:ThuTucDangKyHocLaiHocPhan ns1:noiDung "Sinh viên có học phần tự chọn bị điểm dưới 5,0 phải đăng ký học lại học phần đó hoặc đổi sang đăng ký học học phần tự chọn tương đương khác."@vi .
}

ns1:TD1052_D01K02 {
    ns1:KhoaHoacVienDaoTao ns1:loaiChuThe ns1:DonViTrongTruong .

    ns1:PhamViVaDoiTuongApDungCuaQuyChe ns1:noiDung "Quy chế áp dụng đối với sinh viên học theo hình thức đào tạo chính quy và vừa làm vừa học; sinh viên học cùng lúc hai chương trình; sinh viên liên thông đối với người có văn bằng khác; sinh viên theo chương trình trao đổi và công nhận tín chỉ; các khoa hoặc viện đào tạo, đơn vị quản lý đào tạo, giảng viên và các đơn vị, cá nhân có liên quan."@vi .
}

ns1:TD1052_D24K02 {
    ns1:ThuTucXinThoiHoc ns1:noiDung "Những sinh viên này muốn quay trở lại học phải xét tuyển đầu vào như những thí sinh khác."@vi,
            "Sinh viên được xin thôi học vì lý do cá nhân, trừ trường hợp bị xem xét buộc thôi học hoặc xem xét kỷ luật."@vi .
}

ns1:TD1052_D29K02 {
    ns1:ThuTucHocLienThong ns1:doAiThucHien ns1:SinhVien ;
        ns1:noiDung "Người học đăng ký học liên thông vào đầu mỗi năm học theo thông báo tuyển sinh liên thông hàng năm của Nhà trường."@vi .
}

ns1:TDScholarshipRateTableSpecialProgram {
    ns1:BangMucHocBongChuongTrinhDacBiet ns1:noiDung """| STT | Xếp loại học bổng | Học bổng 05 tháng - chương trình đào tạo đặc biệt / học kỳ (VNĐ) |
| :---: | :--- | :---: |
| 1 | Xuất sắc | 8.640.000 |
| 2 | Giỏi | 7.200.000 |
| 3 | Khá | 6.000.000 |"""@vi .

    ns1:HocBongKhuyenKhichHocTapLoaiGioiChuongTrinhDacBiet ns1:apDungChoTrinhDo ns1:TrinhDoDaiHoc ;
        ns1:donViTienTe "VND" ;
        ns1:donViTinh ns1:DongTrenHocKy ;
        ns1:loaiMucTien ns1:MucHocBongKhuyenKhichHocTap ;
        ns1:noiDung "Chương trình đào tạo đặc biệt, cấp 05 tháng trên một học kỳ"@vi ;
        ns1:soTien "7200000"^^xsd:nonNegativeInteger .

    ns1:HocBongKhuyenKhichHocTapLoaiKhaChuongTrinhDacBiet ns1:apDungChoTrinhDo ns1:TrinhDoDaiHoc ;
        ns1:donViTienTe "VND" ;
        ns1:donViTinh ns1:DongTrenHocKy ;
        ns1:loaiMucTien ns1:MucHocBongKhuyenKhichHocTap ;
        ns1:noiDung "Chương trình đào tạo đặc biệt, cấp 05 tháng trên một học kỳ"@vi ;
        ns1:soTien "6000000"^^xsd:nonNegativeInteger .

    ns1:HocBongKhuyenKhichHocTapLoaiXuatSacChuongTrinhDacBiet ns1:apDungChoTrinhDo ns1:TrinhDoDaiHoc ;
        ns1:donViTienTe "VND" ;
        ns1:donViTinh ns1:DongTrenHocKy ;
        ns1:loaiMucTien ns1:MucHocBongKhuyenKhichHocTap ;
        ns1:noiDung "Chương trình đào tạo đặc biệt, cấp 05 tháng trên một học kỳ"@vi ;
        ns1:soTien "8640000"^^xsd:nonNegativeInteger .

    ns1:ThuTucXetVaCapHocBongKhuyenKhichHocTap ns1:noiDung "Học bổng khuyến khích học tập cho sinh viên đại học hệ đào tạo chính quy - chương trình đào tạo đặc biệt có kết quả học tập và rèn luyện đạt từ mức khá được cấp theo ba mức riêng ứng với xếp loại xuất sắc, giỏi, khá."@vi .
}

ns1:TDNguon1052PhanMoDauDieu28 {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Sinh viên đều có quyền đăng ký học một chương trình đào tạo khác để lấy thêm văn bằng thứ hai trong quá trình học tập bằng hình thức tích lũy tín chỉ theo chương trình đào tạo thứ hai."@vi .
}

ns1:TD1052_D16K01 {
    ns1:DanhGiaCuoiKy ns1:loaiKhaiNiem ns1:ThanhPhanDanhGiaHocPhan ;
        ns1:noiDung "Thường dưới dạng bài thi viết, vấn đáp, thực hành hoặc sản phẩm tổng hợp, được tổ chức vào cuối học phần."@vi .

    ns1:DanhGiaQuaTrinh ns1:loaiKhaiNiem ns1:ThanhPhanDanhGiaHocPhan ;
        ns1:noiDung "Gồm điểm chuyên cần, điểm kiểm tra, bài tập, sản phẩm học tập và điểm đánh giá giữa kỳ nếu có."@vi .
}

ns1:TDNguon1052DiemCKhoan3Dieu28 {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Sinh viên học chương trình thứ hai được bảo lưu các học phần có nội dung và khối lượng kiến thức tương đương đã được học và tích lũy ở chương trình thứ nhất."@vi .
}

ns1:TD1052_D30K02 {
    ns1:ThuTucXinHoanThi ns1:apDungChoTruongHop ns1:OmThaiSanHoacTaiNan ;
        ns1:canBieuMau ns1:MauSo04DonXinHoanThi ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo04DonXinHoanThi ;
        ns1:noiDung "Sinh viên xin nghỉ ốm trong đợt thi kết thúc học phần phải viết đơn xin phép hoãn thi gửi Đơn vị quản lý đào tạo trước ngày thi, kèm theo Giấy chứng nhận của cơ sở y tế Trường hoặc cơ sở y tế xã, phường trở lên (Mẫu số 04 - Phụ lục 4 kèm theo)."@vi ;
        ns1:nopTai ns1:PhongDaoTaoDaiHoc .

    ns1:MauSo04DonXinHoanThi ns1:soHieuMauTheoQuyetDinh "04" .
}

ns1:TDNguon1052DiemAKhoan2Dieu26 {
    ns1:ThuTucChuyenTruong ns1:noiDung "Sinh viên làm hồ sơ xin chuyển Trường theo quy định thông qua Phòng Công tác Chính trị và Sinh viên của Trường Đại học Nha Trang (Mẫu số 13 - Phụ lục 4 kèm theo)."@vi .
}

ns1:TD1052_D17K01 {
    ns1:ThuTucXinPhepNghiHoc ns1:canBieuMau ns1:MauSo03DonXinNghiHoc ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo03DonXinNghiHoc ;
        ns1:noiDung "Sinh viên nghỉ học vì lý do chính đáng (ốm đau, tai nạn, thiên tai, việc gia đình đặc biệt...) phải nộp đơn xin nghỉ học theo mẫu kèm minh chứng liên quan (Mẫu số 03 - Phụ lục 4 kèm theo). Đơn phải nộp cho Khoa hoặc viện đào tạo trong vòng 03 ngày làm việc kể từ ngày bắt đầu nghỉ học."@vi ;
        ns1:nopTai ns1:KhoaHoacVienDaoTao .

    ns1:MauSo03DonXinNghiHoc ns1:soHieuMauTheoQuyetDinh "03" .
}

ns1:TD1052_D23K03dA {
    ns1:HaHangTotNghiepDoHocLaiQuaNhieu ns1:loaiQuyTac ns1:QuyTacHaHangTotNghiep ;
        ns1:noiDung "Hạng tốt nghiệp của sinh viên có điểm trung bình chung tích lũy loại xuất sắc và giỏi bị giảm đi một mức nếu khối lượng của các học phần phải học lại vượt quá 5% so với tổng số tín chỉ quy định của toàn chương trình."@vi ;
        ns1:tyLeToiDa 5.0 .
}

ns1:TD1052_D06K02dG {
    ns1:HocPhanDieuKien ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần mà sinh viên phải hoàn thành trước khi tốt nghiệp nhưng kết quả không dùng để tính điểm trung bình chung tích lũy."@vi .
}

ns1:TDSecondLanguageConversionTableEnglishMajor {
    ns1:BangQuyDoiNgoaiNguHaiNganhNgonNguAnh ns1:loaiBang ns1:BangQuyDoiChungChi ;
        ns1:noiDung """| Khung NLNN 6 bậc | Tiếng Trung (HSK) | Tiếng Trung (TOCFL) | Tiếng Nhật (JLPT) | Tiếng Nhật (JPT) | Tiếng Nga (TPKN) | Tiếng Pháp (DELF) | Tiếng Pháp (TCF) | Tiếng Hàn (TOPIK) | Tiếng Hàn (KLPT) | Quy đổi thành điểm 10 cho các cấp độ HP |
| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |
| Bậc 1 | HSK 1 | TOCFL 1 | N6 | < 315 | TEU | A1 | 100 | TOPIK 1 | 200 | A1 |
| Bậc 2 | HSK 2 | TOCFL 2 | N5 | 315 | TBU | A2 | 200 | TOPIK 2 | ≥ 250 | A2 |
| Bậc 3 | HSK 3 | TOCFL 3 | N4 | 469 | TRKI 1 | B1 | 300 | TOPIK 3 | ≥ 300 | B1 |
| Bậc 4 | HSK 4 | TOCFL 4 | N3 | 610 | TRKI 2 | B2 | 400 | TOPIK 4 | ≥ 350 | B2 |
| Bậc 5 | HSK 5 | | N2 | 740 | TRKI 3 | | | TOPIK 5 | ≥ 400 | |
| Bậc 6 | | | N1 | 880 | TRKI 4 | | | TOPIK 6 | > 450 | |"""@vi .
}

ns1:TDForeignLanguageCourseAssessmentTable {
    ns1:BangDanhGiaHocPhanNgoaiNgu ns1:noiDung """| STT | Học phần | Thành phần đánh giá | Tỷ trọng |
| :---: | :--- | :--- | :---: |
| 1 | Ngoại ngữ A1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 2 | Ngoại ngữ A2.1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 3 | Ngoại ngữ A2.2 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 4 | Ngoại ngữ B1.1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 5 | Ngoại ngữ B1.2 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết<br>Thi kết thúc học phần phải đạt từ 5 điểm trở lên | 40% |
| 6 | Ngoại ngữ B2.1 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết | 40% |
| 7 | Ngoại ngữ B2.2 | Đánh giá quá trình | 20% |
| | | Thi giữa kỳ: Nghe + Nói | 40% |
| | | Thi cuối kỳ: Đọc + Viết<br>Thi kết thúc học phần phải đạt từ 5 điểm trở lên | 40% |"""@vi .

    ns1:NgoaiNguA1 ns1:noiDung "Đánh giá quá trình 20%, thi giữa kỳ Nghe và Nói 40%, thi cuối kỳ Đọc và Viết 40%."@vi .

    ns1:NgoaiNguA21 ns1:noiDung "Đánh giá quá trình 20%, thi giữa kỳ Nghe và Nói 40%, thi cuối kỳ Đọc và Viết 40%."@vi .

    ns1:NgoaiNguA22 ns1:noiDung "Đánh giá quá trình 20%, thi giữa kỳ Nghe và Nói 40%, thi cuối kỳ Đọc và Viết 40%."@vi .

    ns1:NgoaiNguB11 ns1:noiDung "Đánh giá quá trình 20%, thi giữa kỳ Nghe và Nói 40%, thi cuối kỳ Đọc và Viết 40%."@vi .

    ns1:NgoaiNguB12 ns1:noiDung "Đánh giá quá trình 20%, thi giữa kỳ Nghe và Nói 40%, thi cuối kỳ Đọc và Viết 40%. Ngoài ra, thi kết thúc học phần phải đạt từ 5 điểm trở lên."@vi .

    ns1:NgoaiNguB21 ns1:noiDung "Đánh giá quá trình 20%, thi giữa kỳ Nghe và Nói 40%, thi cuối kỳ Đọc và Viết 40%."@vi .

    ns1:NgoaiNguB22 ns1:noiDung "Đánh giá quá trình 20%, thi giữa kỳ Nghe và Nói 40%, thi cuối kỳ Đọc và Viết 40%. Ngoài ra, thi kết thúc học phần phải đạt từ 5 điểm trở lên."@vi .
}

ns1:TD1052_D20K02dB {
    ns1:BuocThoiHocDoQuaThoiGianDaoTao ns1:loaiQuyTac ns1:QuyTacBuocThoiHoc ;
        ns1:noiDung "Sinh viên bị buộc thôi học nếu vượt quá thời gian tối đa được phép học tại Trường."@vi .
}

ns1:TD1052_D22K04 {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:doAiThucHien ns1:HieuTruong ;
        ns1:noiDung "Các đơn vị liên quan thẩm định và trình Hiệu trưởng ký quyết định công nhận tốt nghiệp, cấp bằng cho sinh viên đủ điều kiện."@vi .
}

ns1:TD1052_D09K04 {
    ns1:KhoiLuongDangKyCuaSinhVienHocLucYeuKem ns1:loaiQuyTac ns1:QuyTacKhoiLuongDangKyMoiHocKy ;
        ns1:noiDung "Sinh viên xếp loại học lực hạng yếu kém của học kỳ liền trước được đăng ký tối thiểu 12 tín chỉ và tối đa 18 tín chỉ trong một học kỳ."@vi ;
        ns1:soTinChiToiDa 18 ;
        ns1:soTinChiToiThieu 12 .

    ns1:ThuTucDangKyKhoiLuongHocTap ns1:noiDung "Sinh viên xếp loại học lực yếu kém của học kỳ liền trước đăng ký tối thiểu 12 tín chỉ và tối đa 18 tín chỉ."@vi .
}

ns1:TD1052_D28K03 {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:canBieuMau ns1:MauSo15DonDangKyHocCungLucHaiChuongTrinh ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo15DonDangKyHocCungLucHaiChuongTrinh .

    ns1:MauSo15DonDangKyHocCungLucHaiChuongTrinh ns1:soHieuMauTheoQuyetDinh "15" .
}

ns1:TD1052_D06K02dH {
    ns1:HocPhanTuongDuong ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Một hay một nhóm học phần thuộc chương trình đào tạo của một khóa học hoặc một ngành khác đang tổ chức đào tạo tại Trường hoặc cơ sở đào tạo khác, được phép tích lũy để thay cho học phần trong chương trình đào tạo."@vi .
}

ns1:TD1052_D09K02dB {
    ns1:ThuTucDangKyKhoiLuongHocTap ns1:noiDung "Đăng ký lớp của các học phần dự định học trong học kỳ, gồm học phần mới, học phần chưa đạt để học lại và học phần đã đạt để cải thiện điểm."@vi .
}

ns1:TD1052_D09K02dD {
    ns1:ThuTucDangKyKhoiLuongHocTap ns1:noiDung "Xác nhận đăng ký học phần theo thời gian quy định từ tài khoản cá nhân trên Hệ thống quản lý đào tạo."@vi .
}

ns1:TD1052_D22K02 {
    ns1:ThuTucDeNghiXetTotNghiepSom ns1:canBieuMau ns1:MauSo08DonDeNghiXetTotNghiepSom ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo08DonDeNghiXetTotNghiepSom ;
        ns1:noiDung "Trong trường hợp đủ điều kiện tốt nghiệp sớm hơn thời gian thiết kế của khóa học, sinh viên viết đơn theo mẫu (Mẫu số 08 - Phụ lục 4 kèm theo) gửi Đơn vị quản lý đào tạo đề nghị được xét tốt nghiệp."@vi ;
        ns1:nopTai ns1:PhongDaoTaoDaiHoc ;
        ns1:thuTucTiepTheo ns1:ThuTucXetVaCongNhanTotNghiep .

    ns1:MauSo08DonDeNghiXetTotNghiepSom ns1:soHieuMauTheoQuyetDinh "08" .
}

ns1:TD1052_D13K03dA {
    ns1:DaoTaoTrucTuyenKhongDongBo ns1:loaiKhaiNiem ns1:HinhThucToChucDayHoc ;
        ns1:noiDung "Sinh viên chủ động tham gia các hoạt động đào tạo trực tuyến trên cơ sở kế hoạch dạy học của giảng viên. Đây là hình thức kết hợp dạy học trực tiếp trên lớp với việc sử dụng hệ thống NTU E-learning."@vi .
}

ns1:TD1052_D04K01 {
    ns1:DaoTaoChinhQuy ns1:loaiKhaiNiem ns1:HinhThucDaoTao ;
        ns1:noiDung "Hoạt động giảng dạy được thực hiện tại Trường; thực hành, thực tập, trải nghiệm thực tế và giảng dạy trực tuyến có thể thực hiện ngoài Trường. Thời gian giảng dạy từ 06 giờ đến 20 giờ, từ thứ 2 đến thứ 7."@vi .
}

ns1:TD1052_D22K01dA {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:noiDung "Đến thời điểm xét tốt nghiệp không bị truy cứu trách nhiệm hình sự và không đang trong thời gian bị kỷ luật ở mức đình chỉ học tập."@vi .
}

ns1:TD1052_D09K02dA {
    ns1:ThuTucDangKyKhoiLuongHocTap ns1:noiDung "Tìm hiểu chương trình đào tạo, kế hoạch giảng dạy trong học kỳ và kiểm tra lại kết quả học tập để lập kế hoạch học tập phù hợp."@vi .
}

ns1:TD1052_D11K03 {
    ns1:ThuTucDangKyHocCaiThienDiem ns1:doAiThucHien ns1:SinhVien ;
        ns1:noiDung "Đăng ký học lại học phần hoặc đổi sang học phần khác trong nhóm tự chọn để cải thiện điểm trung bình chung tích lũy."@vi .
}

ns1:TD626_PLV {
    ns1:TrangThongTinTuyenSinh ns1:noiDung "Trang thông tin tuyển sinh của Trường Đại học Nha Trang có địa chỉ http://tuyensinh.ntu.edu.vn."@vi .
}

ns1:TD1052_D26K01dB {
    ns1:ThuTucChuyenTruong ns1:noiDung "Đạt điều kiện trúng tuyển của chương trình, ngành đào tạo cùng khóa tuyển sinh tại Trường xin chuyển đến."@vi .
}

ns1:TD1052_D26K01dD {
    ns1:ThuTucChuyenTruong ns1:noiDung "Được sự đồng ý của Hiệu trưởng cơ sở đào tạo xin chuyển đi và cơ sở đào tạo xin chuyển đến."@vi .
}

ns1:TDScholarshipCriteriaSpecificSection {
    ns1:ThuTucXetVaCapHocBongKhuyenKhichHocTap ns1:noiDung "Không hoãn thi trong kỳ, trừ trường hợp hoãn do trùng lịch thi và đã thi lại trong cùng đợt; học kỳ đầu sau khi chuyển ngành không được xét."@vi,
            "Mọi học phần trong kỳ phải đạt từ 5,5 điểm trở lên ngay ở lần thi đầu; điểm Giáo dục thể chất và Giáo dục quốc phòng không tính vào điểm xét."@vi,
            "Đăng ký tối thiểu 14 tín chỉ trong học kỳ theo kế hoạch của chương trình đào tạo."@vi .
}

ns1:TDNguon1052Khoan1Dieu26 {
    ns1:ThuTucChuyenTruong ns1:noiDung "Sinh viên được xét chuyển từ Trường Đại học Nha Trang đến cơ sở đào tạo khác và ngược lại (gọi tắt là chuyển trường) khi có đủ các điều kiện quy định tại khoản này."@vi .
}

ns1:TDTuitionPaymentGuidanceSection02 {
    ns1:MienPhiMobileBankingHoacInternetBanking ns1:apDungChoPhuongThucDong ns1:ThanhToanBangMobileBankingHoacInternetBanking ;
        ns1:loaiMucTien ns1:QuyTacLePhiDongHocPhi ;
        ns1:soTien "0"^^xsd:nonNegativeInteger .

    ns1:ThuTucNopHocPhi ns1:doAiThucHien ns1:SinhVien ;
        ns1:hoTroPhuongThuc ns1:ThanhToanBangMobileBankingHoacInternetBanking ;
        ns1:noiDung "Nếu có tài khoản Agribank, Vietinbank hoặc Liên Việt PostBank, dùng Mobile Banking hoặc Internet Banking để đóng học phí, miễn phí."@vi .

    ns1:NganHangAgribank ns1:loaiDanhMuc ns1:NganHang .

    ns1:NganHangLienVietPostbank ns1:loaiDanhMuc ns1:NganHang .

    ns1:NganHangVietinbank ns1:loaiDanhMuc ns1:NganHang .

    ns1:ThanhToanBangMobileBankingHoacInternetBanking ns1:hoTroNganHang ns1:NganHangAgribank,
            ns1:NganHangLienVietPostbank,
            ns1:NganHangVietinbank ;
        ns1:loaiDanhMuc ns1:PhuongThucDongHocPhi .
}

ns1:TDTuitionPaymentGuidanceSection01 {
    ns1:MienPhiThanhToanQr ns1:apDungChoPhuongThucDong ns1:ThanhToanBangMaQr ;
        ns1:loaiMucTien ns1:QuyTacLePhiDongHocPhi ;
        ns1:soTien "0"^^xsd:nonNegativeInteger .

    ns1:MienPhiVnpayDoiVoiTaiKhoanVietcombank ns1:apDungChoPhuongThucDong ns1:ThanhToanQuaCongVnpay ;
        ns1:loaiMucTien ns1:QuyTacLePhiDongHocPhi ;
        ns1:soTien "0"^^xsd:nonNegativeInteger .

    ns1:PhiVnpayDoiVoiNganHangKhac ns1:apDungChoPhuongThucDong ns1:ThanhToanQuaCongVnpay ;
        ns1:loaiMucTien ns1:QuyTacLePhiDongHocPhi ;
        ns1:soTien "5500"^^xsd:nonNegativeInteger .

    ns1:ThuTucNopHocPhi ns1:hoTroPhuongThuc ns1:ThanhToanBangMaQr,
            ns1:ThanhToanQuaCongVnpay ;
        ns1:noiDung "Truy cập sinhvien.ntu.edu.vn, chọn mục học phí và thanh toán qua cổng VnPay; miễn phí với tài khoản Vietcombank, các ngân hàng khác chịu phí 5.500 đồng mỗi lần. Có thể quét mã QR bằng ứng dụng ngân hàng, miễn phí."@vi .

    ns1:ThanhToanBangMaQr ns1:loaiDanhMuc ns1:PhuongThucDongHocPhi .

    ns1:ThanhToanQuaCongVnpay ns1:loaiDanhMuc ns1:PhuongThucDongHocPhi .
}

ns1:TDClassSizeTable {
    ns1:BangSiSoLopHocPhan ns1:noiDung """| **TT** | **Học phần** | **Số lượng sinh viên** | |
| :---: | :--- | :---: | :---: |
| | | **Tối thiểu** | **Tối đa** |
| 1 | Giáo dục tổng quát | 50 | 100 |
| 2 | Lý luận chính trị | 80 | * |
| 3 | - Ngoại ngữ B1.1, B1.2;<br>- HP chuyên ngữ ngành Ngôn ngữ Anh; | 40 | 50 |
| 4 | - Tiếng anh chuyên ngành | 50 | 60 |
| 5 | Khối kiến thức cơ sở, kiến thức ngành của Khoa Du lịch, Kinh tế, Kế toán – Tài chính và Luật | 50 | 80 |
| 6 | Khối kỹ thuật, công nghệ | 30 | 70 |
| 7 | Giáo dục thể chất | 60 | 80 (LT) |
| | | 45 | 60 (TH) |
| 8 | Giáo dục Quốc phòng – An ninh | 70 | * |
| | | 45 | 70 (TH) |
| 9 | Thực hành tại phòng máy CNC và công nghệ cao | 10 | 15 |
| 10 | Thực hành tại Xưởng Cơ khí, phòng thí nghiệm Nhiệt lạnh | 15 | 20 |
| 11 | Thực hành tại các phòng máy tính | 25 | 30 |
| 12 | Thực hành các học phần khác | 20 | 25 |"""@vi .
}

ns1:TD1052_D17K01dA {
    ns1:DieuKienDuThiHocPhanLyThuyet ns1:loaiQuyTac ns1:QuyTacDieuKienDuThi ;
        ns1:noiDung "Đối với học phần lý thuyết, sinh viên phải tham dự tối thiểu 80% tổng số giờ học của học phần và thực hiện đầy đủ các yêu cầu bắt buộc ghi trong Đề cương chi tiết học phần."@vi ;
        ns1:tyLeToiThieu 80.0 .

    ns1:ThuTucXinPhepNghiHoc ns1:noiDung "Với học phần lý thuyết, sinh viên phải tham dự tối thiểu 80% tổng số giờ học của học phần."@vi .
}

ns1:TD1052_D26K01dA {
    ns1:ThuTucChuyenTruong ns1:noiDung "Không đang là sinh viên năm thứ nhất hoặc năm cuối khóa, không thuộc diện bị xem xét buộc thôi học và còn đủ thời gian học tập theo quy định."@vi .
}

ns1:TD1052_D07K02dB {
    ns1:HocKyHe ns1:loaiKhaiNiem ns1:LoaiHocKy ;
        ns1:noiDung "Học kỳ III là học kỳ hè kéo dài tối đa 8 tuần, gồm tối đa 07 tuần học và 01 tuần thi. Học kỳ III tổ chức học tập trung các học phần Giáo dục quốc phòng - An ninh hoặc giúp sinh viên học vượt, học lại, học cải thiện."@vi .
}

ns1:TDNguon1052DiemBKhoan4Dieu27 {
    ns1:ThuTucDangKyChuongTrinhTraoDoiSinhVien ns1:noiDung "Sinh viên đăng ký học theo mẫu (Mẫu số 14 - Phụ lục 4 kèm theo) gửi về Đơn vị quản lý đào tạo."@vi .
}

ns1:TDNguon1052Khoan2Dieu9 {
    ns1:ThuTucDangKyKhoiLuongHocTap ns1:doAiThucHien ns1:SinhVien .
}

ns1:TDNguon1052Khoan1Dieu24 {
    ns1:ThuTucNghiHocTamThoi ns1:noiDung "Sinh viên được xin nghỉ học tạm thời và bảo lưu kết quả đã học trong các trường hợp quy định tại khoản này."@vi .
}

ns1:TD1052_D11K04 {
    ns1:ThuTucDangKyHocCaiThienDiem ns1:noiDung "Điểm tích lũy được ghi nhận theo lần học có điểm cao hơn."@vi .

    ns1:ThuTucDangKyHocLaiHocPhan ns1:noiDung "Kết quả học tập tích lũy được ghi nhận cho lần học cùng học phần có điểm cao hơn."@vi .
}

ns1:TDScholarshipAnnouncementSection {
    ns1:ThuTucXetVaCapHocBongKhuyenKhichHocTap ns1:doAiThucHien ns1:PhongCongTacChinhTriVaSinhVien,
            ns1:SinhVien ;
        ns1:duocXetBoi ns1:PhongCongTacChinhTriVaSinhVien ;
        ns1:noiDung "Phòng Công tác Chính trị và Sinh viên công bố danh sách dự kiến trên trang của phòng, tách riêng chương trình chuẩn và chương trình đào tạo đặc biệt. Sinh viên tự kiểm tra và gửi thắc mắc theo địa chỉ ghi trong thông báo."@vi,
            "Sinh viên có tên trong danh sách cung cấp số tài khoản Vietinbank và chi nhánh để nhận tiền, dùng địa chỉ thư điện tử do Trường cấp."@vi,
            "Thời hạn phản hồi ghi trong từng thông báo."@vi .
}

ns1:TDNguon1052DiemAKhoan3Dieu28 {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Sinh viên đăng ký học chương trình thứ hai vào đầu mỗi học kỳ chính theo thông báo hàng năm của Trường (Mẫu số 15 - Phụ lục 4 kèm theo)."@vi .
}

ns1:TD1052_D02K04dC {
    ns1:ThoiGianToiDaHoanThanhKhoaHoc ns1:loaiQuyTac ns1:QuyTacThoiGianDaoTao ;
        ns1:noiDung "Thời gian tối đa hoàn thành toàn khóa học không quá 2 lần thời gian theo kế hoạch học tập chuẩn toàn khóa."@vi .
}

ns1:TD1052_D17K02 {
    ns1:HauQuaCuaViecBiCamThiHoacVangThi ns1:loaiQuyTac ns1:QuyTacDieuKienDuThi ;
        ns1:noiDung "Sinh viên bị cấm thi hoặc vắng thi không có lý do chính đáng trong kỳ thi nào sẽ nhận điểm 0 ở kỳ thi đó."@vi .
}

ns1:TD1052_D31 {
    ns1:ChinhSachXuLySinhVienViPham ns1:noiDung "Sinh viên có gian lận trong học tập, kiểm tra và thi học phần sẽ bị xử lý kỷ luật đối với từng học phần đã vi phạm theo các quy định của Quy chế công tác sinh viên."@vi .
}

ns1:TD1052_D16K02dC {
    ns1:DiemI ns1:kyHieuDiemChu "I" ;
        ns1:loaiDanhMuc ns1:DiemChu ;
        ns1:noiDung "Điểm học phần chưa hoàn thiện do được phép hoãn thi, kiểm tra."@vi .

    ns1:DiemP ns1:kyHieuDiemChu "P" ;
        ns1:loaiDanhMuc ns1:DiemChu ;
        ns1:noiDung "Loại đạt không phân mức, áp dụng cho học phần chỉ yêu cầu đạt và không tính vào điểm trung bình học tập. Đạt từ 5 điểm trở lên."@vi .

    ns1:DiemR ns1:kyHieuDiemChu "R" ;
        ns1:loaiDanhMuc ns1:DiemChu ;
        ns1:noiDung "Điểm học phần bảo lưu được miễn học và công nhận tín chỉ."@vi .

    ns1:DiemX ns1:kyHieuDiemChu "X" ;
        ns1:loaiDanhMuc ns1:DiemChu ;
        ns1:noiDung "Điểm học phần chưa hoàn thiện do chưa đủ dữ liệu."@vi .

    ns1:ThangDiemDanhGia ns1:noiDung "Loại đạt có phân mức, áp dụng cho các học phần được tính vào điểm trung bình học tập: điểm học phần từ 5,0 điểm trở lên được đánh giá là đạt, điểm học phần dưới 5,0 điểm được đánh giá là không đạt."@vi .
}

ns1:TD1052_D22K01dB {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:noiDung "Tích lũy đủ số học phần và khối lượng học tập của chương trình đào tạo, đạt chuẩn đầu ra và các nội dung bắt buộc khác."@vi .
}

ns1:TD1052_D30K01 {
    ns1:ThuTucXinNghiOmTrongQuaTrinhHoc ns1:apDungChoTruongHop ns1:OmThaiSanHoacTaiNan ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:noiDung "Sinh viên xin nghỉ ốm trong quá trình học phải viết đơn xin phép gửi giảng viên giảng dạy học phần trong vòng 01 tuần kể từ ngày ốm, kèm theo Giấy chứng nhận của cơ sở y tế Trường hoặc cơ sở y tế xã, phường trở lên."@vi ;
        ns1:nopTai ns1:GiangVienGiangDayHocPhan ;
        ns1:thuTucTiepTheo ns1:ThuTucNghiHocTamThoi .

    ns1:ThuTucNghiHocTamThoi ns1:noiDung "Ốm phải điều trị dài ngày từ 10 ngày trở lên."@vi .
}

ns1:TD1052_D24K01dD {
    ns1:LyDoCaNhanKhac ns1:noiDung "Sinh viên nghỉ học tạm thời vì lý do cá nhân khác."@vi .

    ns1:ThuTucNghiHocTamThoi ns1:apDungChoTruongHop ns1:LyDoCaNhanKhac ;
        ns1:noiDung "Phải đã học ít nhất 01 học kỳ tại Trường và không thuộc diện bị xem xét buộc thôi học hoặc xem xét kỷ luật."@vi .
}

ns1:TDNguon1052Khoan1Dieu1 {
    ns1:TrinhDoDaiHoc ns1:loaiDanhMuc ns1:TrinhDoDaoTao .
}

ns1:TD1052_D21K06 {
    ns1:ThuTucXinMienHocMienThiVaCongDiemThuong ns1:canBieuMau ns1:MauSo07DonXinMienHocMienThiVaCongDiemThuong ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo07DonXinMienHocMienThiVaCongDiemThuong ;
        ns1:noiDung "Sinh viên có nguyện vọng miễn học, miễn thi và cộng điểm thưởng phải nộp đơn theo mẫu (Mẫu số 07 - Phụ lục 4 kèm theo) kèm theo minh chứng hợp lệ gửi về Đơn vị quản lý đào tạo để được xem xét giải quyết."@vi ;
        ns1:nopTai ns1:PhongDaoTaoDaiHoc .

    ns1:MauSo07DonXinMienHocMienThiVaCongDiemThuong ns1:soHieuMauTheoQuyetDinh "07" .
}

ns1:TD1052_D13K02 {
    ns1:TyLeToiDaDaoTaoTrucTuyen ns1:loaiQuyTac ns1:QuyTacTyLeDaoTaoTrucTuyen ;
        ns1:noiDung "Nhà trường áp dụng tối đa 30% tổng khối lượng chương trình đào tạo cho hoạt động dạy học trực tuyến. Trong trường hợp thiên tai, dịch bệnh phức tạp hoặc bất khả kháng khác, Nhà trường thực hiện theo hướng dẫn của Bộ Giáo dục và Đào tạo."@vi ;
        ns1:tyLeToiDa 30.0 .
}

ns1:TD1052_D28K01dB {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Học lực theo điểm trung bình tích lũy xếp loại khá trở lên và đáp ứng ngưỡng bảo đảm chất lượng của chương trình thứ hai; hoặc xếp loại trung bình và đáp ứng điều kiện trúng tuyển của chương trình thứ hai trong năm tuyển sinh."@vi .
}

ns1:TD1052_D21K04 {
    ns1:GioiHanKhoiLuongDuocCongNhanVaChuyenDoi ns1:loaiQuyTac ns1:QuyTacGioiHanCongNhanVaChuyenDoiTinChi ;
        ns1:noiDung "Khối lượng tối đa được công nhận kết quả học tập và chuyển đổi không vượt quá 50% khối lượng học tập tối thiểu của chương trình đào tạo."@vi ;
        ns1:tyLeToiDa 50.0 .

    ns1:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi ns1:noiDung "Khối lượng được công nhận và chuyển đổi không vượt quá 50% khối lượng học tập tối thiểu của chương trình đào tạo."@vi .
}

ns1:TDNguonHuongDanDongHocPhiQuaCongThanhToanVnpayVietcombankBuoc1 {
    ns1:CongThongTinSinhVien ns1:noiDung "Sinh viên đăng nhập vào trang https://sinhvien.ntu.edu.vn bằng tài khoản mã sinh viên (không vào trang https://qldt.ntu.edu.vn) và chọn ô Học phí."@vi .
}

ns1:TDOtherLanguageRequirementTableSpecialProgram {
    ns1:BangChuanNgoaiNguKhacChuongTrinhDacBiet ns1:loaiBang ns1:BangQuyDoiChungChi ;
        ns1:noiDung """| TT | Chương trình | Tiếng Trung (HSK) | Tiếng Trung (TOCFL) | Tiếng Nhật (JLPT) | Tiếng Nhật (JPT) | Tiếng Nga (TPKN) | Tiếng Pháp (DELF) | Tiếng Pháp (TCF) | Tiếng Hàn (TOPIK) |
| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |
| 1 | Công nghệ thông tin | HSK 3 | TOCFL 2 | N4 | 469 | TRKI 1 | B1 | ≥ 320 | TOPIK 3 |
| 2 | Kế toán | HSK 3 | TOCFL 2 | N4 | 469 | TRKI 1 | B1 | ≥ 320 | TOPIK 3 |
| 3 | Tài chính - Ngân hàng | HSK 3 | TOCFL 2 | N4 | 469 | TRKI 1 | B1 | ≥ 320 | TOPIK 3 |
| 4 | Quản trị khách sạn | HSK 4 | TOCFL 3 | N3 | 610 | TRKI 2 | B2 | ≥ 400 | TOPIK 3 |
| 5 | Quản trị kinh doanh | HSK 4 | TOCFL 3 | N3 | 610 | TRKI 2 | B2 | ≥ 400 | TOPIK 3 |
| 6 | Quản trị dịch vụ du lịch và lữ hành | HSK 4 | TOCFL 3 | N3 | 610 | TRKI 2 | B2 | ≥ 400 | TOPIK 3 |"""@vi .
}

ns1:TD1052_D11K01 {
    ns1:ThuTucDangKyHocLaiHocPhan ns1:doAiThucHien ns1:SinhVien ;
        ns1:noiDung "Sinh viên có học phần bắt buộc bị điểm dưới 5,0 phải đăng ký học lại học phần đó ở các học kỳ tiếp theo cho đến khi đạt điểm bằng hoặc lớn hơn 5,0."@vi .
}

ns1:TDGraduationClassificationTable {
    ns1:BangXepHangTotNghiep ns1:noiDung """| **TT.** | **Điểm trung bình chung tích lũy của toàn khoá** | **Xếp loại** |
| :---: | :---: | :---: |
| 1 | 9,00 ÷ 10 | Xuất sắc |
| 2 | 8,00 ÷ 8,99 | Giỏi |
| 3 | 7,00 ÷ 7,99 | Khá |
| 4 | 5,50 ÷ 6,99 | Trung bình |"""@vi .
}

ns1:TD1052_D09K02dC {
    ns1:ThuTucDangKyKhoiLuongHocTap ns1:noiDung "Xin ý kiến tư vấn của Cố vấn học tập trước khi đăng ký các lớp học phần."@vi .
}

ns1:TD1052_D07K02dA {
    ns1:HocKyChinh ns1:loaiKhaiNiem ns1:LoaiHocKy ;
        ns1:noiDung "Học kỳ I và học kỳ II kéo dài ít nhất 19 tuần, bao gồm 14 tuần học (trong đó có 01 tuần học số), 01 tuần thi giữa kỳ, 02 tuần thi cuối kỳ, 01 tuần chấm thi giữa kỳ và 01 tuần chấm thi cuối kỳ."@vi .
}

ns1:TD1052_D21K03 {
    ns1:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi ns1:duocXetBoi ns1:HoiDongChuyenMon ;
        ns1:noiDung "Hội đồng chuyên môn của Nhà trường hoặc Đơn vị quản lý đào tạo phối hợp với Khoa/viện xem xét công nhận, chuyển đổi tín chỉ trên cơ sở đối sánh chuẩn đầu ra, nội dung và khối lượng học tập, cách thức đánh giá học phần và các điều kiện bảo đảm chất lượng thực hiện chương trình."@vi,
            "Kết quả được công nhận và chuyển đổi theo từng học phần, theo từng nhóm học phần, hoặc theo cả chương trình đào tạo."@vi .
}

ns1:TD1052_D24K01dB {
    ns1:DuocDieuDongDuThiGiaiDauQuocTe ns1:noiDung "Sinh viên được cơ quan có thẩm quyền điều động, đại diện quốc gia tham dự các kỳ thi, giải đấu quốc tế."@vi .

    ns1:ThuTucNghiHocTamThoi ns1:apDungChoTruongHop ns1:DuocDieuDongDuThiGiaiDauQuocTe .
}

ns1:TD1052_D02K04dA {
    ns1:ThoiGianDaoTaoChuanToanKhoa ns1:loaiQuyTac ns1:QuyTacThoiGianDaoTao ;
        ns1:noiDung "Thời gian theo kế hoạch học tập chuẩn toàn khóa cho một chương trình đại học chính quy cấp bằng cử nhân là 4 năm, chương trình chuyên sâu đặc thù cấp bằng kỹ sư là 4,5 năm."@vi .
}

ns1:TDOtherLanguageConversionTableStandardProgram {
    ns1:BangQuyDoiNgoaiNguKhacChuongTrinhChuan ns1:loaiBang ns1:BangQuyDoiChungChi ;
        ns1:noiDung """| Khung NLNN 6 bậc | Tiếng Trung (HSK) | Tiếng Trung (TOCFL) | Tiếng Nhật (JLPT) | Tiếng Nhật (JPT) | Tiếng Nga (TPKN) | Tiếng Pháp (DELF) | Tiếng Pháp (TCF) | Tiếng Hàn (TOPIK) | Tiếng Hàn (KLPT) | Quy đổi thành điểm 10 |
| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |
| Bậc 1 | HSK 1 | TOCFL 1 | N6 | < 315 | TEU | A1 | > 100 | TOPIK 1 | 200 | |
| Bậc 2 | HSK 2 | TOCFL 2 | N5 | 315 | TBU | A2 | > 200 | TOPIK 2 | ≥ 250 | Đạt học phần điều kiện: A1, A2.1, A2.2 |
| Bậc 3 | HSK 3 | TOCFL 3 | N4 | 469 | TRKI 1 | B1 | ≥ 300 | TOPIK 3 | > 300 | |
| Bậc 4 | HSK 4 | TOCFL 4 | N3 | 610 | TRKI 2 | B2 | ≥ 400 | TOPIK 4 | ≥ 350 | Đạt học phần điều kiện: Ngoại ngữ B1.1, B1.2 |
| Bậc 5 | | | N2 | 740 | TRKI 3 | | | TOPIK 5 | > 400 | |
| Bậc 6 | | | N1 | 880 | TRKI 4 | | | TOPIK 6 | > 450 | |"""@vi .
}

ns1:TD1052_D24K03 {
    ns1:ThuTucXinHocTroLai ns1:canBieuMau ns1:MauSo11DonXinHocTroLai ;
        ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo11DonXinHocTroLai ;
        ns1:noiDung "Khi muốn trở lại học tiếp, sinh viên cần viết đơn (Mẫu số 11 - Phụ lục 4 kèm theo) gửi Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên ít nhất 02 tuần trước khi bắt đầu học kỳ mới để được xem xét giải quyết."@vi ;
        ns1:nopTai ns1:PhongCongTacChinhTriVaSinhVien .

    ns1:ThuTucXinThoiHoc ns1:canBieuMau ns1:MauSo10DonXinThoiHoc ;
        ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo10DonXinThoiHoc ;
        ns1:noiDung "Sinh viên xin thôi học phải viết đơn (Mẫu số 10 - Phụ lục 4 kèm theo) gửi Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên."@vi ;
        ns1:nopTai ns1:PhongCongTacChinhTriVaSinhVien .

    ns1:MauSo10DonXinThoiHoc ns1:soHieuMauTheoQuyetDinh "10" .

    ns1:MauSo09DonXinNghiHocTamThoi ns1:soHieuMauTheoQuyetDinh "09" .

    ns1:MauSo11DonXinHocTroLai ns1:soHieuMauTheoQuyetDinh "11" .

    ns1:ThuTucNghiHocTamThoi ns1:canBieuMau ns1:MauSo09DonXinNghiHocTamThoi ;
        ns1:doAiQuyetDinh ns1:HieuTruong ;
