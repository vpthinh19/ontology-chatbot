ns1:TD1052_D24K01dC {
    ns1:ThuTucNghiHocTamThoi ns1:apDungChoTruongHop ns1:OmThaiSanHoacTaiNan ;
        ns1:noiDung "Bị ốm, thai sản hoặc tai nạn phải điều trị thời gian dài, có giấy chứng nhận của cơ sở khám bệnh, chữa bệnh có thẩm quyền theo quy định của Bộ Y tế."@vi .

    ns1:OmThaiSanHoacTaiNan ns1:noiDung "Sinh viên bị ốm, thai sản hoặc tai nạn trong quá trình học."@vi .
}

ns1:TD1052_D14K01 {
    ns1:ThuTucDangKyThucHienDoAnTotNghiep ns1:noiDung "Sinh viên được xếp hạng năm thứ 4 phải thực hiện đồ án/khóa luận tốt nghiệp hoặc các chuyên đề tốt nghiệp để hoàn thành khóa học."@vi .
}

ns1:TD1052_D14K02 {
    ns1:ThuTucDangKyThucHienDoAnTotNghiep ns1:canBieuMau ns1:MauSo02DonDangKyThucHienDoAnTotNghiep ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo02DonDangKyThucHienDoAnTotNghiep ;
        ns1:noiDung "Sinh viên đủ điều kiện thực hiện đồ án/khóa luận tốt nghiệp theo quy định của Trường phải làm đơn đăng ký thực hiện đồ án/khóa luận tốt nghiệp (Mẫu số 02 - Phụ lục 4 kèm theo)."@vi .

    ns1:MauSo02DonDangKyThucHienDoAnTotNghiep ns1:soHieuMauTheoQuyetDinh "02" .
}

ns1:TD1052_D22K03 {
    ns1:ThuTucDeNghiXetTotNghiepSom ns1:duocXetBoi ns1:HoiDongXetTotNghiep .

    ns1:ThuTucXetVaCongNhanTotNghiep ns1:doAiThucHien ns1:HoiDongXetTotNghiep ;
        ns1:duocXetBoi ns1:HoiDongXetTotNghiep ;
        ns1:noiDung "Hội đồng xét tốt nghiệp lập danh sách những sinh viên đủ điều kiện tốt nghiệp sau mỗi quý."@vi .
}

ns1:TD1052_D20K01dA {
    ns1:CanhBaoDoNoTinChi ns1:loaiQuyTac ns1:QuyTacCanhBaoKetQuaHocTap ;
        ns1:noiDung "Tổng số tín chỉ không đạt trong học kỳ vượt quá 50% khối lượng đã đăng ký trong học kỳ, hoặc tổng số tín chỉ nợ đọng từ đầu khóa học vượt quá 24."@vi .
}

ns1:TD1052_D25K01dB {
    ns1:ThuTucChuyenNganh ns1:noiDung "Đạt điều kiện trúng tuyển của chương trình, ngành đào tạo xin chuyển đến trong cùng khóa tuyển sinh."@vi .
}

ns1:TD1052_D22K05 {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:noiDung "Những sinh viên đủ điều kiện tốt nghiệp được Hiệu trưởng ra quyết định công nhận tốt nghiệp và cấp bằng tốt nghiệp trong thời hạn 03 tháng tính từ thời điểm sinh viên đáp ứng đầy đủ điều kiện tốt nghiệp và hoàn thành nghĩa vụ với Trường."@vi .
}

ns1:TD1052_D21K02 {
    ns1:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi ns1:canBieuMau ns1:MauSo06DonXinMienHocVaQuyDoiDiemHocPhan ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo06DonXinMienHocVaQuyDoiDiemHocPhan ;
        ns1:noiDung "Sinh viên có nguyện vọng miễn học và quy đổi điểm học phần phải nộp bản sao có công chứng văn bằng, chứng chỉ và bảng điểm cho Đơn vị quản lý đào tạo (Mẫu số 06 - Phụ lục 4 kèm theo)."@vi ;
        ns1:nopTai ns1:PhongDaoTaoDaiHoc .

    ns1:MauSo06DonXinMienHocVaQuyDoiDiemHocPhan ns1:soHieuMauTheoQuyetDinh "06" .
}

ns1:TD1052_D24K01dA {
    ns1:DuocDieuDongVaoLucLuongVuTrang ns1:noiDung "Sinh viên được điều động vào lực lượng vũ trang."@vi .

    ns1:ThuTucNghiHocTamThoi ns1:apDungChoTruongHop ns1:DuocDieuDongVaoLucLuongVuTrang .
}

