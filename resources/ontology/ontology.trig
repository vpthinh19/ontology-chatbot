ns1:TD1052_D21K07 {
    ns1:ThoiHanHieuLucCuaHocPhanDuocCongNhan ns1:loaiQuyTac ns1:QuyTacGioiHanCongNhanVaChuyenDoiTinChi ;
        ns1:noiDung "Nhà trường chỉ cho phép công nhận kết quả học tập, miễn học, miễn thi, điểm thưởng và chuyển đổi tín chỉ của học phần được tích lũy trong vòng 5 năm tính đến ngày xem xét."@vi ;
        ns1:soNam 5.0 .

    ns1:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi ns1:noiDung "Chỉ công nhận học phần được tích lũy trong vòng 5 năm tính đến ngày xem xét."@vi .
}

ns1:TDNguon1052DiemBKhoan3Dieu28 {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Khi có Quyết định chấp thuận học cùng lúc hai chương trình, được Nhà trường cung cấp một mã số sinh viên riêng, sinh viên tự nghiên cứu chương trình đào tạo của ngành thứ hai và bổ sung các học phần cần phải học vào kế hoạch học tập để đăng ký học phần bằng mã số sinh viên của chương trình thứ hai."@vi .
}

ns1:TD1052_D28K01dA {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Đã được xếp từ trình độ năm thứ hai trở lên của chương trình thứ nhất."@vi .
}

ns1:TD1052_D20K02dA {
    ns1:BuocThoiHocDoCanhBaoLienTiep ns1:loaiQuyTac ns1:QuyTacBuocThoiHoc ;
        ns1:noiDung "Sinh viên bị buộc thôi học nếu vượt quá 02 lần cảnh báo kết quả học tập liên tiếp."@vi .
}

ns1:TD1052_D28K05 {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Đăng ký muộn nhất 02 năm trước thời điểm xét tốt nghiệp chương trình thứ hai, và chỉ được xét tốt nghiệp chương trình thứ hai khi đã đủ điều kiện tốt nghiệp chương trình thứ nhất."@vi .
}

ns1:TD1052_D16K02dB {
    ns1:ThangDiemDanhGia ns1:noiDung "Điểm đánh giá học phần được chấm theo thang điểm 10 (từ 0,0 đến 10), làm tròn đến một chữ số thập phân."@vi .
}

ns1:TD1052_D25K02 {
    ns1:MauSo12DonXinChuyenNganh ns1:soHieuMauTheoQuyetDinh "12" .

    ns1:ThuTucChuyenNganh ns1:canBieuMau ns1:MauSo12DonXinChuyenNganh ;
        ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo12DonXinChuyenNganh ;
        ns1:noiDung "Sinh viên có nguyện vọng và thỏa mãn các điều kiện tại khoản 1 của Điều này có thể được xem xét chuyển ngành trong cùng bậc học."@vi,
            "Ít nhất 02 tuần trước khi bắt đầu học kỳ mới, sinh viên làm đơn xin chuyển ngành (Mẫu số 12 - Phụ lục 4 kèm theo) để trình Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên xem xét quyết định."@vi ;
        ns1:nopTai ns1:PhongCongTacChinhTriVaSinhVien .
}

ns1:TD1052_D03K01 {
    ns1:PhuongThucToChucDaoTaoTheoTinChi ns1:noiDung "Phương thức tổ chức đào tạo theo tín chỉ là cách thức tổ chức đào tạo theo từng lớp học phần, cho phép sinh viên tích lũy tín chỉ của từng học phần và thực hiện chương trình đào tạo theo kế hoạch học tập của cá nhân, phù hợp với kế hoạch giảng dạy của Trường."@vi .
}

ns1:TD1052_D14K03 {
    ns1:ThuTucDangKyThucHienDoAnTotNghiep ns1:noiDung "Sinh viên không đủ điều kiện thực hiện đồ án tốt nghiệp phải làm các chuyên đề tốt nghiệp hoặc học các học phần tốt nghiệp theo quy định của chương trình đào tạo."@vi .
}

ns1:TD1052_D25K01dC {
    ns1:ThuTucChuyenNganh ns1:noiDung "Được sự đồng ý của Trưởng Khoa hoặc viện của ngành đang học và ngành xin chuyển đến."@vi .
}

ns1:TDScholarshipRateTableStandardProgram {
    ns1:BangMucHocBongChuongTrinhChuan ns1:noiDung """| STT | Xếp loại học bổng | Học bổng 05 tháng / học kỳ (VNĐ) |
| :---: | :--- | :---: |
| 1 | Xuất sắc | 7.200.000 |
| 2 | Giỏi | 6.000.000 |
| 3 | Khá | 5.000.000 |"""@vi .

    ns1:HocBongKhuyenKhichHocTapLoaiGioiChuongTrinhChuan ns1:apDungChoTrinhDo ns1:TrinhDoDaiHoc ;
        ns1:donViTienTe "VND" ;
        ns1:donViTinh ns1:DongTrenHocKy ;
        ns1:loaiMucTien ns1:MucHocBongKhuyenKhichHocTap ;
        ns1:noiDung "Chương trình đào tạo chuẩn, cấp 05 tháng trên một học kỳ"@vi ;
        ns1:soTien "6000000"^^xsd:nonNegativeInteger .

    ns1:HocBongKhuyenKhichHocTapLoaiKhaChuongTrinhChuan ns1:apDungChoTrinhDo ns1:TrinhDoDaiHoc ;
        ns1:donViTienTe "VND" ;
        ns1:donViTinh ns1:DongTrenHocKy ;
        ns1:loaiMucTien ns1:MucHocBongKhuyenKhichHocTap ;
        ns1:noiDung "Chương trình đào tạo chuẩn, cấp 05 tháng trên một học kỳ"@vi ;
        ns1:soTien "5000000"^^xsd:nonNegativeInteger .

    ns1:HocBongKhuyenKhichHocTapLoaiXuatSacChuongTrinhChuan ns1:apDungChoTrinhDo ns1:TrinhDoDaiHoc ;
        ns1:donViTienTe "VND" ;
        ns1:donViTinh ns1:DongTrenHocKy ;
        ns1:loaiMucTien ns1:MucHocBongKhuyenKhichHocTap ;
        ns1:noiDung "Chương trình đào tạo chuẩn, cấp 05 tháng trên một học kỳ"@vi ;
        ns1:soTien "7200000"^^xsd:nonNegativeInteger .

    ns1:ThuTucXetVaCapHocBongKhuyenKhichHocTap ns1:noiDung "Học bổng khuyến khích học tập cho sinh viên đại học hệ đào tạo chính quy có kết quả học tập và rèn luyện đạt từ mức khá trở lên được cấp theo ba mức ứng với xếp loại xuất sắc, giỏi, khá."@vi .

    ns1:DongTrenHocKy ns1:loaiDanhMuc ns1:DonViTinh .
}

ns1:TD1052_D05K01 {
    ns1:TinChi ns1:noiDung "Tín chỉ là đơn vị tính khối lượng học tập của người học, bao gồm khối lượng kiến thức và kỹ năng mà người học cần tích lũy trong một khoảng thời gian nhất định."@vi .
}

ns1:TDAcademicPerformanceTable {
    ns1:BangXepLoaiHocLuc ns1:noiDung """| **Điểm trung bình chung** | **Mức xếp loại** |
| :---: | :---: |
| 9,00 ÷ 10 | Xuất sắc |
| 8,00 ÷ 8,99 | Giỏi |
| 7,00 ÷ 7,99 | Khá |
| 5,00 ÷ 6,99 | Trung bình |
| 4,00 ÷ 4,99 | Yếu |
| 0,00 ÷ 3,99 | Kém |"""@vi .
}

ns1:TD1052_D06K02dI {
    ns1:HocPhanThayThe ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần được dùng thay cho một học phần có trong chương trình đào tạo khóa trước nhưng khóa sau không còn tổ chức đào tạo, hoặc học phần tự chọn thay cho học phần tự chọn khác mà sinh viên học không đạt."@vi .
}

ns1:TD1052_D06K02dA {
    ns1:HocPhanBatBuoc ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần chứa đựng những nội dung kiến thức chính yếu của mỗi chương trình đào tạo và bắt buộc sinh viên phải tích lũy."@vi .
}

ns1:TDNguon1052Khoan1Dieu21 {
    ns1:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:noiDung "Kết quả học tập của sinh viên đã tích lũy từ một trình độ đào tạo khác, một ngành đào tạo hoặc chương trình đào tạo khác, một khóa học khác, hoặc một cuộc thi và hoạt động học thuật, hoặc từ một trường khác được Hiệu trưởng Trường Đại học Nha Trang xem xét công nhận bảo lưu và chuyển đổi sang tín chỉ của những học phần trong chương trình đào tạo theo học."@vi .
}

ns1:TD1052_D10K02 {
    ns1:BoMon ns1:loaiChuThe ns1:DonViTrongTruong .

    ns1:ThuTucDeNghiMoThemLopHocPhan ns1:duocXetBoi ns1:BoMon ;
        ns1:noiDung "Trong thời gian đăng ký học phần, nếu số lượng sinh viên đăng ký đạt đủ điều kiện mở lớp theo quy định và được Bộ môn (thuộc Khoa, Viện đào tạo) quản lý chấp thuận, Nhà trường sẽ mở thêm lớp học phần theo đề nghị."@vi .
}

ns1:TDTuitionPaymentGuidanceSection03 {
    ns1:MienPhiNopTienMatTaiQuayONhaTrang ns1:apDungChoPhuongThucDong ns1:NopTienMatTaiQuayNganHang ;
        ns1:loaiMucTien ns1:QuyTacLePhiDongHocPhi ;
        ns1:soTien "0"^^xsd:nonNegativeInteger .

    ns1:PhiNopTienMatTaiHuyenTrongKhanhHoaHoacNgoaiTinhLa3300Hoac5500DongMoiLan ns1:apDungChoPhuongThucDong ns1:NopTienMatTaiQuayNganHang ;
        ns1:loaiMucTien ns1:QuyTacLePhiDongHocPhi ;
        ns1:soTien "3300"^^xsd:nonNegativeInteger,
            "5500"^^xsd:nonNegativeInteger .

    ns1:ThuTucNopHocPhi ns1:hoTroPhuongThuc ns1:NopTienMatTaiQuayNganHang ;
        ns1:noiDung "Đến quầy giao dịch Agribank, Vietinbank hoặc Liên Việt PostBank nộp tiền mặt và cung cấp mã sinh viên cho ngân hàng tra cứu; tuyệt đối không cung cấp số tài khoản của Trường cho ngân hàng."@vi .

    ns1:NopTienMatTaiQuayNganHang ns1:hoTroNganHang ns1:NganHangAgribank,
            ns1:NganHangLienVietPostbank,
            ns1:NganHangVietinbank ;
        ns1:loaiDanhMuc ns1:PhuongThucDongHocPhi .
}

ns1:TD1052_D25K01dD {
    ns1:ThuTucChuyenNganh ns1:noiDung "Nhà trường có đủ điều kiện bảo đảm chất lượng và chưa vượt quá năng lực đào tạo của ngành xin chuyển đến."@vi .
}

ns1:TD1052_D04K02 {
    ns1:DaoTaoVuaLamVuaHoc ns1:loaiKhaiNiem ns1:HinhThucDaoTao ;
        ns1:noiDung "Hoạt động giảng dạy được thực hiện tại Trường hoặc tại cơ sở phối hợp đào tạo. Thời gian giảng dạy linh hoạt trong ngày và trong tuần."@vi .
}

ns1:TD1052_D06K02dC {
    ns1:HocPhanTienQuyet ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần sinh viên phải tích lũy mới được học các học phần tiếp theo."@vi .
}

ns1:TD1052_D22K01dE {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:noiDung "Hoàn thành các nghĩa vụ khác theo quy định của Trường như trả sách thư viện, quyết toán đề tài nghiên cứu khoa học và học phí."@vi .
}

ns1:TD1052_D02K04dB {
    ns1:ThoiGianDaoTaoHinhThucVuaLamVuaHoc ns1:apDungChoHinhThucDaoTao ns1:DaoTaoVuaLamVuaHoc ;
        ns1:loaiQuyTac ns1:QuyTacThoiGianDaoTao ;
        ns1:noiDung "Hệ vừa làm vừa học có thời gian học chuẩn toàn khóa dài hơn hệ chính quy cùng ngành ít nhất 20%."@vi ;
        ns1:tyLeToiThieu 20.0 .
}

ns1:TD1052_D06K02dD {
    ns1:HocPhanNhiemY ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần sinh viên có thể tự do đăng ký học theo nhu cầu cá nhân. Kết quả được ghi trong bảng điểm nhưng không tính vào trung bình chung tích lũy và không dùng để phân loại, xếp hạng học tập."@vi .
}

ns1:TD1052_D21K05 {
    ns1:ThuTucXinMienHocMienThiVaCongDiemThuong ns1:noiDung "Sinh viên được xem xét miễn học, miễn thi kết thúc học phần liên quan và cho điểm thưởng trong các trường hợp: đạt giải thưởng nhất, nhì, ba trong các kỳ thi Olympic sinh viên cấp tỉnh và tương đương trở lên; đạt giải thưởng nhất, nhì, ba trong đợt xét Giải thưởng khoa học và công nghệ dành cho sinh viên; có chứng chỉ ngoại ngữ quốc tế còn hiệu lực, đáp ứng các mức yêu cầu theo quy định chi tiết tại Phụ lục 2; có chứng chỉ tin học quốc tế còn hiệu lực, đáp ứng các mức yêu cầu theo quy định chi tiết tại Phụ lục 3."@vi .
}

ns1:TD1052_D15K01 {
    ns1:ThangDiemDanhGia ns1:noiDung "Nhà trường sử dụng thang điểm 10 để đánh giá kết quả học tập."@vi .
}

ns1:TD1052_D28K02 {
    ns1:ThuTucDangKyHocCungLucHaiChuongTrinh ns1:noiDung "Nếu điểm trung bình chung học kỳ của chương trình thứ nhất đạt dưới 5,50 thì phải dừng học chương trình thứ hai ở học kỳ tiếp theo cho đến khi kết quả được cải thiện."@vi .
}

ns1:TD1052_D26K01dC {
    ns1:ThuTucChuyenTruong ns1:noiDung "Nơi chuyển đến có đủ điều kiện bảo đảm chất lượng và chưa vượt quá năng lực đào tạo đối với chương trình, ngành đào tạo đó."@vi .
}

ns1:TD1052_D17K04 {
    ns1:ThuTucXinHoanThi ns1:noiDung "Sinh viên đủ điều kiện dự thi nhưng không thể dự thi cuối kỳ do bị ốm, tai nạn hoặc vì lý do đặc biệt khác được phép hoãn thi và được dự thi cuối kỳ học phần đó trong thời hạn 2 học kỳ chính tiếp theo để hoàn thành điểm, quá thời hạn trên điểm đánh giá cuối kỳ sẽ là điểm 0 (không). Sinh viên làm đơn xin hoãn thi theo mẫu (Mẫu số 04 - Phụ lục 4 kèm theo) gửi về Đơn vị quản lý đào tạo để được giải quyết."@vi .
}

ns1:TD1052_D22K01dC {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:noiDung "Điểm trung bình chung tích lũy toàn khóa học đạt từ 5,50 trở lên."@vi .
}

ns1:TD1052_D27K02 {
    ns1:GioiHanTinChiTichLuyTaiTruongKhac ns1:loaiQuyTac ns1:QuyTacGioiHanCongNhanVaChuyenDoiTinChi ;
        ns1:noiDung "Sinh viên tham gia chương trình trao đổi có thể đăng ký học một số học phần tại trường khác với số lượng tín chỉ tích lũy tại trường khác không vượt quá 25% tổng khối lượng của chương trình đào tạo."@vi ;
        ns1:tyLeToiDa 25.0 .

    ns1:ThuTucDangKyChuongTrinhTraoDoiSinhVien ns1:noiDung "Số tín chỉ tích lũy tại trường khác không vượt quá 25% tổng khối lượng của chương trình đào tạo."@vi .
}

ns1:TD1052_D29K03 {
    ns1:ThuTucHocLienThong ns1:noiDung "Sau khi trúng tuyển, thực hiện chương trình đào tạo và đăng ký học tập theo kế hoạch chung như các sinh viên khác cùng hình thức đào tạo."@vi ;
        ns1:thuTucTiepTheo ns1:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi .
}

ns1:TD1052_D22K01dDD {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:noiDung "Hoàn thành các học phần Giáo dục quốc phòng - An ninh, Giáo dục thể chất và các học phần điều kiện khác nếu có."@vi .
}

ns1:TDComputerCertificateConversionTable {
    ns1:BangQuyDoiChungChiTinHoc ns1:loaiBang ns1:BangQuyDoiChungChi ;
        ns1:noiDung """| TT | Điểm IC3 | Điểm ICDL | Điểm MOS | Điểm quy đổi / Điểm thưởng |
| :--- | :--- | :--- | :--- | :--- |
| 1 | 1990 - 2329 | 1350 - 1445 | 1400 - 1599 | 8 |
| 2 | 2330 - 2669 | 1446 - 1620 | 1600 - 1799 | 9 |
| 3 | 2670 - 3000 | 1621 - 1800 | 1800 - 2000 | 10 |"""@vi .

    ns1:Ic3 ns1:loaiChungChi ns1:ChungChiTinHoc .

    ns1:Icdl ns1:loaiChungChi ns1:ChungChiTinHoc .

    ns1:Mos ns1:loaiChungChi ns1:ChungChiTinHoc .
}

ns1:TD1052_D23K03dB {
    ns1:HaHangTotNghiepDoBiKyLuat ns1:loaiQuyTac ns1:QuyTacHaHangTotNghiep ;
        ns1:noiDung "Hạng tốt nghiệp của sinh viên có điểm trung bình chung tích lũy loại xuất sắc và giỏi bị giảm đi một mức nếu sinh viên đã bị kỷ luật từ mức cảnh cáo trở lên trong thời gian học."@vi .
}

ns1:TD753_D10K01 {
    ns1:ThuTucRutBotHocPhanDaDangKy ns1:noiDung "Sau thời gian đăng ký học, nếu sinh viên xét thấy không thể hoàn thành khối lượng học tập đã đăng ký thì có thể làm đơn xin rút bớt (hủy) một hoặc một số học phần đã đăng ký với điều kiện không vi phạm giới hạn tối thiểu quy định tại khoản 3, khoản 4 Điều 9 của Quy chế này."@vi .
}

ns1:TD1052_D20K03 {
    ns1:ThuTucXinChuyenChuongTrinhDaoTaoKhiThuocDienBuocThoiHoc ns1:canBieuMau ns1:MauSo05DonXinChuyenChuongTrinhDaoTao ;
        ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo05DonXinChuyenChuongTrinhDaoTao ;
        ns1:noiDung "Những sinh viên thuộc diện bị buộc thôi học quy định tại khoản 2 Điều này được quyền viết đơn (Mẫu số 05 - Phụ lục 4 kèm theo) gửi Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên để được xem xét chuyển qua chương trình đào tạo theo hình thức vừa làm vừa học tương ứng tổ chức tại Trường."@vi,
            "Sinh viên được xem xét bảo lưu một phần kết quả học tập ở chương trình cũ đối với các học phần đạt mức điểm 5,0 trở lên khi học ở chương trình mới. Tùy thuộc vào thời gian xin chuyển chương trình đào tạo, Nhà trường xem xét quyết định cho bảo lưu kết quả học tập đối với từng trường hợp cụ thể."@vi ;
        ns1:nopTai ns1:PhongCongTacChinhTriVaSinhVien .

    ns1:MauSo05DonXinChuyenChuongTrinhDaoTao ns1:soHieuMauTheoQuyetDinh "05" .
}

ns1:TDNguon1052Khoan1Dieu27 {
    ns1:ThuTucDangKyChuongTrinhTraoDoiSinhVien ns1:noiDung "Trao đổi sinh viên là việc Nhà trường hợp tác với các trường khác để tiếp nhận sinh viên của nhau đến học tập ở trường đối tác nhằm công nhận kết quả học tập và tín chỉ lẫn nhau (sau đây gọi là chương trình trao đổi sinh viên)."@vi .
}

ns1:TDNguon1052Khoan1Dieu9 {
    ns1:ThuTucDangKyKhoiLuongHocTap ns1:noiDung "Đăng ký khối lượng học tập từng học kỳ là yêu cầu bắt buộc của mỗi sinh viên trước khi bắt đầu một học kỳ mới."@vi .
}

ns1:TD1052_D08K01dA {
    ns1:LopHanhChinh ns1:noiDung "Lớp hành chính là lớp được thành lập ổn định trong cả khóa học theo ngành, chuyên ngành hoặc chương trình đào tạo, dùng để duy trì hoạt động đoàn thể, xét kết quả rèn luyện, xét khen thưởng và phổ biến thông tin. Mỗi lớp hành chính có mã số riêng, được bố trí cố vấn học tập và cần có tối thiểu 20 sinh viên."@vi .
}

ns1:TD1052_D09K03 {
    ns1:KhoiLuongDangKyCuaSinhVienHocLucTrungBinhTroLenChuongTrinh45NamVaChuongTrinhDacBiet ns1:loaiQuyTac ns1:QuyTacKhoiLuongDangKyMoiHocKy ;
        ns1:noiDung "Sinh viên xếp loại học lực trung bình trở lên của học kỳ liền trước được đăng ký trong một học kỳ (trừ học kỳ cuối khóa và các học kỳ phụ) tối thiểu 15 tín chỉ và tối đa 32 tín chỉ đối với các chương trình đào tạo 4,5 năm và chương trình đặc biệt theo đặt hàng của doanh nghiệp, không tính tín chỉ của các học phần Giáo dục thể chất, Giáo dục Quốc phòng – An ninh."@vi ;
        ns1:soTinChiToiDa 32 ;
        ns1:soTinChiToiThieu 15 .

    ns1:KhoiLuongDangKyCuaSinhVienHocLucTrungBinhTroLenChuongTrinh4Nam ns1:loaiQuyTac ns1:QuyTacKhoiLuongDangKyMoiHocKy ;
        ns1:noiDung "Sinh viên xếp loại học lực trung bình trở lên của học kỳ liền trước được đăng ký trong một học kỳ (trừ học kỳ cuối khóa và các học kỳ phụ) tối thiểu 15 tín chỉ và tối đa 27 tín chỉ đối với chương trình đào tạo 4 năm, không tính tín chỉ của các học phần Giáo dục thể chất, Giáo dục Quốc phòng – An ninh."@vi ;
        ns1:soTinChiToiDa 27 ;
        ns1:soTinChiToiThieu 15 .

    ns1:ThuTucDangKyKhoiLuongHocTap ns1:noiDung "Sinh viên xếp loại học lực trung bình trở lên đăng ký tối thiểu 15 tín chỉ và tối đa 27 tín chỉ với chương trình 4 năm, tối đa 32 tín chỉ với chương trình 4,5 năm và chương trình đặc biệt."@vi .
}

ns1:TD1052_D29K01 {
    ns1:ThuTucHocLienThong ns1:noiDung "Người đã tốt nghiệp trình độ trung cấp, trình độ cao đẳng được xét tuyển và học liên thông lên trình độ đại học. Người đã tốt nghiệp đại học được xét tuyển và học liên thông để nhận thêm một bằng tốt nghiệp đại học của một ngành đào tạo khác."@vi .
}

ns1:TDVNPAYPaymentGuidanceOtherBankNote {
    ns1:MienPhiVnpayDoiVoiTaiKhoanVietcombank ns1:apDungChoPhuongThucDong ns1:ThanhToanQuaCongVnpay ;
        ns1:soTien "0"^^xsd:nonNegativeInteger .

    ns1:PhiVnpayDoiVoiNganHangKhac ns1:apDungChoPhuongThucDong ns1:ThanhToanQuaCongVnpay ;
        ns1:soTien "5500"^^xsd:nonNegativeInteger .
}

ns1:TD1052_D20K01dC {
    ns1:CanhBaoDoDiemTrungBinhTichLuy ns1:loaiQuyTac ns1:QuyTacCanhBaoKetQuaHocTap ;
        ns1:noiDung "Điểm trung bình tích lũy đạt dưới 5,20 đối với sinh viên năm thứ nhất, dưới 5,30 đối với năm thứ hai, dưới 5,40 đối với năm thứ ba, hoặc dưới 5,50 đối với các năm tiếp theo."@vi .
}

ns1:TD1052_D12K01 {
    ns1:DeCuongChiTietHocPhan ns1:noiDung "Đề cương chi tiết học phần là kế hoạch dạy học trong đó nêu rõ mục tiêu, kết quả học tập mong đợi, nội dung và kế hoạch dạy học, kiểm tra, đánh giá và các yêu cầu khác theo quy định của Trường."@vi .
}

ns1:TD753_D10K02 {
    ns1:ThuTucRutBotHocPhanDaDangKy ns1:noiDung "Chỉ được chấp nhận tối đa trong tuần thứ hai của học kỳ chính, tuần thứ nhất của học kỳ phụ."@vi,
            "Quá thời hạn, học phần vẫn được giữ nguyên như đã đăng ký; sinh viên không đi học thì xem như tự ý bỏ học và phải nhận điểm 0."@vi .
}

ns1:TD1052_D06K02dB {
    ns1:HocPhanTuChon ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần chứa đựng những nội dung kiến thức cần thiết, sinh viên được tự chọn theo hướng dẫn của Trường nhằm đa dạng hóa hướng chuyên môn hoặc tự chọn tùy ý để tích lũy đủ số học phần quy định."@vi .
}

ns1:TD1052_D18K03 {
    ns1:ThuTucXetVaCapHocBongKhuyenKhichHocTap ns1:noiDung "Trường xét học bổng theo điểm trung bình chung của từng học kỳ chính, không xét kết quả học kỳ hè."@vi .
}

ns1:TD1052_D06K02dE {
    ns1:HocPhanSongHanh ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần sinh viên có thể học cùng với các học phần khác trong một học kỳ."@vi .
}

