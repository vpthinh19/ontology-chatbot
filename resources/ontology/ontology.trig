:TD1052_D01K02 {
	:KhoaHoacVienDaoTao :loaiChuThe :DonViTrongTruong .
	:PhamViVaDoiTuongApDungCuaQuyChe :noiDung "Quy chế áp dụng đối với sinh viên học theo hình thức đào tạo chính quy và vừa làm vừa học; sinh viên học cùng lúc hai chương trình; sinh viên liên thông đối với người có văn bằng khác; sinh viên theo chương trình trao đổi và công nhận tín chỉ; các khoa hoặc viện đào tạo, đơn vị quản lý đào tạo, giảng viên và các đơn vị, cá nhân có liên quan."@vi .
}
:TD1052_D02K04dA {
	:ThoiGianDaoTaoChuanToanKhoa :loaiQuyTac :QuyTacThoiGianDaoTao ;
		:noiDung "Thời gian theo kế hoạch học tập chuẩn toàn khóa cho một chương trình đại học chính quy cấp bằng cử nhân là 4 năm, chương trình chuyên sâu đặc thù cấp bằng kỹ sư là 4,5 năm."@vi .
}
:TD1052_D02K04dB {
	:ThoiGianDaoTaoHinhThucVuaLamVuaHoc :apDungChoHinhThucDaoTao :DaoTaoVuaLamVuaHoc ;
		:loaiQuyTac :QuyTacThoiGianDaoTao ;
		:noiDung "Hệ vừa làm vừa học có thời gian học chuẩn toàn khóa dài hơn hệ chính quy cùng ngành ít nhất 20%."@vi ;
		:tyLeToiThieu "20"^^xsd:decimal .
}
:TD1052_D02K04dC {
	:ThoiGianToiDaHoanThanhKhoaHoc :loaiQuyTac :QuyTacThoiGianDaoTao ;
		:noiDung "Thời gian tối đa hoàn thành toàn khóa học không quá 2 lần thời gian theo kế hoạch học tập chuẩn toàn khóa."@vi .
}
:TD1052_D03K01 {
	:PhuongThucToChucDaoTaoTheoTinChi :noiDung "Phương thức tổ chức đào tạo theo tín chỉ là cách thức tổ chức đào tạo theo từng lớp học phần, cho phép sinh viên tích lũy tín chỉ của từng học phần và thực hiện chương trình đào tạo theo kế hoạch học tập của cá nhân, phù hợp với kế hoạch giảng dạy của Trường."@vi .
}
:TD1052_D04K01 {
	:DaoTaoChinhQuy :loaiKhaiNiem :HinhThucDaoTao ;
		:noiDung "Hoạt động giảng dạy được thực hiện tại Trường; thực hành, thực tập, trải nghiệm thực tế và giảng dạy trực tuyến có thể thực hiện ngoài Trường. Thời gian giảng dạy từ 06 giờ đến 20 giờ, từ thứ 2 đến thứ 7."@vi .
}
:TD1052_D04K02 {
	:DaoTaoVuaLamVuaHoc :loaiKhaiNiem :HinhThucDaoTao ;
		:noiDung "Hoạt động giảng dạy được thực hiện tại Trường hoặc tại cơ sở phối hợp đào tạo. Thời gian giảng dạy linh hoạt trong ngày và trong tuần."@vi .
}
:TD1052_D05K01 {
	:TinChi :noiDung "Tín chỉ là đơn vị tính khối lượng học tập của người học, bao gồm khối lượng kiến thức và kỹ năng mà người học cần tích lũy trong một khoảng thời gian nhất định."@vi .
}
:TD1052_D05K02 {
	:QuyDoiGioHocCuaMotTinChi :noiDung "Một tín chỉ tương đương 50 giờ học tập định mức. Đối với hoạt động trên lớp, một tín chỉ yêu cầu tối thiểu 15 giờ giảng, hoặc 30 giờ thực hành, thí nghiệm, thảo luận, hoặc 45 giờ thực tập tại cơ sở ngoài trường, làm tiểu luận, bài tập lớn, đồ án, khóa luận, chuyên đề tốt nghiệp. Một giờ giảng được tính bằng 50 phút."@vi .
}
:TD1052_D06K02dA {
	:HocPhanBatBuoc :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần chứa đựng những nội dung kiến thức chính yếu của mỗi chương trình đào tạo và bắt buộc sinh viên phải tích lũy."@vi .
}
:TD1052_D06K02dB {
	:HocPhanTuChon :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần chứa đựng những nội dung kiến thức cần thiết, sinh viên được tự chọn theo hướng dẫn của Trường nhằm đa dạng hóa hướng chuyên môn hoặc tự chọn tùy ý để tích lũy đủ số học phần quy định."@vi .
}
:TD1052_D06K02dC {
	:HocPhanTienQuyet :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần sinh viên phải tích lũy mới được học các học phần tiếp theo."@vi .
}
:TD1052_D06K02dD {
	:HocPhanNhiemY :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần sinh viên có thể tự do đăng ký học theo nhu cầu cá nhân. Kết quả được ghi trong bảng điểm nhưng không tính vào trung bình chung tích lũy và không dùng để phân loại, xếp hạng học tập."@vi .
}
:TD1052_D06K02dDD {
	:HocPhanHocTruoc :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần sinh viên phải học xong, có thể đạt hoặc không đạt, trước khi học các học phần tiếp theo."@vi .
}
:TD1052_D06K02dE {
	:HocPhanSongHanh :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần sinh viên có thể học cùng với các học phần khác trong một học kỳ."@vi .
}
:TD1052_D06K02dG {
	:HocPhanDieuKien :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần mà sinh viên phải hoàn thành trước khi tốt nghiệp nhưng kết quả không dùng để tính điểm trung bình chung tích lũy."@vi .
}
:TD1052_D06K02dH {
	:HocPhanTuongDuong :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Một hay một nhóm học phần thuộc chương trình đào tạo của một khóa học hoặc một ngành khác đang tổ chức đào tạo tại Trường hoặc cơ sở đào tạo khác, được phép tích lũy để thay cho học phần trong chương trình đào tạo."@vi .
}
:TD1052_D06K02dI {
	:HocPhanThayThe :loaiKhaiNiem :LoaiHocPhan ;
		:noiDung "Học phần được dùng thay cho một học phần có trong chương trình đào tạo khóa trước nhưng khóa sau không còn tổ chức đào tạo, hoặc học phần tự chọn thay cho học phần tự chọn khác mà sinh viên học không đạt."@vi .
}
:TD1052_D07K02dA {
	:HocKyChinh :loaiKhaiNiem :LoaiHocKy ;
		:noiDung "Học kỳ I và học kỳ II kéo dài ít nhất 19 tuần, bao gồm 14 tuần học (trong đó có 01 tuần học số), 01 tuần thi giữa kỳ, 02 tuần thi cuối kỳ, 01 tuần chấm thi giữa kỳ và 01 tuần chấm thi cuối kỳ."@vi .
}
:TD1052_D07K02dB {
	:HocKyHe :loaiKhaiNiem :LoaiHocKy ;
		:noiDung "Học kỳ III là học kỳ hè kéo dài tối đa 8 tuần, gồm tối đa 07 tuần học và 01 tuần thi. Học kỳ III tổ chức học tập trung các học phần Giáo dục quốc phòng - An ninh hoặc giúp sinh viên học vượt, học lại, học cải thiện."@vi .
}
:TD1052_D08K01dA {
	:CoVanHocTap :noiDung "Mỗi lớp hành chính được bố trí cố vấn học tập để hỗ trợ, giúp đỡ sinh viên trong suốt quá trình học tập."@vi .
	:LopHanhChinh :noiDung "Lớp hành chính là lớp được thành lập ổn định trong cả khóa học theo ngành, chuyên ngành hoặc chương trình đào tạo, dùng để duy trì hoạt động đoàn thể, xét kết quả rèn luyện, xét khen thưởng và phổ biến thông tin. Mỗi lớp hành chính có mã số riêng, được bố trí cố vấn học tập và cần có tối thiểu 20 sinh viên."@vi .
}
:TD1052_D08K02dA {
	:LopHocPhan :noiDung "Lớp học phần là lớp mà sinh viên đăng ký theo học cùng học phần trong một học kỳ. Mỗi học phần có thể có nhiều lớp học phần với mã số nhóm khác nhau. Lớp học phần được áp dụng cho hình thức đào tạo chính quy."@vi .
}
:TD1052_D08K02dC {
	:MauSo01DonXinMoLopHocPhan :soHieuMauTheoQuyetDinh "01" .
	:ThuTucDeNghiMoThemLopHocPhan :canBieuMau :MauSo01DonXinMoLopHocPhan ;
		:doAiQuyetDinh :HieuTruong ;
		:doAiThucHien :SinhVien ;
		:noiDung "Khi số lượng sinh viên đăng ký ít hơn số lượng tối thiểu theo quy định, với các trường hợp đặc thù hoặc có lý do chính đáng, nhóm sinh viên làm đơn xin mở lớp học phần (Mẫu số 01 - Phụ lục 4 kèm theo) để Hiệu trưởng xem xét và quyết định, thông qua Đơn vị quản lý đào tạo."@vi ;
		:nopTai :PhongDaoTaoDaiHoc .
}
:TD1052_D09K02dA {
	:ThuTucDangKyKhoiLuongHocTap :noiDung "Tìm hiểu chương trình đào tạo, kế hoạch giảng dạy trong học kỳ và kiểm tra lại kết quả học tập để lập kế hoạch học tập phù hợp."@vi .
}
:TD1052_D09K02dB {
	:ThuTucDangKyKhoiLuongHocTap :noiDung "Đăng ký lớp của các học phần dự định học trong học kỳ, gồm học phần mới, học phần chưa đạt để học lại và học phần đã đạt để cải thiện điểm."@vi .
}
:TD1052_D09K02dC {
	:CoVanHocTap :noiDung "Để chuẩn bị đăng ký học tập cho một học kỳ, sinh viên xin ý kiến tư vấn của Cố vấn học tập và đăng ký học các lớp học phần tổ chức trong học kỳ tùy theo khả năng và tiến độ học tập."@vi .
	:ThuTucDangKyKhoiLuongHocTap :noiDung "Xin ý kiến tư vấn của Cố vấn học tập trước khi đăng ký các lớp học phần."@vi .
}
:TD1052_D09K02dD {
	:ThuTucDangKyKhoiLuongHocTap :noiDung "Xác nhận đăng ký học phần theo thời gian quy định từ tài khoản cá nhân trên Hệ thống quản lý đào tạo."@vi .
}
:TD1052_D09K03 {
	:KhoiLuongDangKyCuaSinhVienHocLucTrungBinhTroLenChuongTrinh45NamVaChuongTrinhDacBiet :loaiQuyTac :QuyTacKhoiLuongDangKyMoiHocKy ;
		:noiDung "Sinh viên xếp loại học lực trung bình trở lên của học kỳ liền trước được đăng ký trong một học kỳ (trừ học kỳ cuối khóa và các học kỳ phụ) tối thiểu 15 tín chỉ và tối đa 32 tín chỉ đối với các chương trình đào tạo 4,5 năm và chương trình đặc biệt theo đặt hàng của doanh nghiệp, không tính tín chỉ của các học phần Giáo dục thể chất, Giáo dục Quốc phòng – An ninh."@vi ;
		:soTinChiToiDa 32 ;
		:soTinChiToiThieu 15 .
	:KhoiLuongDangKyCuaSinhVienHocLucTrungBinhTroLenChuongTrinh4Nam :loaiQuyTac :QuyTacKhoiLuongDangKyMoiHocKy ;
		:noiDung "Sinh viên xếp loại học lực trung bình trở lên của học kỳ liền trước được đăng ký trong một học kỳ (trừ học kỳ cuối khóa và các học kỳ phụ) tối thiểu 15 tín chỉ và tối đa 27 tín chỉ đối với chương trình đào tạo 4 năm, không tính tín chỉ của các học phần Giáo dục thể chất, Giáo dục Quốc phòng – An ninh."@vi ;
		:soTinChiToiDa 27 ;
		:soTinChiToiThieu 15 .
	:ThuTucDangKyKhoiLuongHocTap :noiDung "Sinh viên xếp loại học lực trung bình trở lên đăng ký tối thiểu 15 tín chỉ và tối đa 27 tín chỉ với chương trình 4 năm, tối đa 32 tín chỉ với chương trình 4,5 năm và chương trình đặc biệt."@vi .
}
:TD1052_D09K04 {
	:KhoiLuongDangKyCuaSinhVienHocLucYeuKem :loaiQuyTac :QuyTacKhoiLuongDangKyMoiHocKy ;
		:noiDung "Sinh viên xếp loại học lực hạng yếu kém của học kỳ liền trước được đăng ký tối thiểu 12 tín chỉ và tối đa 18 tín chỉ trong một học kỳ."@vi ;
		:soTinChiToiDa 18 ;
		:soTinChiToiThieu 12 .
	:ThuTucDangKyKhoiLuongHocTap :noiDung "Sinh viên xếp loại học lực yếu kém của học kỳ liền trước đăng ký tối thiểu 12 tín chỉ và tối đa 18 tín chỉ."@vi .
}
:TD1052_D10K02 {
	:BoMon :loaiChuThe :DonViTrongTruong ;
		:noiDung "Bộ môn thuộc Khoa, Viện đào tạo. Trong thời gian đăng ký học phần, Nhà trường mở thêm lớp học phần theo đề nghị khi số lượng sinh viên đăng ký đạt đủ điều kiện mở lớp và được Bộ môn quản lý chấp thuận."@vi .
	:ThuTucDeNghiMoThemLopHocPhan :duocXetBoi :BoMon ;
		:noiDung "Trong thời gian đăng ký học phần, nếu số lượng sinh viên đăng ký đạt đủ điều kiện mở lớp theo quy định và được Bộ môn (thuộc Khoa, Viện đào tạo) quản lý chấp thuận, Nhà trường sẽ mở thêm lớp học phần theo đề nghị."@vi .
}
:TD1052_D11K01 {
	:ThuTucDangKyHocLaiHocPhan :doAiThucHien :SinhVien ;
		:noiDung "Sinh viên có học phần bắt buộc bị điểm dưới 5,0 phải đăng ký học lại học phần đó ở các học kỳ tiếp theo cho đến khi đạt điểm bằng hoặc lớn hơn 5,0."@vi .
}
:TD1052_D11K03 {
	:ThuTucDangKyHocCaiThienDiem :doAiThucHien :SinhVien ;
		:noiDung "Đăng ký học lại học phần hoặc đổi sang học phần khác trong nhóm tự chọn để cải thiện điểm trung bình chung tích lũy."@vi .
}
:TD1052_D11K04 {
	:ThuTucDangKyHocCaiThienDiem :noiDung "Điểm tích lũy được ghi nhận theo lần học có điểm cao hơn."@vi .
	:ThuTucDangKyHocLaiHocPhan :noiDung "Kết quả học tập tích lũy được ghi nhận cho lần học cùng học phần có điểm cao hơn."@vi .
}
:TD1052_D12K01 {
	:DeCuongChiTietHocPhan :noiDung "Đề cương chi tiết học phần là kế hoạch dạy học trong đó nêu rõ mục tiêu, kết quả học tập mong đợi, nội dung và kế hoạch dạy học, kiểm tra, đánh giá và các yêu cầu khác theo quy định của Trường."@vi .
}
:TD1052_D13K02 {
	:TyLeToiDaDaoTaoTrucTuyen :loaiQuyTac :QuyTacTyLeDaoTaoTrucTuyen ;
		:noiDung "Nhà trường áp dụng tối đa 30% tổng khối lượng chương trình đào tạo cho hoạt động dạy học trực tuyến. Trong trường hợp thiên tai, dịch bệnh phức tạp hoặc bất khả kháng khác, Nhà trường thực hiện theo hướng dẫn của Bộ Giáo dục và Đào tạo."@vi ;
		:tyLeToiDa "30"^^xsd:decimal .
}
:TD1052_D13K03dA {
	:DaoTaoTrucTuyenKhongDongBo :loaiKhaiNiem :HinhThucToChucDayHoc ;
		:noiDung "Sinh viên chủ động tham gia các hoạt động đào tạo trực tuyến trên cơ sở kế hoạch dạy học của giảng viên. Đây là hình thức kết hợp dạy học trực tiếp trên lớp với việc sử dụng hệ thống NTU E-learning."@vi .
}
:TD1052_D13K03dB {
	:DaoTaoTrucTuyenDongBo :loaiKhaiNiem :HinhThucToChucDayHoc ;
		:noiDung "Giảng viên và sinh viên cùng tham gia các hoạt động đào tạo tại cùng một thời điểm trên cùng một không gian học tập. Đây là hình thức dạy học hoàn toàn trực tuyến."@vi .
}
:TD1052_D14K01 {
	:ThuTucDangKyThucHienDoAnTotNghiep :noiDung "Sinh viên được xếp hạng năm thứ 4 phải thực hiện đồ án/khóa luận tốt nghiệp hoặc các chuyên đề tốt nghiệp để hoàn thành khóa học."@vi .
}
:TD1052_D14K02 {
	:MauSo02DonDangKyThucHienDoAnTotNghiep :soHieuMauTheoQuyetDinh "02" .
	:ThuTucDangKyThucHienDoAnTotNghiep :canBieuMau :MauSo02DonDangKyThucHienDoAnTotNghiep ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên đủ điều kiện thực hiện đồ án/khóa luận tốt nghiệp theo quy định của Trường phải làm đơn đăng ký thực hiện đồ án/khóa luận tốt nghiệp (Mẫu số 02 - Phụ lục 4 kèm theo)."@vi .
}
:TD1052_D14K03 {
	:ThuTucDangKyThucHienDoAnTotNghiep :noiDung "Sinh viên không đủ điều kiện thực hiện đồ án tốt nghiệp phải làm các chuyên đề tốt nghiệp hoặc học các học phần tốt nghiệp theo quy định của chương trình đào tạo."@vi .
}
:TD1052_D15K01 {
	:ThangDiemDanhGia :noiDung "Nhà trường sử dụng thang điểm 10 để đánh giá kết quả học tập."@vi .
}
:TD1052_D16K01 {
	:DanhGiaCuoiKy :loaiKhaiNiem :ThanhPhanDanhGiaHocPhan ;
		:noiDung "Thường dưới dạng bài thi viết, vấn đáp, thực hành hoặc sản phẩm tổng hợp, được tổ chức vào cuối học phần."@vi .
	:DanhGiaQuaTrinh :loaiKhaiNiem :ThanhPhanDanhGiaHocPhan ;
		:noiDung "Gồm điểm chuyên cần, điểm kiểm tra, bài tập, sản phẩm học tập và điểm đánh giá giữa kỳ nếu có."@vi .
}
:TD1052_D16K02dB {
	:ThangDiemDanhGia :noiDung "Điểm đánh giá học phần được chấm theo thang điểm 10 (từ 0,0 đến 10), làm tròn đến một chữ số thập phân."@vi .
}
:TD1052_D16K02dC {
	:DiemI :kyHieuDiemChu "I" ;
		:loaiDanhMuc :DiemChu ;
		:noiDung "Điểm học phần chưa hoàn thiện do được phép hoãn thi, kiểm tra."@vi .
	:DiemP :kyHieuDiemChu "P" ;
		:loaiDanhMuc :DiemChu ;
		:noiDung "Loại đạt không phân mức, áp dụng cho học phần chỉ yêu cầu đạt và không tính vào điểm trung bình học tập. Đạt từ 5 điểm trở lên."@vi .
	:DiemR :kyHieuDiemChu "R" ;
		:loaiDanhMuc :DiemChu ;
		:noiDung "Điểm học phần bảo lưu được miễn học và công nhận tín chỉ."@vi .
	:DiemX :kyHieuDiemChu "X" ;
		:loaiDanhMuc :DiemChu ;
		:noiDung "Điểm học phần chưa hoàn thiện do chưa đủ dữ liệu."@vi .
	:ThangDiemDanhGia :noiDung "Loại đạt có phân mức, áp dụng cho các học phần được tính vào điểm trung bình học tập: điểm học phần từ 5,0 điểm trở lên được đánh giá là đạt, điểm học phần dưới 5,0 điểm được đánh giá là không đạt."@vi .
}
:TD1052_D17K01 {
	:MauSo03DonXinNghiHoc :soHieuMauTheoQuyetDinh "03" .
	:ThuTucXinPhepNghiHoc :canBieuMau :MauSo03DonXinNghiHoc ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên nghỉ học vì lý do chính đáng (ốm đau, tai nạn, thiên tai, việc gia đình đặc biệt...) phải nộp đơn xin nghỉ học theo mẫu kèm minh chứng liên quan (Mẫu số 03 - Phụ lục 4 kèm theo). Đơn phải nộp cho Khoa hoặc viện đào tạo trong vòng 03 ngày làm việc kể từ ngày bắt đầu nghỉ học."@vi ;
		:nopTai :KhoaHoacVienDaoTao .
}
:TD1052_D17K01dA {
	:DieuKienDuThiHocPhanLyThuyet :loaiQuyTac :QuyTacDieuKienDuThi ;
		:noiDung "Đối với học phần lý thuyết, sinh viên phải tham dự tối thiểu 80% tổng số giờ học của học phần và thực hiện đầy đủ các yêu cầu bắt buộc ghi trong Đề cương chi tiết học phần."@vi ;
		:tyLeToiThieu "80"^^xsd:decimal .
	:ThuTucXinPhepNghiHoc :noiDung "Với học phần lý thuyết, sinh viên phải tham dự tối thiểu 80% tổng số giờ học của học phần."@vi .
}
:TD1052_D17K01dB {
	:DieuKienDuThiHocPhanThucHanh :loaiQuyTac :QuyTacDieuKienDuThi ;
		:noiDung "Đối với các học phần thực hành, thí nghiệm, thực tập ngoài trường, sinh viên phải tham dự 100% số giờ học. Trường hợp nghỉ có lý do chính đáng sẽ do Khoa hoặc viện đào tạo xem xét xử lý."@vi ;
		:tyLeToiThieu "100"^^xsd:decimal .
	:ThuTucXinPhepNghiHoc :noiDung "Với học phần thực hành, thí nghiệm, thực tập ngoài trường, sinh viên phải tham dự 100% số giờ học; trường hợp nghỉ có lý do chính đáng do Khoa hoặc viện đào tạo xem xét xử lý."@vi .
}
:TD1052_D17K02 {
	:HauQuaCuaViecBiCamThiHoacVangThi :loaiQuyTac :QuyTacDieuKienDuThi ;
		:noiDung "Sinh viên bị cấm thi hoặc vắng thi không có lý do chính đáng trong kỳ thi nào sẽ nhận điểm 0 ở kỳ thi đó."@vi .
}
:TD1052_D17K04 {
	:ThuTucXinHoanThi :noiDung "Sinh viên đủ điều kiện dự thi nhưng không thể dự thi cuối kỳ do bị ốm, tai nạn hoặc vì lý do đặc biệt khác được phép hoãn thi và được dự thi cuối kỳ học phần đó trong thời hạn 2 học kỳ chính tiếp theo để hoàn thành điểm, quá thời hạn trên điểm đánh giá cuối kỳ sẽ là điểm 0 (không). Sinh viên làm đơn xin hoãn thi theo mẫu (Mẫu số 04 - Phụ lục 4 kèm theo) gửi về Đơn vị quản lý đào tạo để được giải quyết."@vi .
}
:TD1052_D18K03 {
	:ThuTucXetVaCapHocBongKhuyenKhichHocTap :noiDung "Trường xét học bổng theo điểm trung bình chung của từng học kỳ chính, không xét kết quả học kỳ hè."@vi .
}
:TD1052_D20K01dA {
	:CanhBaoDoNoTinChi :loaiQuyTac :QuyTacCanhBaoKetQuaHocTap ;
		:noiDung "Tổng số tín chỉ không đạt trong học kỳ vượt quá 50% khối lượng đã đăng ký trong học kỳ, hoặc tổng số tín chỉ nợ đọng từ đầu khóa học vượt quá 24."@vi .
}
:TD1052_D20K01dB {
	:CanhBaoDoDiemTrungBinhHocKy :loaiQuyTac :QuyTacCanhBaoKetQuaHocTap ;
		:noiDung "Điểm trung bình chung học kỳ đạt dưới 4,00 đối với học kỳ đầu khóa học, dưới 4,50 đối với học kỳ tiếp theo."@vi .
}
:TD1052_D20K01dC {
	:CanhBaoDoDiemTrungBinhTichLuy :loaiQuyTac :QuyTacCanhBaoKetQuaHocTap ;
		:noiDung "Điểm trung bình tích lũy đạt dưới 5,20 đối với sinh viên năm thứ nhất, dưới 5,30 đối với năm thứ hai, dưới 5,40 đối với năm thứ ba, hoặc dưới 5,50 đối với các năm tiếp theo."@vi .
}
:TD1052_D20K02dA {
	:BuocThoiHocDoCanhBaoLienTiep :loaiQuyTac :QuyTacBuocThoiHoc ;
		:noiDung "Sinh viên bị buộc thôi học nếu vượt quá 02 lần cảnh báo kết quả học tập liên tiếp."@vi .
}
:TD1052_D20K02dB {
	:BuocThoiHocDoQuaThoiGianDaoTao :loaiQuyTac :QuyTacBuocThoiHoc ;
		:noiDung "Sinh viên bị buộc thôi học nếu vượt quá thời gian tối đa được phép học tại Trường."@vi .
}
:TD1052_D20K03 {
	:MauSo05DonXinChuyenChuongTrinhDaoTao :soHieuMauTheoQuyetDinh "05" .
	:ThuTucXinChuyenChuongTrinhDaoTaoKhiThuocDienBuocThoiHoc :canBieuMau :MauSo05DonXinChuyenChuongTrinhDaoTao ;
		:doAiQuyetDinh :HieuTruong ;
		:doAiThucHien :SinhVien ;
		:noiDung "Những sinh viên thuộc diện bị buộc thôi học quy định tại khoản 2 Điều này được quyền viết đơn (Mẫu số 05 - Phụ lục 4 kèm theo) gửi Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên để được xem xét chuyển qua chương trình đào tạo theo hình thức vừa làm vừa học tương ứng tổ chức tại Trường."@vi , "Sinh viên được xem xét bảo lưu một phần kết quả học tập ở chương trình cũ đối với các học phần đạt mức điểm 5,0 trở lên khi học ở chương trình mới. Tùy thuộc vào thời gian xin chuyển chương trình đào tạo, Nhà trường xem xét quyết định cho bảo lưu kết quả học tập đối với từng trường hợp cụ thể."@vi ;
		:nopTai :PhongCongTacChinhTriVaSinhVien .
}
:TD1052_D21K02 {
	:MauSo06DonXinMienHocVaQuyDoiDiemHocPhan :soHieuMauTheoQuyetDinh "06" .
	:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi :canBieuMau :MauSo06DonXinMienHocVaQuyDoiDiemHocPhan ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên có nguyện vọng miễn học và quy đổi điểm học phần phải nộp bản sao có công chứng văn bằng, chứng chỉ và bảng điểm cho Đơn vị quản lý đào tạo (Mẫu số 06 - Phụ lục 4 kèm theo)."@vi ;
		:nopTai :PhongDaoTaoDaiHoc .
}
:TD1052_D21K03 {
	:HoiDongChuyenMon :noiDung "Hội đồng chuyên môn của Nhà trường là Hội đồng Khoa/viện hoặc Hội đồng được Hiệu trưởng thành lập nếu thấy cần thiết."@vi .
	:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi :duocXetBoi :HoiDongChuyenMon ;
		:noiDung "Hội đồng chuyên môn của Nhà trường hoặc Đơn vị quản lý đào tạo phối hợp với Khoa/viện xem xét công nhận, chuyển đổi tín chỉ trên cơ sở đối sánh chuẩn đầu ra, nội dung và khối lượng học tập, cách thức đánh giá học phần và các điều kiện bảo đảm chất lượng thực hiện chương trình."@vi , "Kết quả được công nhận và chuyển đổi theo từng học phần, theo từng nhóm học phần, hoặc theo cả chương trình đào tạo."@vi .
}
:TD1052_D21K04 {
	:GioiHanKhoiLuongDuocCongNhanVaChuyenDoi :loaiQuyTac :QuyTacGioiHanCongNhanVaChuyenDoiTinChi ;
		:noiDung "Khối lượng tối đa được công nhận kết quả học tập và chuyển đổi không vượt quá 50% khối lượng học tập tối thiểu của chương trình đào tạo."@vi ;
		:tyLeToiDa "50"^^xsd:decimal .
	:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi :noiDung "Khối lượng được công nhận và chuyển đổi không vượt quá 50% khối lượng học tập tối thiểu của chương trình đào tạo."@vi .
}
:TD1052_D21K05 {
	:ThuTucXinMienHocMienThiVaCongDiemThuong :noiDung "Sinh viên được xem xét miễn học, miễn thi kết thúc học phần liên quan và cho điểm thưởng trong các trường hợp: đạt giải thưởng nhất, nhì, ba trong các kỳ thi Olympic sinh viên cấp tỉnh và tương đương trở lên; đạt giải thưởng nhất, nhì, ba trong đợt xét Giải thưởng khoa học và công nghệ dành cho sinh viên; có chứng chỉ ngoại ngữ quốc tế còn hiệu lực, đáp ứng các mức yêu cầu theo quy định chi tiết tại Phụ lục 2; có chứng chỉ tin học quốc tế còn hiệu lực, đáp ứng các mức yêu cầu theo quy định chi tiết tại Phụ lục 3."@vi .
}
:TD1052_D21K06 {
	:MauSo07DonXinMienHocMienThiVaCongDiemThuong :soHieuMauTheoQuyetDinh "07" .
	:ThuTucXinMienHocMienThiVaCongDiemThuong :canBieuMau :MauSo07DonXinMienHocMienThiVaCongDiemThuong ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên có nguyện vọng miễn học, miễn thi và cộng điểm thưởng phải nộp đơn theo mẫu (Mẫu số 07 - Phụ lục 4 kèm theo) kèm theo minh chứng hợp lệ gửi về Đơn vị quản lý đào tạo để được xem xét giải quyết."@vi ;
		:nopTai :PhongDaoTaoDaiHoc .
}
:TD1052_D21K07 {
	:ThoiHanHieuLucCuaHocPhanDuocCongNhan :loaiQuyTac :QuyTacGioiHanCongNhanVaChuyenDoiTinChi ;
		:noiDung "Nhà trường chỉ cho phép công nhận kết quả học tập, miễn học, miễn thi, điểm thưởng và chuyển đổi tín chỉ của học phần được tích lũy trong vòng 5 năm tính đến ngày xem xét."@vi ;
		:soNam "5"^^xsd:decimal .
	:ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi :noiDung "Chỉ công nhận học phần được tích lũy trong vòng 5 năm tính đến ngày xem xét."@vi .
}
:TD1052_D22K01dA {
	:ThuTucXetVaCongNhanTotNghiep :noiDung "Đến thời điểm xét tốt nghiệp không bị truy cứu trách nhiệm hình sự và không đang trong thời gian bị kỷ luật ở mức đình chỉ học tập."@vi .
}
:TD1052_D22K01dB {
	:ThuTucXetVaCongNhanTotNghiep :noiDung "Tích lũy đủ số học phần và khối lượng học tập của chương trình đào tạo, đạt chuẩn đầu ra và các nội dung bắt buộc khác."@vi .
}
:TD1052_D22K01dC {
	:ThuTucXetVaCongNhanTotNghiep :noiDung "Điểm trung bình chung tích lũy toàn khóa học đạt từ 5,50 trở lên."@vi .
}
:TD1052_D22K01dD {
	:ThuTucXetVaCongNhanTotNghiep :noiDung "Đạt năng lực ngoại ngữ theo quy định đối với mỗi khóa đào tạo."@vi .
}
:TD1052_D22K01dDD {
	:ThuTucXetVaCongNhanTotNghiep :noiDung "Hoàn thành các học phần Giáo dục quốc phòng - An ninh, Giáo dục thể chất và các học phần điều kiện khác nếu có."@vi .
}
:TD1052_D22K01dE {
	:ThuTucXetVaCongNhanTotNghiep :noiDung "Hoàn thành các nghĩa vụ khác theo quy định của Trường như trả sách thư viện, quyết toán đề tài nghiên cứu khoa học và học phí."@vi .
}
:TD1052_D22K02 {
	:MauSo08DonDeNghiXetTotNghiepSom :soHieuMauTheoQuyetDinh "08" .
	:ThuTucDeNghiXetTotNghiepSom :canBieuMau :MauSo08DonDeNghiXetTotNghiepSom ;
		:doAiThucHien :SinhVien ;
		:noiDung "Trong trường hợp đủ điều kiện tốt nghiệp sớm hơn thời gian thiết kế của khóa học, sinh viên viết đơn theo mẫu (Mẫu số 08 - Phụ lục 4 kèm theo) gửi Đơn vị quản lý đào tạo đề nghị được xét tốt nghiệp."@vi ;
		:nopTai :PhongDaoTaoDaiHoc ;
		:thuTucTiepTheo :ThuTucXetVaCongNhanTotNghiep .
}
:TD1052_D22K03 {
	:HoiDongXetTotNghiep :noiDung "Sau mỗi quý, Hội đồng xét tốt nghiệp căn cứ các điều kiện công nhận tốt nghiệp quy định tại khoản 1 Điều 22 để lập danh sách những sinh viên đủ điều kiện tốt nghiệp. Hội đồng xét tốt nghiệp Trường do Hiệu trưởng hoặc Phó Hiệu trưởng được Hiệu trưởng uỷ quyền làm chủ tịch, Trưởng đơn vị quản lý đào tạo làm thư ký và các thành viên là các Trưởng Khoa/viện, Trưởng Phòng Công tác Chính trị và Sinh viên."@vi .
	:ThuTucDeNghiXetTotNghiepSom :duocXetBoi :HoiDongXetTotNghiep .
	:ThuTucXetVaCongNhanTotNghiep :doAiThucHien :HoiDongXetTotNghiep ;
		:duocXetBoi :HoiDongXetTotNghiep ;
		:noiDung "Hội đồng xét tốt nghiệp lập danh sách những sinh viên đủ điều kiện tốt nghiệp sau mỗi quý."@vi .
}
:TD1052_D22K04 {
	:ThuTucXetVaCongNhanTotNghiep :doAiThucHien :HieuTruong ;
		:noiDung "Các đơn vị liên quan thẩm định và trình Hiệu trưởng ký quyết định công nhận tốt nghiệp, cấp bằng cho sinh viên đủ điều kiện."@vi .
}
:TD1052_D22K05 {
	:ThuTucXetVaCongNhanTotNghiep :doAiQuyetDinh :HieuTruong ;
		:noiDung "Những sinh viên đủ điều kiện tốt nghiệp được Hiệu trưởng ra quyết định công nhận tốt nghiệp và cấp bằng tốt nghiệp trong thời hạn 03 tháng tính từ thời điểm sinh viên đáp ứng đầy đủ điều kiện tốt nghiệp và hoàn thành nghĩa vụ với Trường."@vi .
}
:TD1052_D23K03dA {
	:HaHangTotNghiepDoHocLaiQuaNhieu :loaiQuyTac :QuyTacHaHangTotNghiep ;
		:noiDung "Hạng tốt nghiệp của sinh viên có điểm trung bình chung tích lũy loại xuất sắc và giỏi bị giảm đi một mức nếu khối lượng của các học phần phải học lại vượt quá 5% so với tổng số tín chỉ quy định của toàn chương trình."@vi ;
		:tyLeToiDa "5"^^xsd:decimal .
}
:TD1052_D23K03dB {
	:HaHangTotNghiepDoBiKyLuat :loaiQuyTac :QuyTacHaHangTotNghiep ;
		:noiDung "Hạng tốt nghiệp của sinh viên có điểm trung bình chung tích lũy loại xuất sắc và giỏi bị giảm đi một mức nếu sinh viên đã bị kỷ luật từ mức cảnh cáo trở lên trong thời gian học."@vi .
}
:TD1052_D24K01dA {
	:DuocDieuDongVaoLucLuongVuTrang :noiDung "Sinh viên được điều động vào lực lượng vũ trang."@vi .
	:ThuTucNghiHocTamThoi :apDungChoTruongHop :DuocDieuDongVaoLucLuongVuTrang .
}
:TD1052_D24K01dB {
	:DuocDieuDongDuThiGiaiDauQuocTe :noiDung "Sinh viên được cơ quan có thẩm quyền điều động, đại diện quốc gia tham dự các kỳ thi, giải đấu quốc tế."@vi .
	:ThuTucNghiHocTamThoi :apDungChoTruongHop :DuocDieuDongDuThiGiaiDauQuocTe .
}
:TD1052_D24K01dC {
	:OmThaiSanHoacTaiNan :noiDung "Sinh viên bị ốm, thai sản hoặc tai nạn trong quá trình học."@vi .
	:ThuTucNghiHocTamThoi :apDungChoTruongHop :OmThaiSanHoacTaiNan ;
		:noiDung "Bị ốm, thai sản hoặc tai nạn phải điều trị thời gian dài, có giấy chứng nhận của cơ sở khám bệnh, chữa bệnh có thẩm quyền theo quy định của Bộ Y tế."@vi .
}
:TD1052_D24K01dD {
	:LyDoCaNhanKhac :noiDung "Sinh viên nghỉ học tạm thời vì lý do cá nhân khác."@vi .
	:ThuTucNghiHocTamThoi :apDungChoTruongHop :LyDoCaNhanKhac ;
		:noiDung "Phải đã học ít nhất 01 học kỳ tại Trường và không thuộc diện bị xem xét buộc thôi học hoặc xem xét kỷ luật."@vi .
}
:TD1052_D24K02 {
	:ThuTucXinThoiHoc :noiDung "Những sinh viên này muốn quay trở lại học phải xét tuyển đầu vào như những thí sinh khác."@vi , "Sinh viên được xin thôi học vì lý do cá nhân, trừ trường hợp bị xem xét buộc thôi học hoặc xem xét kỷ luật."@vi .
}
:TD1052_D24K03 {
	:MauSo09DonXinNghiHocTamThoi :soHieuMauTheoQuyetDinh "09" .
	:MauSo10DonXinThoiHoc :soHieuMauTheoQuyetDinh "10" .
	:MauSo11DonXinHocTroLai :soHieuMauTheoQuyetDinh "11" .
	:ThuTucNghiHocTamThoi :canBieuMau :MauSo09DonXinNghiHocTamThoi ;
		:doAiQuyetDinh :HieuTruong ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên xin nghỉ học tạm thời phải viết đơn (Mẫu số 09 - Phụ lục 4 kèm theo) gửi Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên."@vi ;
		:nopTai :PhongCongTacChinhTriVaSinhVien ;
		:thuTucTiepTheo :ThuTucXinHocTroLai .
	:ThuTucXinHocTroLai :canBieuMau :MauSo11DonXinHocTroLai ;
		:doAiQuyetDinh :HieuTruong ;
		:doAiThucHien :SinhVien ;
		:noiDung "Khi muốn trở lại học tiếp, sinh viên cần viết đơn (Mẫu số 11 - Phụ lục 4 kèm theo) gửi Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên ít nhất 02 tuần trước khi bắt đầu học kỳ mới để được xem xét giải quyết."@vi ;
		:nopTai :PhongCongTacChinhTriVaSinhVien .
	:ThuTucXinThoiHoc :canBieuMau :MauSo10DonXinThoiHoc ;
		:doAiQuyetDinh :HieuTruong ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên xin thôi học phải viết đơn (Mẫu số 10 - Phụ lục 4 kèm theo) gửi Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên."@vi ;
		:nopTai :PhongCongTacChinhTriVaSinhVien .
}
:TD1052_D25K01dA {
	:ThuTucChuyenNganh :noiDung "Không đang là sinh viên năm thứ nhất hoặc năm cuối khóa, không thuộc diện bị xem xét buộc thôi học và còn đủ thời gian học tập theo quy định."@vi .
}
:TD1052_D25K01dB {
	:ThuTucChuyenNganh :noiDung "Đạt điều kiện trúng tuyển của chương trình, ngành đào tạo xin chuyển đến trong cùng khóa tuyển sinh."@vi .
}
:TD1052_D25K01dC {
	:ThuTucChuyenNganh :noiDung "Được sự đồng ý của Trưởng Khoa hoặc viện của ngành đang học và ngành xin chuyển đến."@vi .
}
:TD1052_D25K01dD {
	:ThuTucChuyenNganh :noiDung "Nhà trường có đủ điều kiện bảo đảm chất lượng và chưa vượt quá năng lực đào tạo của ngành xin chuyển đến."@vi .
}
:TD1052_D25K02 {
	:MauSo12DonXinChuyenNganh :soHieuMauTheoQuyetDinh "12" .
	:ThuTucChuyenNganh :canBieuMau :MauSo12DonXinChuyenNganh ;
		:doAiQuyetDinh :HieuTruong ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên có nguyện vọng và thỏa mãn các điều kiện tại khoản 1 của Điều này có thể được xem xét chuyển ngành trong cùng bậc học."@vi , "Ít nhất 02 tuần trước khi bắt đầu học kỳ mới, sinh viên làm đơn xin chuyển ngành (Mẫu số 12 - Phụ lục 4 kèm theo) để trình Hiệu trưởng thông qua Phòng Công tác Chính trị và Sinh viên xem xét quyết định."@vi ;
		:nopTai :PhongCongTacChinhTriVaSinhVien .
}
:TD1052_D25K03 {
	:ThuTucChuyenNganh :noiDung "Sinh viên được bảo lưu điểm các học phần đã học có nội dung và khối lượng kiến thức tương đương; không được gia hạn thời gian học tập tối đa."@vi .
}
:TD1052_D26K01dA {
	:ThuTucChuyenTruong :noiDung "Không đang là sinh viên năm thứ nhất hoặc năm cuối khóa, không thuộc diện bị xem xét buộc thôi học và còn đủ thời gian học tập theo quy định."@vi .
}
:TD1052_D26K01dB {
	:ThuTucChuyenTruong :noiDung "Đạt điều kiện trúng tuyển của chương trình, ngành đào tạo cùng khóa tuyển sinh tại Trường xin chuyển đến."@vi .
}
:TD1052_D26K01dC {
	:ThuTucChuyenTruong :noiDung "Nơi chuyển đến có đủ điều kiện bảo đảm chất lượng và chưa vượt quá năng lực đào tạo đối với chương trình, ngành đào tạo đó."@vi .
}
:TD1052_D26K01dD {
	:ThuTucChuyenTruong :noiDung "Được sự đồng ý của Hiệu trưởng cơ sở đào tạo xin chuyển đi và cơ sở đào tạo xin chuyển đến."@vi .
}
:TD1052_D26K02 {
	:MauSo13DonXinChuyenTruong :soHieuMauTheoQuyetDinh "13" .
	:ThuTucChuyenTruong :canBieuMau :MauSo13DonXinChuyenTruong ;
		:doAiThucHien :SinhVien ;
		:nopTai :PhongCongTacChinhTriVaSinhVien .
}
:TD1052_D27K02 {
	:GioiHanTinChiTichLuyTaiTruongKhac :loaiQuyTac :QuyTacGioiHanCongNhanVaChuyenDoiTinChi ;
		:noiDung "Sinh viên tham gia chương trình trao đổi có thể đăng ký học một số học phần tại trường khác với số lượng tín chỉ tích lũy tại trường khác không vượt quá 25% tổng khối lượng của chương trình đào tạo."@vi ;
		:tyLeToiDa "25"^^xsd:decimal .
	:ThuTucDangKyChuongTrinhTraoDoiSinhVien :noiDung "Số tín chỉ tích lũy tại trường khác không vượt quá 25% tổng khối lượng của chương trình đào tạo."@vi .
}
:TD1052_D27K03 {
	:ThuTucDangKyChuongTrinhTraoDoiSinhVien :noiDung "Đã kết thúc 01 năm học tại Trường và có điểm trung bình chung tích lũy đạt từ 6,00 trở lên."@vi .
}
:TD1052_D27K04 {
	:MauSo14DonDangKyChuongTrinhTraoDoiSinhVien :soHieuMauTheoQuyetDinh "14" .
	:ThuTucDangKyChuongTrinhTraoDoiSinhVien :canBieuMau :MauSo14DonDangKyChuongTrinhTraoDoiSinhVien ;
		:doAiThucHien :SinhVien ;
		:nopTai :PhongDaoTaoDaiHoc .
}
:TD1052_D28K01dA {
	:ThuTucDangKyHocCungLucHaiChuongTrinh :noiDung "Đã được xếp từ trình độ năm thứ hai trở lên của chương trình thứ nhất."@vi .
}
:TD1052_D28K01dB {
	:ThuTucDangKyHocCungLucHaiChuongTrinh :noiDung "Học lực theo điểm trung bình tích lũy xếp loại khá trở lên và đáp ứng ngưỡng bảo đảm chất lượng của chương trình thứ hai; hoặc xếp loại trung bình và đáp ứng điều kiện trúng tuyển của chương trình thứ hai trong năm tuyển sinh."@vi .
}
:TD1052_D28K02 {
	:ThuTucDangKyHocCungLucHaiChuongTrinh :noiDung "Nếu điểm trung bình chung học kỳ của chương trình thứ nhất đạt dưới 5,50 thì phải dừng học chương trình thứ hai ở học kỳ tiếp theo cho đến khi kết quả được cải thiện."@vi .
}
:TD1052_D28K03 {
	:MauSo15DonDangKyHocCungLucHaiChuongTrinh :soHieuMauTheoQuyetDinh "15" .
	:ThuTucDangKyHocCungLucHaiChuongTrinh :canBieuMau :MauSo15DonDangKyHocCungLucHaiChuongTrinh ;
		:doAiThucHien :SinhVien .
}
:TD1052_D28K05 {
	:ThuTucDangKyHocCungLucHaiChuongTrinh :noiDung "Đăng ký muộn nhất 02 năm trước thời điểm xét tốt nghiệp chương trình thứ hai, và chỉ được xét tốt nghiệp chương trình thứ hai khi đã đủ điều kiện tốt nghiệp chương trình thứ nhất."@vi .
}
:TD1052_D29K01 {
	:ThuTucHocLienThong :noiDung "Người đã tốt nghiệp trình độ trung cấp, trình độ cao đẳng được xét tuyển và học liên thông lên trình độ đại học. Người đã tốt nghiệp đại học được xét tuyển và học liên thông để nhận thêm một bằng tốt nghiệp đại học của một ngành đào tạo khác."@vi .
}
:TD1052_D29K02 {
	:ThuTucHocLienThong :doAiThucHien :SinhVien ;
		:noiDung "Người học đăng ký học liên thông vào đầu mỗi năm học theo thông báo tuyển sinh liên thông hàng năm của Nhà trường."@vi .
}
:TD1052_D29K03 {
	:ThuTucHocLienThong :noiDung "Sau khi trúng tuyển, thực hiện chương trình đào tạo và đăng ký học tập theo kế hoạch chung như các sinh viên khác cùng hình thức đào tạo."@vi ;
		:thuTucTiepTheo :ThuTucCongNhanKetQuaHocTapVaChuyenDoiTinChi .
}
:TD1052_D30K01 {
	:ThuTucNghiHocTamThoi :noiDung "Ốm phải điều trị dài ngày từ 10 ngày trở lên."@vi .
	:ThuTucXinNghiOmTrongQuaTrinhHoc :apDungChoTruongHop :OmThaiSanHoacTaiNan ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên xin nghỉ ốm trong quá trình học phải viết đơn xin phép gửi giảng viên giảng dạy học phần trong vòng 01 tuần kể từ ngày ốm, kèm theo Giấy chứng nhận của cơ sở y tế Trường hoặc cơ sở y tế xã, phường trở lên."@vi ;
		:nopTai :GiangVienGiangDayHocPhan ;
		:thuTucTiepTheo :ThuTucNghiHocTamThoi .
}
:TD1052_D30K02 {
	:MauSo04DonXinHoanThi :soHieuMauTheoQuyetDinh "04" .
	:ThuTucXinHoanThi :apDungChoTruongHop :OmThaiSanHoacTaiNan ;
		:canBieuMau :MauSo04DonXinHoanThi ;
		:doAiThucHien :SinhVien ;
		:noiDung "Sinh viên xin nghỉ ốm trong đợt thi kết thúc học phần phải viết đơn xin phép hoãn thi gửi Đơn vị quản lý đào tạo trước ngày thi, kèm theo Giấy chứng nhận của cơ sở y tế Trường hoặc cơ sở y tế xã, phường trở lên (Mẫu số 04 - Phụ lục 4 kèm theo)."@vi ;
		:nopTai :PhongDaoTaoDaiHoc .
}
:TD1052_D31 {
	:ChinhSachXuLySinhVienViPham :noiDung "Sinh viên có gian lận trong học tập, kiểm tra và thi học phần sẽ bị xử lý kỷ luật đối với từng học phần đã vi phạm theo các quy định của Quy chế công tác sinh viên."@vi .
}
:TD626_PLV {
	:TrangThongTinTuyenSinh :noiDung "Trang thông tin tuyển sinh của Trường Đại học Nha Trang có địa chỉ http://tuyensinh.ntu.edu.vn."@vi .
}
:TD753_D10K01 {
	:ThuTucRutBotHocPhanDaDangKy :noiDung "Sau thời gian đăng ký học, nếu sinh viên xét thấy không thể hoàn thành khối lượng học tập đã đăng ký thì có thể làm đơn xin rút bớt (hủy) một hoặc một số học phần đã đăng ký với điều kiện không vi phạm giới hạn tối thiểu quy định tại khoản 3, khoản 4 Điều 9 của Quy chế này."@vi .
}
:TD753_D10K02 {
	:ThuTucRutBotHocPhanDaDangKy :noiDung "Chỉ được chấp nhận tối đa trong tuần thứ hai của học kỳ chính, tuần thứ nhất của học kỳ phụ."@vi , "Quá thời hạn, học phần vẫn được giữ nguyên như đã đăng ký; sinh viên không đi học thì xem như tự ý bỏ học và phải nhận điểm 0."@vi .
}
:TD753_D10K03 {
	:MauSo2PhieuDangKyDieuChinhHocPhanTheoQuyetDinh753 :soHieuMauTheoQuyetDinh "2" .
	:ThuTucRutBotHocPhanDaDangKy :canBieuMau :MauSo2PhieuDangKyDieuChinhHocPhanTheoQuyetDinh753 ;
		:doAiThucHien :SinhVien ;
		:noiDung "Tự rút bớt học phần trên Hệ thống quản lý đào tạo từ tài khoản cá nhân, hoặc nộp đơn đề nghị rút bớt học phần tại Đơn vị quản lý đào tạo."@vi ;
		:nopTai :PhongDaoTaoDaiHoc .
}
