ns1:TDNguon1052DiemAKhoan4Dieu27 {
    ns1:ThuTucDangKyChuongTrinhTraoDoiSinhVien ns1:noiDung "Đầu mỗi học kỳ, Nhà trường thông báo về việc đăng ký tham gia chương trình trao đổi sinh viên."@vi .
}

ns1:TD1052_D08K02dA {
    ns1:LopHocPhan ns1:noiDung "Lớp học phần là lớp mà sinh viên đăng ký theo học cùng học phần trong một học kỳ. Mỗi học phần có thể có nhiều lớp học phần với mã số nhóm khác nhau. Lớp học phần được áp dụng cho hình thức đào tạo chính quy."@vi .
}

ns1:TD1052_D27K04 {
    ns1:ThuTucDangKyChuongTrinhTraoDoiSinhVien ns1:canBieuMau ns1:MauSo14DonDangKyChuongTrinhTraoDoiSinhVien ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo14DonDangKyChuongTrinhTraoDoiSinhVien ;
        ns1:nopTai ns1:PhongDaoTaoDaiHoc .

    ns1:MauSo14DonDangKyChuongTrinhTraoDoiSinhVien ns1:soHieuMauTheoQuyetDinh "14" .
}

ns1:TD1052_D13K03dB {
    ns1:DaoTaoTrucTuyenDongBo ns1:loaiKhaiNiem ns1:HinhThucToChucDayHoc ;
        ns1:noiDung "Giảng viên và sinh viên cùng tham gia các hoạt động đào tạo tại cùng một thời điểm trên cùng một không gian học tập. Đây là hình thức dạy học hoàn toàn trực tuyến."@vi .
}

ns1:TDNguon1052DiemBKhoan2Dieu26 {
    ns1:ThuTucChuyenTruong ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:noiDung "Hiệu trưởng trường xin chuyển đi quyết định đồng ý hoặc không đồng ý chuyển đi và Hiệu trưởng trường xin chuyển đến quyết định tiếp nhận hoặc không tiếp nhận sinh viên; công nhận và bảo lưu các học phần mà sinh viên chuyển đến được chuyển đổi tín chỉ và số học phần phải học bổ sung, trên cơ sở so sánh chương trình ở Trường sinh viên xin chuyển đi và Trường xin chuyển đến."@vi .
}

ns1:TDStudyYearClassificationTable {
    ns1:BangXepTrinhDoNamHoc ns1:noiDung """| **TT** | **Số tín chỉ đã tích lũy** | **Xếp trình độ năm học** |
| :---: | :--- | :--- |
| 1 | Dưới 35 | SV năm thứ nhất |
| 2 | Từ 35 đến dưới 70 | SV năm thứ hai |
| 3 | Từ 70 đến dưới 105 | SV năm thứ ba |
| 4 | Trên 105 | SV năm thứ tư |"""@vi .
}

ns1:TD1052_D08K02dC {
    ns1:ThuTucDeNghiMoThemLopHocPhan ns1:canBieuMau ns1:MauSo01DonXinMoLopHocPhan ;
        ns1:doAiQuyetDinh ns1:HieuTruong ;
        ns1:doAiThucHien ns1:SinhVien ;
        ns1:dungBieuMau ns1:MauSo01DonXinMoLopHocPhan ;
        ns1:noiDung "Khi số lượng sinh viên đăng ký ít hơn số lượng tối thiểu theo quy định, với các trường hợp đặc thù hoặc có lý do chính đáng, nhóm sinh viên làm đơn xin mở lớp học phần (Mẫu số 01 - Phụ lục 4 kèm theo) để Hiệu trưởng xem xét và quyết định, thông qua Đơn vị quản lý đào tạo."@vi ;
        ns1:nopTai ns1:PhongDaoTaoDaiHoc .

    ns1:MauSo01DonXinMoLopHocPhan ns1:soHieuMauTheoQuyetDinh "01" .
}

ns1:TD1052_D25K03 {
    ns1:ThuTucChuyenNganh ns1:noiDung "Sinh viên được bảo lưu điểm các học phần đã học có nội dung và khối lượng kiến thức tương đương; không được gia hạn thời gian học tập tối đa."@vi .
}

ns1:TD1052_D27K03 {
    ns1:ThuTucDangKyChuongTrinhTraoDoiSinhVien ns1:noiDung "Đã kết thúc 01 năm học tại Trường và có điểm trung bình chung tích lũy đạt từ 6,00 trở lên."@vi .
}

ns1:TD1052_D20K01dB {
    ns1:CanhBaoDoDiemTrungBinhHocKy ns1:loaiQuyTac ns1:QuyTacCanhBaoKetQuaHocTap ;
        ns1:noiDung "Điểm trung bình chung học kỳ đạt dưới 4,00 đối với học kỳ đầu khóa học, dưới 4,50 đối với học kỳ tiếp theo."@vi .
}

ns1:TD1052_D25K01dA {
    ns1:ThuTucChuyenNganh ns1:noiDung "Không đang là sinh viên năm thứ nhất hoặc năm cuối khóa, không thuộc diện bị xem xét buộc thôi học và còn đủ thời gian học tập theo quy định."@vi .
}

ns1:TDEnglishRequirementTableSpecialProgram {
    ns1:BangChuanTiengAnhChuongTrinhDacBiet ns1:loaiBang ns1:BangQuyDoiChungChi ;
        ns1:noiDung """| TT | Chương trình | KNLNN / CEFR | TOEIC | IELTS | TOEFL iBT | Linguaskill | Aptis (General) | Cambridge English Scale |
| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |
| 1 | Công nghệ thông tin | Bậc 4 hoặc B2 | ≥ 600 | ≥ 5.0 | ≥ 65 | 140 | > 131 | ≥ 151 |
| 2 | Kế toán | Bậc 4 hoặc B2 | ≥ 600 | ≥ 5.0 | ≥ 65 | 140 | > 131 | ≥ 151 |
| 3 | Tài chính - Ngân hàng | Bậc 4 hoặc B2 | ≥ 600 | ≥ 5.0 | ≥ 65 | 140 | > 131 | ≥ 151 |
| 4 | Quản trị khách sạn | Bậc 4 hoặc B2 | ≥ 700 | ≥ 5.5 | ≥ 70 | > 160 | > 153 | ≥ 160 |
| 5 | Quản trị kinh doanh | Bậc 4 hoặc B2 | ≥ 700 | ≥ 5.5 | ≥ 70 | > 160 | > 153 | ≥ 160 |
| 6 | Quản trị dịch vụ du lịch và lữ hành | Bậc 4 hoặc B2 | ≥ 700 | ≥ 5.5 | ≥ 70 | > 160 | > 153 | ≥ 160 |"""@vi .
}

ns1:TD1052_D06K02dDD {
    ns1:HocPhanHocTruoc ns1:loaiKhaiNiem ns1:LoaiHocPhan ;
        ns1:noiDung "Học phần sinh viên phải học xong, có thể đạt hoặc không đạt, trước khi học các học phần tiếp theo."@vi .
}

ns1:TD1052_D22K01dD {
    ns1:ThuTucXetVaCongNhanTotNghiep ns1:noiDung "Đạt năng lực ngoại ngữ theo quy định đối với mỗi khóa đào tạo."@vi .
}

